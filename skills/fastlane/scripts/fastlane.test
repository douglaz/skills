#!/usr/bin/env bash
# fastlane.test — offline checks for launch-unit.sh and wait.sh: the wait record, the busy check and
# the disk floor. `systemctl`, `systemd-run` and `df` are stubs: a unit is "active" while
# $FIX/active/<unit> exists, systemd-run marks its unit active and logs its arguments to $FIX/runs,
# and df reports $FIX/free-kb KiB free. Starts no unit.
#
# Usage: ./fastlane.test          (exits 0 if all pass)

set -uo pipefail
HERE=$(cd "$(dirname "$0")" && pwd)
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
PASS=0; FAIL=0
unset FASTLANE_SEATS  # the default seats unless a check sets the switch

mkdir -p "$WORK/bin"
cat > "$WORK/bin/systemctl" <<'STUB'
#!/usr/bin/env bash
# systemctl --user is-active --quiet UNIT
[ "$1 $2 $3" = "--user is-active --quiet" ] || { echo "unexpected systemctl call: $*" >&2; exit 9; }
case $4 in *-grok-probe)
  if [ -f "$FIX/probe-answer" ]; then
    touch "$FIX/probe-query-failed"
    exit 1
  fi ;;
esac
[ -e "$FIX/active/$4" ]
STUB
cat > "$WORK/bin/systemd-run" <<'STUB'
#!/usr/bin/env bash
echo "$*" >> "$FIX/runs"
unit= out=
for a in "$@"; do
  case $a in
    --unit=*) unit=${a#--unit=}; touch "$FIX/active/$unit" ;;
    StandardOutput=file:*) out=${a#StandardOutput=file:} ;;
  esac
done
case $unit in *-grok-probe|*-neon-probe)
  d=$(dirname "$out") word=GROK_OK
  case $unit in *-neon-probe) word=NEON_OK ;; esac
  case $(cat "$FIX/probe-mode") in
    good) echo "$word" > "$out"; echo 'success exited 0' > "$d/exit" ;;
    empty) : > "$out"; echo 'success exited 0' > "$d/exit" ;;
    failed) echo "$word" > "$out"; echo 'exit-code exited 1' > "$d/exit" ;;
    post-submit-error) printf '%s\n' "$out" "$unit" > "$FIX/probe-answer"; exit 0 ;;
  esac
  rm "$FIX/active/$unit"
  ;;
esac
STUB
FASTLANE_TEST_SLEEP=$(command -v sleep)
export FASTLANE_TEST_SLEEP
cat > "$WORK/bin/sleep" <<'STUB'
#!/bin/sh
# Let the probe finish after the waiter's first polling tick, independently of status queries.
if [ "$1" = 15 ] && [ -f "$FIX/probe-answer" ]; then
  { IFS= read -r out; IFS= read -r unit; } < "$FIX/probe-answer"
  echo GROK_OK > "$out"
  echo 'success exited 0' > "$(dirname "$out")/exit"
  rm "$FIX/active/$unit" "$FIX/probe-answer"
  exit 0
fi
exec "$FASTLANE_TEST_SLEEP" "$@"
STUB
cat > "$WORK/bin/df" <<'STUB'
#!/usr/bin/env bash
printf 'Filesystem 1024-blocks Used Available Capacity Mounted on\nfake 999999999 1 %s 1%% /\n' "$(cat "$FIX/free-kb")"
STUB
for tool in codex claude grok agy; do
  printf '#!/bin/sh\nexit 99\n' > "$WORK/bin/$tool"
  chmod +x "$WORK/bin/$tool"
done
chmod +x "$WORK/bin/systemctl" "$WORK/bin/systemd-run" "$WORK/bin/sleep" "$WORK/bin/df"
PATH="$WORK/bin:$PATH"
LU=$HERE/launch-unit.sh WS=$HERE/wait.sh

new_fix() { # a fresh lane folder with an empty record, 100 GiB free, nothing active
  FIX="$WORK/fix"; rm -rf "$FIX"; mkdir -p "$FIX/active" "$FIX/lane/i1"
  : > "$FIX/lane/waits"; echo $((100 * 1048576)) > "$FIX/free-kb"; : > "$FIX/runs"
  export FIX
}
ok() { PASS=$((PASS+1)); printf '  ok   %s\n' "$1"; }
bad() { FAIL=$((FAIL+1)); printf '  FAIL %s\n' "$1"; [ -n "${2:-}" ] && printf '       %s\n' "$2"; }
check() { if eval "$2"; then ok "$1"; else bad "$1" "$3"; fi; }
launch() { (cd "$FIX/lane" && env FASTLANE_CWD="$FIX/lane" "$LU" "$@") > "$FIX/launch.out" 2>&1; echo $?; }
ISO='[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}Z'

out=$("$WS" 2>&1); rc=$?
check "wait usage gives the deadline unit and a 55-minute example" \
  '[ "$rc" = 2 ] && [[ "$out" == *"seconds, e.g. 3300 for 55 minutes"* ]]' "rc $rc: $out"

# --- the wait record ---------------------------------------------------------------------------
new_fix
rc=$(launch --manager devices --kind other fl-i1-impl i1/impl -- /bin/true)
line=$(cat "$FIX/lane/waits")
check "launch in a lane exits 0" '[ "$rc" = 0 ]' "rc $rc: $(cat "$FIX/launch.out")"
check "launch appends one record line: manager | unit | exit path | ISO deadline" \
  '[ "$(wc -l < "$FIX/lane/waits")" = 1 ] && [[ "$line" =~ ^devices\ \|\ fl-i1-impl\ \|\ $FIX/lane/i1/impl/exit\ \|\ $ISO$ ]]' "line: $line"
check "launch writes unit, kind, manager and the record path into DIR" \
  '[ "$(cat "$FIX/lane/i1/impl/unit")" = fl-i1-impl ] && [ "$(cat "$FIX/lane/i1/impl/kind")" = other ] &&
   [ "$(cat "$FIX/lane/i1/impl/manager")" = devices ] && [ "$(cat "$FIX/lane/i1/impl/record")" = "$FIX/lane/waits" ]'

echo "lead | - | /abs/peer-handoff/exit | 2026-11-19T18:30Z" >> "$FIX/lane/waits"
rm "$FIX/active/fl-i1-impl"; echo "success exited 0" > "$FIX/lane/i1/impl/exit"
"$WS" 60 "$FIX/lane/i1/impl" > "$FIX/wait.out" 2>&1; rc=$?
check "wait.sh exits 0 on a finished unit" '[ "$rc" = 0 ]' "rc $rc: $(cat "$FIX/wait.out")"
check "wait.sh removes its line when the job has finished" '! grep -q "fl-i1-impl" "$FIX/lane/waits"' "$(cat "$FIX/lane/waits")"
check "wait.sh leaves a hand-written line (unit -) alone" \
  'grep -qx "lead | - | /abs/peer-handoff/exit | 2026-11-19T18:30Z" "$FIX/lane/waits"' "$(cat "$FIX/lane/waits")"

new_fix
launch --manager tests fl-i2-live i1/live -- /bin/true > /dev/null
launch --manager devices fl-i2-impl i1/impl -- /bin/true > /dev/null
"$WS" 0 "$FIX/lane/i1/live" > "$FIX/wait.out" 2>&1; rc=$?
check "wait.sh returns 124 at its own deadline" '[ "$rc" = 124 ]' "rc $rc: $(cat "$FIX/wait.out")"
check "wait.sh removes its line at its own deadline too" '! grep -q "fl-i2-live" "$FIX/lane/waits"' "$(cat "$FIX/lane/waits")"
check "wait.sh leaves another unit's line alone" 'grep -q "^devices | fl-i2-impl |" "$FIX/lane/waits"' "$(cat "$FIX/lane/waits")"

new_fix
launch --manager product --kind deploy fl-i5-deploy i1/deploy -- /bin/true > /dev/null
env FASTLANE_MANAGER=tests "$WS" 0 "$FIX/lane/i1/deploy" > "$FIX/wait.out" 2>&1
check "a manager waiting on a peer's unit leaves the peer's line alone" \
  'grep -q "^product | fl-i5-deploy |" "$FIX/lane/waits" && ! grep -q "^tests |" "$FIX/lane/waits"' "$(cat "$FIX/lane/waits")"

new_fix
launch --manager devices fl-i6-impl i1/impl -- /bin/true > /dev/null
echo "lead | - | /abs/peer-handoff/exit | 2026-11-19T18:30Z" >> "$FIX/lane/waits"
before=$(cat "$FIX/lane/waits")
mkdir -p "$WORK/failbin"; printf '#!/bin/sh\nexit 1\n' > "$WORK/failbin/awk"; chmod +x "$WORK/failbin/awk"
env PATH="$WORK/failbin:$PATH" "$WS" 0 "$FIX/lane/i1/impl" > "$FIX/wait.out" 2>&1
check "a record rewrite that fails (a full disk) leaves the record as it was" \
  '[ "$(cat "$FIX/lane/waits")" = "$before" ] && ! ls "$FIX/lane"/waits.tmp.* > /dev/null 2>&1' "$(cat "$FIX/lane/waits")"

new_fix
launch --manager tests fl-i3-live i1/live -- /bin/true > /dev/null
"$WS" 3300 "$FIX/lane/i1/live" > "$FIX/wait.out" 2>&1 & wpid=$!
for _ in $(seq 50); do grep -q "fl-i3-live" "$FIX/lane/waits" && [ -e "$FIX/lane/waits.lock" ] && break; sleep 0.1; done
sleep 0.5
during=$(cat "$FIX/lane/waits")
kill -TERM "$wpid"; wait "$wpid" 2>/dev/null
check "a running wait.sh keeps the unit's line, with its own deadline" \
  '[ "$(grep -c "fl-i3-live" <<<"$during")" = 1 ] && [[ "$during" =~ ^tests\ \|\ fl-i3-live\ \|\ .*/i1/live/exit\ \|\ $ISO$ ]]' "during: $during"
check "a wait.sh stopped by a signal removes its line" '! grep -q "fl-i3-live" "$FIX/lane/waits"' "$(cat "$FIX/lane/waits")"

new_fix
(cd "$FIX" && mkdir -p elsewhere && env FASTLANE_CWD="$FIX" "$LU" fl-x "$FIX/elsewhere/x" -- /bin/true) > "$FIX/launch.out" 2>&1; rc=$?
check "outside a lane folder a launch still starts, and writes no record" \
  '[ "$rc" = 0 ] && [ ! -e "$FIX/elsewhere/x/record" ] && [ ! -s "$FIX/lane/waits" ]' "rc $rc: $(cat "$FIX/launch.out")"

# --- the busy check ----------------------------------------------------------------------------
new_fix
launch --kind live fl-live i1/live -- /bin/true > /dev/null
runs_before=$(wc -l < "$FIX/runs")
rc=$(launch --kind deploy fl-deploy i1/deploy -- /bin/true)
check "a deploy refuses (exit 3) while a recorded live unit is active" '[ "$rc" = 3 ]' "rc $rc: $(cat "$FIX/launch.out")"
check "the refusal names the holder and starts nothing" \
  'grep -q "live unit fl-live is active" "$FIX/launch.out" && [ "$(wc -l < "$FIX/runs")" = "$runs_before" ] && ! grep -q fl-deploy "$FIX/lane/waits"' \
  "$(cat "$FIX/launch.out")"
"$WS" 0 "$FIX/lane/i1/live" > /dev/null 2>&1
rc=$(launch --kind deploy fl-deploy i1/deploy -- /bin/true)
check "the live unit still blocks a deploy after its wait returned and dropped its record line" \
  '[ "$rc" = 3 ] && ! grep -q "fl-live " "$FIX/lane/waits"' "rc $rc: $(cat "$FIX/launch.out"); $(cat "$FIX/lane/waits")"
rc=$(launch --kind other fl-impl i1/impl -- /bin/true)
check "an 'other' launch is not blocked by a live unit" '[ "$rc" = 0 ]' "rc $rc: $(cat "$FIX/launch.out")"
rc=$(launch --kind live fl-live2 i1/live2 -- /bin/true)
check "a second live run is not blocked by a live unit" '[ "$rc" = 0 ]' "rc $rc: $(cat "$FIX/launch.out")"
out=$("$LU" --check deploy "$FIX/lane" 2>&1); rc=$?
check "--check deploy exits 1 and prints the holders" '[ "$rc" = 1 ] && grep -q "fl-live" <<<"$out"' "rc $rc: $out"
out=$(cd "$FIX/lane/i1/impl" && "$LU" --check deploy 2>&1); rc=$?
check "--check deploy run from inside a unit's directory still finds the lane and its live unit" \
  '[ "$rc" = 1 ] && grep -q "fl-live" <<<"$out"' "rc $rc: $out"
out=$(cd "$FIX/lane/i1" && "$LU" --check other 2>&1); rc=$?
check "--check other exits 0, finding the lane folder above the current directory" '[ "$rc" = 0 ] && [ -z "$out" ]' "rc $rc: $out"
rm "$FIX/active/fl-live" "$FIX/active/fl-live2"
out=$("$LU" --check deploy "$FIX/lane" 2>&1); rc=$?
check "a finished live unit no longer blocks a deploy" '[ "$rc" = 0 ]' "rc $rc: $out"
rc=$(launch --kind deploy fl-deploy i1/deploy -- /bin/true)
check "with the live run over, the deploy starts" '[ "$rc" = 0 ]' "rc $rc: $(cat "$FIX/launch.out")"
rc=$(launch --kind live fl-live3 i1/live3 -- /bin/true)
check "a live run refuses (exit 3) while a recorded deploy is active" '[ "$rc" = 3 ] && grep -q "deploy unit fl-deploy" "$FIX/launch.out"' "rc $rc: $(cat "$FIX/launch.out")"
new_fix
mkdir -p "$FIX/lane/i9/stale"; echo live > "$FIX/lane/i9/stale/kind"; echo fl-gone > "$FIX/lane/i9/stale/unit"
out=$("$LU" --check deploy "$FIX/lane" 2>&1); rc=$?
check "a live dir whose unit is gone with no exit file (a reboot) doesn't block --check deploy" '[ "$rc" = 0 ] && [ -z "$out" ]' "rc $rc: $out"
rc=$(launch --kind deploy fl-after-reboot i1/deploy -- /bin/true)
check "nor a deploy launch" '[ "$rc" = 0 ]' "rc $rc: $(cat "$FIX/launch.out")"
out=$("$LU" --check build "$FIX/lane" 2>&1); rc=$?
check "an unknown kind is a usage error (exit 2)" '[ "$rc" = 2 ]' "rc $rc: $out"

# --- the disk floor ----------------------------------------------------------------------------
new_fix
echo $((40 * 1048576)) > "$FIX/free-kb"
rc=$(launch fl-low i1/low -- /bin/true)
check "below the 45 GiB default floor a launch refuses (exit 3) and starts nothing" \
  '[ "$rc" = 3 ] && grep -q "disk floor" "$FIX/launch.out" && [ ! -s "$FIX/runs" ] && [ ! -s "$FIX/lane/waits" ]' "rc $rc: $(cat "$FIX/launch.out")"
out=$( (cd "$FIX/lane" && env FASTLANE_CWD="$FIX/lane" FASTLANE_MIN_FREE_GB=30 "$LU" fl-low i1/low3 -- /bin/true) 2>&1); rc=$?
check "a lane's lower floor (FASTLANE_MIN_FREE_GB=30) lets the same launch start" '[ "$rc" = 0 ]' "rc $rc: $out"

# --- panel seats and grok availability ---------------------------------------------------------
new_fix
echo good > "$FIX/probe-mode"; echo brief > "$FIX/lane/brief.md"
"$HERE/review.sh" "$FIX/lane" "$FIX/lane/brief.md" "$FIX/lane/review" panel > "$FIX/review.out" 2>&1; rc=$?
check "default panel launches opus, astra, sol, and available grok" \
  '[ "$rc" = 0 ] && [ "$(wc -l < "$FIX/runs")" = 5 ] && [ -f "$FIX/lane/review/opus/unit" ] && [ -f "$FIX/lane/review/astra/unit" ] && [ -f "$FIX/lane/review/sol/unit" ] && [ -f "$FIX/lane/review/grok/unit" ] && [ ! -d "$FIX/lane/review/fable" ]' "rc $rc: $(cat "$FIX/review.out")"
check "grok probe and reviewer use 8G, no swap, null stdin and the standing command" \
  '[ "$(grep -c -- "MemoryMax=8G.*MemorySwapMax=0.*StandardInput=null.*--no-auto-update -p .*--model grok-4.7 --effort high --output-format plain --always-approve --sandbox off --no-subagents --no-memory --disable-web-search --disallowed-tools search_replace,write" "$FIX/runs")" = 2 ]' "$(cat "$FIX/runs")"
check "both grok calls allow only read-only repository tools" \
  '[ "$(grep -c -- "--tools read_file,grep,list_dir" "$FIX/runs")" = 2 ]' "$(cat "$FIX/runs")"
check "both grok calls remove MCP discovery and invocation tools" \
  '[ "$(grep -c -- "--disallowed-tools search_replace,write,search_tool,use_tool" "$FIX/runs")" = 2 ]' "$(cat "$FIX/runs")"
check "probe wait removes only its line; required reviewers stay recorded" \
  '! grep -q "grok-probe" "$FIX/lane/waits" && [ "$(wc -l < "$FIX/lane/waits")" = 4 ]' "$(cat "$FIX/lane/waits")"
check "reader prompt names grok config in the no-read list" \
  'grep -q "~/.grok" "$FIX/runs"' "$(cat "$FIX/runs")"
for mode in failed empty; do
  new_fix
  echo "$mode" > "$FIX/probe-mode"; echo brief > "$FIX/lane/brief.md"
  "$HERE/review.sh" "$FIX/lane" "$FIX/lane/brief.md" "$FIX/lane/review" panel > "$FIX/review.out" 2>&1; rc=$?
  check "$mode grok probe is reported missing and leaves no reader to wait on" \
    '[ "$rc" = 0 ] && [ -s "$FIX/lane/review/grok-missing" ] && [ ! -d "$FIX/lane/review/grok" ] && [ "$(wc -l < "$FIX/lane/waits")" = 3 ]' "rc $rc: $(cat "$FIX/review.out")"
done

# --- the FASTLANE_SEATS switch -----------------------------------------------------------------
out=$(env -u FASTLANE_SEATS "$HERE/review.sh" --seats 2>&1); rc=$?
check "unset FASTLANE_SEATS keeps the default seats" '[ "$rc" = 0 ] && [ "$out" = "opus astra sol grok" ]' "rc $rc: $out"
out=$(env FASTLANE_SEATS=' opus  sol grok fable ' "$HERE/review.sh" --seats 2>&1); rc=$?
check "--seats prints the switch's list in its own order" '[ "$rc" = 0 ] && [ "$out" = "opus sol grok fable" ]' "rc $rc: $out"
new_fix
echo good > "$FIX/probe-mode"; echo brief > "$FIX/lane/brief.md"
env FASTLANE_SEATS="opus sol grok" "$HERE/review.sh" "$FIX/lane" "$FIX/lane/brief.md" "$FIX/lane/review" panel > "$FIX/review.out" 2>&1; rc=$?
check "FASTLANE_SEATS=\"opus sol grok\" launches opus, sol and grok, and no astra" \
  '[ "$rc" = 0 ] && [ "$(wc -l < "$FIX/runs")" = 4 ] && [ -f "$FIX/lane/review/opus/unit" ] && [ -f "$FIX/lane/review/sol/unit" ] && [ -f "$FIX/lane/review/grok/unit" ] && [ ! -e "$FIX/lane/review/astra" ] && ! grep -q astra "$FIX/runs"' "rc $rc: $(cat "$FIX/review.out")"
check "the switch records waits only for the seats it launched" \
  '[ "$(wc -l < "$FIX/lane/waits")" = 3 ] && ! grep -q astra "$FIX/lane/waits"' "$(cat "$FIX/lane/waits")"
new_fix
echo brief > "$FIX/lane/brief.md"
env FASTLANE_SEATS="opus sol grok" "$HERE/review.sh" "$FIX/lane" "$FIX/lane/brief.md" "$FIX/lane/review" retry astra > "$FIX/review.out" 2>&1; rc=$?
check "seats named on the command line replace the switch" \
  '[ "$rc" = 0 ] && [ "$(wc -l < "$FIX/runs")" = 1 ] && [ -f "$FIX/lane/review/astra/unit" ] && [ ! -e "$FIX/lane/review/opus" ]' "rc $rc: $(cat "$FIX/review.out")"
for seats in '' ' ' 'sol grok' 'astra sol grok fable' 'opus grok' 'opus fable' 'opus gpt sol' 'opus sol,grok' 'opus sol opus' '*'; do
  new_fix
  echo empty > "$FIX/probe-mode"; echo brief > "$FIX/lane/brief.md"
  env FASTLANE_SEATS="$seats" "$HERE/review.sh" "$FIX/lane" "$FIX/lane/brief.md" "$FIX/lane/review" panel > "$FIX/review.out" 2>&1; rc=$?
  check "FASTLANE_SEATS='$seats' is refused before anything starts" \
    '[ "$rc" = 2 ] && grep -q "FASTLANE_SEATS" "$FIX/review.out" && [ ! -s "$FIX/runs" ] && [ ! -e "$FIX/lane/review" ]' "rc $rc: $(cat "$FIX/review.out")"
done

# --- the optional neon seat (agy is a stub; the systemd-run stub never runs it) -------------------
new_fix
echo good > "$FIX/probe-mode"; echo brief > "$FIX/lane/brief.md"
"$HERE/review.sh" "$FIX/lane" "$FIX/lane/brief.md" "$FIX/lane/review" panel > "$FIX/review.out" 2>&1; rc=$?
check "neon is never a default seat, even with agy on PATH" \
  '[ "$rc" = 0 ] && [ -x "$WORK/bin/agy" ] && ! grep -q -- "-neon\|agy" "$FIX/runs" && ! ls "$FIX/lane/review" | grep -q neon' "rc $rc: $(cat "$FIX/runs")"
out=$(env FASTLANE_SEATS='opus sol neon' "$HERE/review.sh" --seats 2>&1); rc=$?
check "FASTLANE_SEATS accepts neon" '[ "$rc" = 0 ] && [ "$out" = "opus sol neon" ]' "rc $rc: $out"
for seats in 'neon sol' 'opus neon' 'opus grok neon fable' 'opus sol neon neon'; do
  out=$(env FASTLANE_SEATS="$seats" "$HERE/review.sh" --seats 2>&1); rc=$?
  check "neon never stands in for opus, astra or sol: FASTLANE_SEATS='$seats' is refused" '[ "$rc" = 2 ] && grep -q FASTLANE_SEATS <<<"$out"' "rc $rc: $out"
done
new_fix
echo good > "$FIX/probe-mode"; echo brief > "$FIX/lane/brief.md"
env FASTLANE_SEATS="opus sol neon" "$HERE/review.sh" "$FIX/lane" "$FIX/lane/brief.md" "$FIX/lane/review" panel > "$FIX/review.out" 2>&1; rc=$?
NEON_PROBE=$(grep -- "--unit=fastlane-panel-neon-probe " "$FIX/runs") NEON_RUN=$(grep -- "--unit=fastlane-panel-neon " "$FIX/runs")
# Headless agy defaults to Auto mode, which writes and runs commands: these settings make it a reader.
NEON_SETTINGS='{"agentMode":"","permissions":{"deny":["command(*)","write_file(*)","mcp(*)"]}}'
check "a named neon seat is probed, then launched beside opus and sol, and waited on" \
  '[ "$rc" = 0 ] && [ "$(wc -l < "$FIX/runs")" = 4 ] && [ -f "$FIX/lane/review/neon/unit" ] && [ ! -e "$FIX/lane/review/neon-missing" ] &&
   grep -qx NEON_OK "$FIX/lane/review/neon-probe/answer.md" && [ "$(wc -l < "$FIX/lane/waits")" = 3 ] && grep -q "| fastlane-panel-neon |" "$FIX/lane/waits"' "rc $rc: $(cat "$FIX/review.out")"
check "the neon probe runs agy headless with JSON output, the high model id and a 90 s bound" \
  '[[ "$NEON_PROBE" == *"MemoryMax=8G -p MemorySwapMax=0 -p OOMPolicy=continue -p StandardInput=null -p StandardOutput=file:$FIX/lane/review/neon-probe/answer.md "* &&
     "$NEON_PROBE" == *" -I $HERE/neon.py $FIX/lane/review/neon-probe -- "*"timeout 90 $WORK/bin/agy -p Reply with exactly one word: NEON_OK --model gemini-4-neon-high --output-format json --print-timeout 80s --add-dir $FIX/lane --settings $NEON_SETTINGS" ]]' "$NEON_PROBE"
check "the neon reader gets the review prompt, the lane folder (a whole work dir or packet) and the 5400 s seat bound" \
  '[[ "$NEON_RUN" == *"StandardOutput=file:$FIX/lane/review/neon/answer.md "* &&
     "$NEON_RUN" == *" -I $HERE/neon.py $FIX/lane/review/neon -- "*"timeout 5400 $WORK/bin/agy -p You are a code reviewer in a fast lane. Read the review brief $FIX/lane/brief.md"*"~/.gemini. --model gemini-4-neon-high --output-format json --print-timeout 5390s --add-dir $FIX/lane --settings $NEON_SETTINGS" ]]' "$NEON_RUN"
check "both neon calls end with the reader settings: Default mode, commands, file writes and MCP denied" \
  '[[ "$NEON_PROBE" == *" --settings $NEON_SETTINGS" && "$NEON_RUN" == *" --settings $NEON_SETTINGS" ]]' "$NEON_RUN"
check "neon never skips permissions, plans, or sets a separate effort" \
  '[[ "$NEON_PROBE$NEON_RUN" != *"--dangerously-skip-permissions"* && "$NEON_PROBE$NEON_RUN" != *" --mode "* && "$NEON_PROBE$NEON_RUN" != *"--effort"* ]]' "$NEON_RUN"
check "every reader prompt names ~/.gemini in the no-read list" \
  '[ "$(grep -c -- "~/.grok, ~/.gemini." "$FIX/runs")" = 3 ]' "$(cat "$FIX/runs")"
new_fix
echo good > "$FIX/probe-mode"; echo brief > "$FIX/lane/brief.md"
"$HERE/review.sh" "$FIX/lane" "$FIX/lane/brief.md" "$FIX/lane/review" pair opus neon > "$FIX/review.out" 2>&1; rc=$?
check "neon named on the command line seats it (the proof's opus neon review)" \
  '[ "$rc" = 0 ] && [ "$(wc -l < "$FIX/runs")" = 3 ] && [ -f "$FIX/lane/review/opus/unit" ] && [ -f "$FIX/lane/review/neon/unit" ]' "rc $rc: $(cat "$FIX/review.out")"
# agy reads only the worktree and --add-dir folders: neon gets the brief's lane folder, else its folder.
for where in i3 i3/deep elsewhere; do
  new_fix
  echo good > "$FIX/probe-mode"; mkdir -p "$FIX/lane/$where" "$FIX/elsewhere"
  brief=$FIX/lane/$where/review-brief.md want=$FIX/lane
  if [ "$where" = elsewhere ]; then brief=$FIX/elsewhere/review-brief.md want=$FIX/elsewhere; fi
  echo brief > "$brief"
  "$HERE/review.sh" "$FIX/lane" "$brief" "$FIX/lane/review" reach neon > "$FIX/review.out" 2>&1; rc=$?
  check "a brief in $where gives neon --add-dir $want, never a folder above it" \
    '[ "$rc" = 0 ] && [ "$(grep -c -- "--add-dir $want --settings {" "$FIX/runs")" = 2 ]' "rc $rc: $(cat "$FIX/runs")"
done
# A relative brief through a symlinked working directory: the file check resolves `..` physically.
new_fix
echo good > "$FIX/probe-mode"; mkdir -p "$FIX/lane/sub" "$FIX/lane/i4"; echo brief > "$FIX/lane/i4/review-brief.md"
rm -f "$WORK/cur"; ln -s "$FIX/lane/sub" "$WORK/cur"
(cd "$WORK/cur" && timeout 60 "$HERE/review.sh" "$FIX/lane" ../i4/review-brief.md "$FIX/lane/review" sym neon) > "$FIX/review.out" 2>&1; rc=$?
check "a brief reached through a symlink and .. still finds its lane, without hanging" \
  '[ "$rc" = 0 ] && [ "$(grep -c -- "--add-dir $FIX/lane --settings {" "$FIX/runs")" = 2 ]' "rc $rc: $(cat "$FIX/review.out")"
# The stubs without agy, then PATH without any folder that has one (agy may be installed here).
mkdir -p "$WORK/noagy"
for f in "$WORK/bin"/*; do [ "${f##*/}" = agy ] || ln -s "$f" "$WORK/noagy/"; done
NOAGY=$(IFS=:; for d in $PATH; do [ -x "$d/agy" ] || printf '%s:' "$d"; done)
new_fix
echo good > "$FIX/probe-mode"; echo brief > "$FIX/lane/brief.md"
env PATH="$WORK/noagy:${NOAGY%:}" FASTLANE_SEATS="opus sol neon" "$HERE/review.sh" "$FIX/lane" "$FIX/lane/brief.md" "$FIX/lane/review" panel > "$FIX/review.out" 2>&1; rc=$?
check "without agy on PATH neon is a missing seat: reported, never launched or waited on" \
  '[ "$rc" = 0 ] && grep -qx "neon missing: executable unavailable" "$FIX/lane/review/neon-missing" && [ ! -e "$FIX/lane/review/neon" ] &&
   [ ! -e "$FIX/lane/review/neon-probe" ] && [ "$(wc -l < "$FIX/runs")" = 2 ] && [ "$(wc -l < "$FIX/lane/waits")" = 2 ]' "rc $rc: $(cat "$FIX/review.out")"
for mode in failed empty; do
  new_fix
  echo "$mode" > "$FIX/probe-mode"; echo brief > "$FIX/lane/brief.md"
  env FASTLANE_SEATS="opus sol neon" "$HERE/review.sh" "$FIX/lane" "$FIX/lane/brief.md" "$FIX/lane/review" panel > "$FIX/review.out" 2>&1; rc=$?
  check "$mode neon probe (signed out, refused) is reported missing and leaves no reader to wait on" \
    '[ "$rc" = 0 ] && grep -q "neon missing: one-word probe did not answer" "$FIX/lane/review/neon-missing" && [ ! -d "$FIX/lane/review/neon" ] && [ "$(wc -l < "$FIX/lane/waits")" = 2 ]' "rc $rc: $(cat "$FIX/review.out")"
done

# --- FASTLANE_NEON_DIRS: extra folders neon may read, named by the caller ------------------------
# A fake home with model config and credential entries, one of them a link to a folder outside it.
NH=$WORK/nhome NX=$(cd -P "$WORK" && pwd)/nx
mkdir -p "$NH/.gemini" "$NH/.grok/sub" "$NH/.ssh" "$NH/p/repo" "$NX/sib" "$NX/notes" "$NX/out/claude-real/x" "$NX/sp ace"
ln -s "$NX/out/claude-real" "$NH/.claude"; ln -s "$NX/sib" "$NX/sib-link"; ln -s "$NH/.gemini" "$NX/gem-link"
ln -s "$NX/sp ace" "$NX/space-link"
: > "$NX/sib/file"
nd() { env HOME="$NH" FASTLANE_NEON_DIRS="$1" "$HERE/neon.py" --dirs 2> "$WORK/nd.err"; }
out=$(env -u FASTLANE_NEON_DIRS HOME="$NH" "$HERE/neon.py" --dirs 2>&1); rc=$?
check "unset FASTLANE_NEON_DIRS names no folder" '[ "$rc" = 0 ] && [ -z "$out" ]' "rc $rc: $out"
out=$(nd "$NX/sib:$NX/sib-link:$NH/p/repo/"); rc=$?
check "FASTLANE_NEON_DIRS prints each folder resolved, a sibling checkout under home included" \
  '[ "$rc" = 0 ] && [ "$out" = "$(printf "%s\n" "$NX/sib" "$NX/sib" "$(cd -P "$NH/p/repo" && pwd)")" ]' "rc $rc: $out $(cat "$WORK/nd.err")"
while IFS='|' read -r entry why; do
  out=$(nd "$entry"); rc=$?
  check "FASTLANE_NEON_DIRS='$entry' is refused: $why" \
    '[ "$rc" = 2 ] && [ -z "$out" ] && grep -q "^FASTLANE_NEON_DIRS: .*$why" "$WORK/nd.err"' "rc $rc: $out $(cat "$WORK/nd.err")"
done <<EOF
|an empty entry
$NX/sib:|an empty entry
rel/dir|not an absolute path
$NX/missing|not an existing folder
$NX/sib/file|not an existing folder
$NX/sp ace|plain paths only
$NX/space-link|resolves to $NX/sp ace, not a plain path
/|holds the home folder
$NH|holds the home folder
$WORK|holds the home folder
$NH/.gemini|a no-read location
$NH/.grok/sub|a no-read location
$NH/.ssh|a no-read location
$NX/gem-link|a no-read location
$NX/out/claude-real/x|a no-read location
$NX/out|a no-read location
$NX/notes:$NH/p/../.ssh|a no-read location
EOF
# A home that can be entered but not listed hides where its entries lead: refuse rather than guess.
mkdir -p "$WORK/shut/.gemini/sub"; chmod 311 "$WORK/shut"
out=$(env HOME="$WORK/shut" FASTLANE_NEON_DIRS="$NX/notes" "$HERE/neon.py" --dirs 2> "$WORK/nd.err"); rc=$?
out2=$(env HOME="$WORK/shut" FASTLANE_NEON_DIRS="$WORK/shut/.gemini/sub" "$HERE/neon.py" --dirs 2>> "$WORK/nd.err"); rc2=$?
chmod 755 "$WORK/shut"
check "a home folder that cannot be listed refuses FASTLANE_NEON_DIRS, ~/.gemini/sub included" \
  '[ "$rc" = 2 ] && [ "$rc2" = 2 ] && [ -z "$out$out2" ] && [ "$(grep -c "^FASTLANE_NEON_DIRS: cannot list $WORK/shut to check the no-read locations" "$WORK/nd.err")" = 2 ]' "rc $rc $rc2: $(cat "$WORK/nd.err")"
new_fix
echo good > "$FIX/probe-mode"; echo brief > "$FIX/lane/brief.md"
env HOME="$NH" FASTLANE_NEON_DIRS="$NX/sib-link:$NX/notes" "$HERE/review.sh" "$FIX/lane" "$FIX/lane/brief.md" "$FIX/lane/review" dirs opus sol neon > "$FIX/review.out" 2>&1; rc=$?
check "each FASTLANE_NEON_DIRS folder becomes one more --add-dir on both neon calls, and only there" \
  '[ "$rc" = 0 ] && [ "$(grep -c -- "--add-dir $FIX/lane --add-dir $NX/sib --add-dir $NX/notes --settings {" "$FIX/runs")" = 2 ] &&
   [ "$(grep -c -- "$NX" "$FIX/runs")" = 2 ] && [ -f "$FIX/lane/review/neon/unit" ]' "rc $rc: $(cat "$FIX/runs")"
for seats in 'opus sol neon' 'opus sol'; do
  new_fix
  echo good > "$FIX/probe-mode"; echo brief > "$FIX/lane/brief.md"
  env HOME="$NH" FASTLANE_NEON_DIRS="$NX/notes:$NH/.gemini" "$HERE/review.sh" "$FIX/lane" "$FIX/lane/brief.md" "$FIX/lane/review" dirs $seats > "$FIX/review.out" 2>&1; rc=$?
  check "a refused FASTLANE_NEON_DIRS starts nothing, whatever the seats ($seats)" \
    '[ "$rc" = 2 ] && grep -q "FASTLANE_NEON_DIRS: $NH/.gemini: inside or holding a no-read location" "$FIX/review.out" && [ ! -s "$FIX/runs" ] && [ ! -e "$FIX/lane/review" ]' "rc $rc: $(cat "$FIX/review.out")"
done

# --- neon.py with a stub agy that prints the CLI's JSON ------------------------------------------
mkdir -p "$WORK/agybin"
cat > "$WORK/agybin/agy" <<'STUB'
#!/bin/sh
printf '%s\n' "$*" > "$NEON_FIX/args"
wc -c > "$NEON_FIX/stdin-bytes"
case $NEON_MODE in
  answer) echo '{"conversation_id":"c1","status":"SUCCESS","response":"[P2] [PRODUCT] a.sh:1: claim","duration_seconds":3,"num_turns":2,"usage":{"total_tokens":9}}' ;;
  denied-answer) echo '{"status":"SUCCESS","response":"No findings.","denied_actions":[{"tool":"run_command","command":"git diff"}]}' ;;
  denied-empty) echo '{"status":"SUCCESS","response":"","denied_actions":[{"tool":"write_file"}]}' ;;
  # agy 1.5.6 and 1.5.13 on a file outside the worktree and --add-dir folders: no path is recorded.
  denied-read) echo '{"status":"SUCCESS","response":"","num_turns":1,"denied_actions":[{"action":"read_file","display_name":"ReadFile"}]}' ;;
  empty) echo '{"status":"SUCCESS","response":"   "}' ;;
  no-response) echo '{"status":"SUCCESS"}' ;;
  signed-out) echo 'Sign in at https://example.invalid/device' >&2
    echo '{"status":"ERROR","error":"authentication failed or timed out","response":""}'; exit 1 ;;
  not-json) echo 'plain text' ;;
esac
STUB
chmod +x "$WORK/agybin/agy"
neon() { # MODE: run neon.py on the stub with stdin from a non-empty file
  NEON_FIX=$WORK/neon-$1; rm -rf "$NEON_FIX"; mkdir -p "$NEON_FIX"; echo stdin > "$NEON_FIX/stdin"
  env NEON_FIX="$NEON_FIX" NEON_MODE="$1" "$HERE/neon.py" "$NEON_FIX" -- "$WORK/agybin/agy" -p "a prompt" --output-format json \
    < "$NEON_FIX/stdin" > "$NEON_FIX/answer.md" 2> "$NEON_FIX/err"
}
neon answer; rc=$?
check "neon.py prints the response, keeps the raw JSON, passes arguments through and closes stdin" \
  '[ "$rc" = 0 ] && [ "$(cat "$NEON_FIX/answer.md")" = "[P2] [PRODUCT] a.sh:1: claim" ] && grep -q "\"conversation_id\":\"c1\"" "$NEON_FIX/agy.json" &&
   [ "$(cat "$NEON_FIX/args")" = "-p a prompt --output-format json" ] && [ "$(cat "$NEON_FIX/stdin-bytes")" = 0 ] && [ ! -e "$NEON_FIX/denied-actions" ]' "rc $rc: $(cat "$NEON_FIX/err")"
neon denied-answer; rc=$?
check "a denied action with an answer still counts, and is recorded" \
  '[ "$rc" = 0 ] && [ "$(cat "$NEON_FIX/answer.md")" = "No findings." ] && grep -q run_command "$NEON_FIX/denied-actions" &&
   grep -q "neon: agy denied 1 action(s)" "$NEON_FIX/err"' "rc $rc: $(cat "$NEON_FIX/err")"
neon denied-empty; rc=$?
check "a denied action that leaves an empty response is a failed seat, recorded" \
  '[ "$rc" = 1 ] && [ ! -s "$NEON_FIX/answer.md" ] && grep -q write_file "$NEON_FIX/denied-actions" && grep -q "empty response" "$NEON_FIX/err"' "rc $rc: $(cat "$NEON_FIX/err")"
check "an empty response after a denied write does not blame the readable folders" '! grep -q "FASTLANE_NEON_DIRS" "$NEON_FIX/err"' "$(cat "$NEON_FIX/err")"
neon denied-read; rc=$?
check "an empty response after a denied read_file says a file outside the readable folders was probably named, and names the setting" \
  '[ "$rc" = 1 ] && [ ! -s "$NEON_FIX/answer.md" ] && grep -q read_file "$NEON_FIX/denied-actions" &&
   grep -q "^neon: empty response, a failed seat: agy denied a read_file, so its brief probably named a file outside the readable folders (the worktree, the brief.s lane folder and FASTLANE_NEON_DIRS); name that file.s folder in FASTLANE_NEON_DIRS$" "$NEON_FIX/err"' "rc $rc: $(cat "$NEON_FIX/err")"
for mode in empty no-response not-json; do
  neon "$mode"; rc=$?
  check "neon.py fails the seat on $mode output (agy exited 0)" '[ "$rc" = 1 ] && [ ! -s "$NEON_FIX/answer.md" ]' "rc $rc: $(cat "$NEON_FIX/err")"
done
neon signed-out; rc=$?
check "a signed-out agy (exit 1, status ERROR) fails the seat and names the error" \
  '[ "$rc" = 1 ] && [ ! -s "$NEON_FIX/answer.md" ] && grep -q "agy error: authentication failed or timed out" "$NEON_FIX/err" && grep -q "status ERROR" "$NEON_FIX/err"' "rc $rc: $(cat "$NEON_FIX/err")"

# --- decision-panel integration with the shared seats and waits --------------------------------
new_fix
echo post-submit-error > "$FIX/probe-mode"
mkdir "$FIX/question"
printf 'Which should we ship? A (today) or B (tomorrow)?\n' > "$FIX/question/question.md"
printf 'A\nB\n' > "$FIX/question/options"
echo 'Consider the cost to operations.' > "$FIX/question/opus.lens.md"
OUT="$FIX/lane/decision"
env FASTLANE_OPUS_MODEL=claude-fable-5-2 FASTLANE_FABLE_MODEL=claude-opus-5-5 \
  FASTLANE_ASTRA_MODEL=override-astra FASTLANE_SOL_MODEL=override-sol \
  "$HERE/decision-panel.py" launch "$FIX/lane" "$FIX/question" "$OUT" decide --fable > "$FIX/decision.out" 2>&1; rc=$?
check "decision panel launches the shared seats including optional fable" \
  '[ "$rc" = 0 ] && [ "$(wc -l < "$FIX/runs")" = 6 ] && [ -f "$OUT/fable/unit" ] && [ -f "$OUT/launch-complete" ]' "rc $rc: $(cat "$FIX/decision.out")"
check "Grok seats after a probe answers even while unit status is unavailable" \
  '[ -f "$FIX/probe-query-failed" ] && [ -f "$OUT/grok/unit" ] && [ ! -f "$OUT/grok-missing" ] &&
   grep -qx -- GROK_OK "$OUT/grok-probe/answer.md"' "$(cat "$FIX/decision.out")"
check "only opus gets its lens and every reader gets the decision brief" \
  '[ "$(grep -c -- "decision brief $OUT/brief.md" "$FIX/runs")" = 5 ] && [ "$(grep -c -- "opus.lens.md" "$FIX/runs")" = 1 ] &&
   grep -q -- "fastlane-decide-opus.*opus.lens.md" "$FIX/runs" && cmp -s "$FIX/question/opus.lens.md" "$OUT/opus.lens.md"' "$(cat "$FIX/runs")"
check "decision readers can use read-only commands to read their brief and lens" \
  '[ "$(grep -c -- "Use commands only to read files" "$FIX/runs")" = 5 ]' "$(cat "$FIX/runs")"
check "shared launcher uses the worktree, null stdin and 5400 second seat timeout" \
  '[ "$(grep -c -- "--working-directory=$FIX/lane.*OOMPolicy=continue.*StandardInput=null.*5400" "$FIX/runs")" = 5 ]' "$(cat "$FIX/runs")"
check "Claude seats use the short cache, no auto-compaction override and high effort" \
  '[ "$(grep -c -- "-u CLAUDE_CODE_AUTO_COMPACT_WINDOW CLAUDE_CODE_PROMPT_CACHE_TTL=5m.*--effort high" "$FIX/runs")" = 2 ] &&
   ! grep -q -- "--no-session-persistence" "$FIX/runs"' "$(cat "$FIX/runs")"
check "decision votes keep their prescribed Claude seat models despite lane overrides" \
  'grep -q -- "fastlane-decide-opus.*--model claude-opus-5-5" "$FIX/runs" &&
   grep -q -- "fastlane-decide-fable.*--model claude-fable-5-2" "$FIX/runs"' "$(cat "$FIX/runs")"
check "both Codex seats use the prescribed models and effort in read-only mode" \
  '[ "$(grep -Ec -- "--sandbox read-only -m gpt-6.2-(astra|sol) -c model_reasoning_effort=high" "$FIX/runs")" = 2 ]' "$(cat "$FIX/runs")"
"$HERE/decision-panel.py" collect 0 "$OUT" > "$FIX/collect.out" 2>&1; rc=$?
check "collect returns 124 while a required reader is active and writes no synthesis" \
  '[ "$rc" = 124 ] && [ ! -e "$OUT/synthesis.md" ]' "rc $rc: $(cat "$FIX/collect.out")"
for seat in opus astra sol grok; do
  printf 'PICK: A\nRANKING: A B\nCAN LIVE WITH: A\nARGUMENT: A is ready.\n' > "$OUT/$seat/answer.md"
  echo 'success exited 0' > "$OUT/$seat/exit"
done
"$HERE/decision-panel.py" collect 0 "$OUT" > "$FIX/collect.out" 2>&1; rc=$?
check "collect succeeds without waiting on active fable" \
  '[ "$rc" = 0 ] && [ -f "$FIX/active/fastlane-decide-fable" ] && grep -qx "Counts (4 answering): A=4 B=0" "$FIX/collect.out"' \
  "rc $rc: $(cat "$FIX/collect.out")"

new_fix
echo good > "$FIX/probe-mode"
mkdir "$FIX/question"
printf 'Which should we ship? A (today) or B (tomorrow)?\n' > "$FIX/question/question.md"
printf 'A\nB\n' > "$FIX/question/options"
OUT="$FIX/lane/decision"
env FASTLANE_SEATS="opus sol grok" "$HERE/decision-panel.py" launch "$FIX/lane" "$FIX/question" "$OUT" seated > "$FIX/decision.out" 2>&1; rc=$?
check "under FASTLANE_SEATS a decision panel leaves astra unseated" \
  '[ "$rc" = 0 ] && [ "$(wc -l < "$FIX/runs")" = 4 ] && [ ! -e "$OUT/astra" ] && ! grep -q astra "$FIX/runs" &&
   [ "$(cat "$OUT/seats")" = "opus sol grok" ] && [ -f "$OUT/launch-complete" ]' "rc $rc: $(cat "$FIX/decision.out")"
for seat in opus sol grok; do
  printf 'PICK: A\nRANKING: A B\nCAN LIVE WITH: A\nARGUMENT: A is ready.\n' > "$OUT/$seat/answer.md"
  echo 'success exited 0' > "$OUT/$seat/exit"
done
"$HERE/decision-panel.py" collect 0 "$OUT" > "$FIX/collect.out" 2>&1; rc=$?
check "collect waits on the seated readers only and reports astra as not seated" \
  '[ "$rc" = 0 ] && [ "$(tail -n 3 "$FIX/collect.out")" = "$(printf "Not seated: astra\nCounts (3 answering): A=3 B=0\nVERDICT: A accepted under the owner'"'"'s 2026-11-05 panel rule")" ] &&
   grep -qx -- "- astra was not seated." "$OUT/synthesis.md"' "rc $rc: $(cat "$FIX/collect.out")"
for seats in 'opus astra grok' 'opus sol' 'opus astra sol' 'opus grok'; do
  new_fix
  echo empty > "$FIX/probe-mode"
  mkdir "$FIX/question"; echo 'Ship A or B?' > "$FIX/question/question.md"; printf 'A\nB\n' > "$FIX/question/options"
  env FASTLANE_SEATS="$seats" "$HERE/decision-panel.py" launch "$FIX/lane" "$FIX/question" "$FIX/lane/decision" bad > "$FIX/decision.out" 2>&1; rc=$?
  check "a decision panel refuses FASTLANE_SEATS='$seats' and starts nothing" \
    '[ "$rc" = 2 ] && grep -q FASTLANE_SEATS "$FIX/decision.out" && [ ! -s "$FIX/runs" ] && [ ! -e "$FIX/lane/decision" ]' "rc $rc: $(cat "$FIX/decision.out")"
done

new_fix
echo good > "$FIX/probe-mode"
mkdir "$FIX/question"; echo 'Ship A or B?' > "$FIX/question/question.md"; printf 'A\nB\n' > "$FIX/question/options"
OUT="$FIX/lane/decision"
"$HERE/decision-panel.py" launch "$FIX/lane" "$FIX/question" "$OUT" neon --neon > "$FIX/decision.out" 2>&1; rc=$?
check "--neon seats the optional neon seat after the required ones" \
  '[ "$rc" = 0 ] && [ "$(cat "$OUT/seats")" = "opus astra sol grok neon" ] && [ -f "$OUT/neon/unit" ] && [ -f "$OUT/launch-complete" ] &&
   grep -q -- "--unit=fastlane-neon-neon .*neon.py $OUT/neon -- .*agy -p Read the decision brief $OUT/brief.md.*~/.gemini. --model gemini-4-neon-high --output-format json --print-timeout 5390s --add-dir $FIX/lane --settings {" "$FIX/runs"' "rc $rc: $(cat "$FIX/decision.out")"
for seat in opus astra sol grok; do
  printf 'PICK: A\nRANKING: A B\nCAN LIVE WITH: A\nARGUMENT: A is ready.\n' > "$OUT/$seat/answer.md"
  echo 'success exited 0' > "$OUT/$seat/exit"
done
"$HERE/decision-panel.py" collect 0 "$OUT" > "$FIX/collect.out" 2>&1; rc=$?
check "collect waits on a launched neon like grok" '[ "$rc" = 124 ] && [ ! -e "$OUT/synthesis.md" ]' "rc $rc: $(cat "$FIX/collect.out")"
printf 'PICK: B\nRANKING: B A\nCAN LIVE WITH: A B\nARGUMENT: B is safer.\n' > "$OUT/neon/answer.md"
echo 'success exited 0' > "$OUT/neon/exit"
"$HERE/decision-panel.py" collect 0 "$OUT" > "$FIX/collect.out" 2>&1; rc=$?
check "neon's ballot counts: 4 of 5 with opus accept" \
  '[ "$rc" = 0 ] && grep -qx "Counts (5 answering): A=4 B=1" "$FIX/collect.out" && grep -q "^VERDICT: A accepted" "$FIX/collect.out" &&
   grep -qx -- "- neon picked B. B is safer." "$OUT/synthesis.md"' "rc $rc: $(cat "$FIX/collect.out")"
new_fix
echo good > "$FIX/probe-mode"
mkdir "$FIX/question"; echo 'Ship A or B?' > "$FIX/question/question.md"; printf 'A\nB\n' > "$FIX/question/options"
env FASTLANE_SEATS="opus sol grok neon" "$HERE/decision-panel.py" launch "$FIX/lane" "$FIX/question" "$FIX/lane/decision" seated > "$FIX/decision.out" 2>&1; rc=$?
check "FASTLANE_SEATS with neon seats it in a decision panel too" \
  '[ "$rc" = 0 ] && [ "$(cat "$FIX/lane/decision/seats")" = "opus sol grok neon" ] && [ -f "$FIX/lane/decision/neon/unit" ]' "rc $rc: $(cat "$FIX/decision.out")"
new_fix
echo good > "$FIX/probe-mode"
mkdir "$FIX/question"; echo 'Ship A or B?' > "$FIX/question/question.md"; printf 'A\nB\n' > "$FIX/question/options"
env PATH="$WORK/noagy:${NOAGY%:}" "$HERE/decision-panel.py" launch "$FIX/lane" "$FIX/question" "$FIX/lane/decision" gone --neon > "$FIX/decision.out" 2>&1; rc=$?
check "a decision panel with agy missing records neon missing and still launches" \
  '[ "$rc" = 0 ] && [ -s "$FIX/lane/decision/neon-missing" ] && [ ! -e "$FIX/lane/decision/neon" ] && [ -f "$FIX/lane/decision/launch-complete" ]' "rc $rc: $(cat "$FIX/decision.out")"
new_fix
echo good > "$FIX/probe-mode"
mkdir "$FIX/question"; echo 'Ship A or B?' > "$FIX/question/question.md"; printf 'A\nB\n' > "$FIX/question/options"
env HOME="$NH" FASTLANE_NEON_DIRS="$NX/notes" "$HERE/decision-panel.py" launch "$FIX/lane" "$FIX/question" "$FIX/lane/decision" dirs --neon > "$FIX/decision.out" 2>&1; rc=$?
check "a decision panel's neon reads the FASTLANE_NEON_DIRS folders too" \
  '[ "$rc" = 0 ] && grep -q -- "--unit=fastlane-dirs-neon .*--add-dir $FIX/lane --add-dir $NX/notes --settings {" "$FIX/runs"' "rc $rc: $(cat "$FIX/runs")"
new_fix
mkdir "$FIX/question"; echo 'Ship A or B?' > "$FIX/question/question.md"; printf 'A\nB\n' > "$FIX/question/options"
env HOME="$NH" FASTLANE_NEON_DIRS=/ "$HERE/decision-panel.py" launch "$FIX/lane" "$FIX/question" "$FIX/lane/decision" dirs --neon > "$FIX/decision.out" 2>&1; rc=$?
check "a decision panel refuses a bad FASTLANE_NEON_DIRS and starts nothing" \
  '[ "$rc" = 2 ] && grep -q "FASTLANE_NEON_DIRS: /: holds the home folder" "$FIX/decision.out" && [ ! -s "$FIX/runs" ] && [ ! -e "$FIX/lane/decision" ]' "rc $rc: $(cat "$FIX/decision.out")"

# --- combined packet integration with the real shared launcher and wait ------------------------
new_fix
mkdir -p "$FIX/packet" "$FIX/wt"
: > "$FIX/packet/waits"; echo task > "$FIX/packet/task.md"
git -C "$FIX/wt" init -q
git -C "$FIX/wt" -c user.name=t -c user.email=t@t commit -q --allow-empty -m base
printf '{"name":"packet","worktree":"%s"}\n' "$FIX/wt" > "$FIX/packet/config.json"
env FASTLANE_MANAGER=coordinator "$HERE/../../cfastlane/scripts/session.sh" "$FIX/packet" > "$FIX/session.out" 2>&1; rc=$?
check "a combined session finds its packet wait record and is kind other" \
  '[ "$rc" = 0 ] && grep -q "^coordinator | cfl-packet-s1 | $FIX/packet/turns/1/session/exit |" "$FIX/packet/waits" && [ "$(cat "$FIX/packet/turns/1/session/kind")" = other ]' "rc $rc: $(cat "$FIX/session.out")"
echo 'success exited 0' > "$FIX/packet/turns/1/session/exit"
"$WS" 0 "$FIX/packet/turns/1/session" > "$FIX/wait.out" 2>&1; rc=$?
check "wait.sh consumes a combined session exit and clears its packet record" \
  '[ "$rc" = 0 ] && [ ! -s "$FIX/packet/waits" ]' "rc $rc: $(cat "$FIX/wait.out")"
"$LU" --kind live packet-live "$FIX/packet/live" -- /bin/true > "$FIX/launch.out" 2>&1
"$LU" --kind deploy packet-deploy "$FIX/packet/deploy" -- /bin/true > "$FIX/launch.out" 2>&1; rc=$?
check "packet-root live unit blocks deployment through the same busy check" \
  '[ "$rc" = 3 ] && grep -q "live unit packet-live is active" "$FIX/launch.out"' "rc $rc: $(cat "$FIX/launch.out")"
# The session's unit inherits no FASTLANE_NEON_DIRS: session.sh keeps it in the packet for review.sh.
new_fix
echo good > "$FIX/probe-mode"
mkdir -p "$FIX/packet" "$FIX/wt"
: > "$FIX/packet/waits"; echo task > "$FIX/packet/task.md"
git -C "$FIX/wt" init -q
git -C "$FIX/wt" -c user.name=t -c user.email=t@t commit -q --allow-empty -m base
printf '{"name":"packet","worktree":"%s"}\n' "$FIX/wt" > "$FIX/packet/config.json"
sed -n '/^# Review iN:/,/^```$/ { /^```$/d; p; }' "$HERE/../references/prompts.md" > "$FIX/packet/review-brief.md"
env HOME="$NH" FASTLANE_NEON_DIRS="$NX/notes" "$HERE/../../cfastlane/scripts/session.sh" "$FIX/packet" > "$FIX/session.out" 2>&1; rc=$?
env -u FASTLANE_NEON_DIRS HOME="$NH" "$HERE/../../cfastlane/scripts/review.sh" "$FIX/packet" opus sol neon > "$FIX/review.out" 2>&1; rc2=$?
check "a review the session launches through cfastlane review.sh gives neon the session's FASTLANE_NEON_DIRS" \
  '[ "$rc" = 0 ] && [ "$rc2" = 0 ] && [ "$(cat "$FIX/packet/neon-dirs")" = "$NX/notes" ] &&
   [ "$(grep -c -- "--add-dir $FIX/packet --add-dir $NX/notes --settings {" "$FIX/runs")" = 2 ]' "rc $rc $rc2: $(cat "$FIX/session.out" "$FIX/review.out" "$FIX/runs")"

# --- the implementer prompt ---------------------------------------------------------------------
new_fix
echo task > "$FIX/lane/i1/task.md"
(cd "$FIX/lane" && "$HERE/implement.sh" "$FIX/lane" i1/task.md i1/impl fl-i1-impl) > "$FIX/launch.out" 2>&1; rc=$?
check "the implementer leaves work undone only for a named obstacle, never for remaining work" \
  '[ "$rc" = 0 ] && grep -q "Leave something undone only for a named obstacle.*Work that merely remains is not an obstacle.*if anything is undone, it names the obstacle" "$FIX/runs"' "rc $rc: $(cat "$FIX/launch.out")"
check "the implementer runs named checks in full while other tests are suspended" \
  'grep -q "Run every check the task names as required, in full, including its tests. That is never a reason to stop. Other tests are suspended" "$FIX/runs" &&
   grep -q "For standalone builds, compile only what the task says gets deployed" "$FIX/runs"' "rc $rc: $(cat "$FIX/launch.out")"
CODEX_RUN=$(sed -n 1p "$FIX/runs")
check "by default the implementer is codex sol at effort high" \
  '[[ "$CODEX_RUN" == *"codex exec --dangerously-bypass-approvals-and-sandbox -m gpt-6.2-sol -c model_reasoning_effort=high"* && "$CODEX_RUN" != *"claude -p"* ]]' "$CODEX_RUN"
for engine in claude-opus CLAUDE codex2; do
  runs_before=$(wc -l < "$FIX/runs")
  (cd "$FIX/lane" && env FASTLANE_IMPL_ENGINE=$engine "$HERE/implement.sh" "$FIX/lane" i1/task.md "i1/impl-$engine" "fl-i1-$engine") > "$FIX/launch.out" 2>&1; rc=$?
  check "an unknown implementer engine ($engine) is refused and starts nothing" \
    '[ "$rc" = 2 ] && grep -q "FASTLANE_IMPL_ENGINE must be codex or claude" "$FIX/launch.out" && [ "$(wc -l < "$FIX/runs")" = "$runs_before" ] && [ ! -e "$FIX/lane/i1/impl-$engine" ]' "rc $rc: $(cat "$FIX/launch.out")"
done
(cd "$FIX/lane" && env FASTLANE_IMPL_ENGINE=claude FASTLANE_TESTS=on "$HERE/implement.sh" "$FIX/lane" i1/task.md i1/impl-claude fl-i1-claude 900) > "$FIX/launch.out" 2>&1; rc=$?
CLAUDE_RUN=$(tail -n 1 "$FIX/runs")
check "FASTLANE_IMPL_ENGINE=claude runs Opus at effort high in the same capped unit" \
  '[ "$rc" = 0 ] && [[ "$CLAUDE_RUN" == *"--unit=fl-i1-claude "*"--working-directory=$FIX/lane "*"MemoryMax=16G -p MemorySwapMax=0 -p OOMPolicy=continue -p StandardInput=null -p StandardOutput=file:$FIX/lane/i1/impl-claude/answer.md -p StandardError=file:$FIX/lane/i1/impl-claude/err"* ]] &&
   [[ "$CLAUDE_RUN" == *" -u CLAUDE_CODE_AUTO_COMPACT_WINDOW BASH_MAX_TIMEOUT_MS=3600000 "*"timeout 900 "*"claude -p Read the task file $FIX/lane/i1/task.md"*" --model claude-opus-5-5 --effort high --dangerously-skip-permissions --strict-mcp-config --mcp-config"* ]]' "rc $rc: $CLAUDE_RUN"
check "the Claude implementer keeps its transcript and the long-session cache" \
  '[[ "$CLAUDE_RUN" != *"--no-session-persistence"* && "$CLAUDE_RUN" != *"CLAUDE_CODE_PROMPT_CACHE_TTL"* && "$CLAUDE_RUN" != *"codex"* ]]' "$CLAUDE_RUN"
check "the Claude implementer gets the same prompt, tests-back line included" \
  '[[ "$CLAUDE_RUN" == *"Tests are back: run, fix, edit or add tests only as the task file says."*"Leave something undone only for a named obstacle"* ]]' "$CLAUDE_RUN"
check "the Claude implementer is told to follow the project's AGENTS.md, which codex reads itself" \
  '[[ "$CLAUDE_RUN" == *"Read and follow every AGENTS.md from the repository root down to $FIX/lane."* && "$CODEX_RUN" != *"AGENTS.md"* ]]' "$CLAUDE_RUN"
check "the manager brief uses the lane caps and the Opus fallback uses its wait procedure" \
  'grep -Fq "For fastlane and cfastlane, use" "$HERE/../../delegate-to-manager/references/manager-brief-template.md" &&
   grep -Fq "section 7 for Sol resumes and section 2 for Opus relays" "$HERE/../SKILL.md" &&
   grep -Fq "#4-watching-long-jobs" "$HERE/../SKILL.md"' ""
check "the manager brief and relay preserve fastlane batching" \
  'grep -Fq "In fastlane, batch the calls" "$HERE/../../delegate-to-manager/references/manager-brief-template.md" &&
   grep -Fq "In fastlane, relay the manager" "$HERE/../../delegate-to-manager/SKILL.md"' ""

echo "passed $PASS, failed $FAIL"
[[ "$FAIL" == 0 ]]

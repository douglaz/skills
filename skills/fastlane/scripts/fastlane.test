#!/usr/bin/env bash
# fastlane.test — offline checks for launch-unit.sh and wait.sh: the wait record, the busy check and
# the disk floor. `systemctl`, `systemd-run` and `df` are stubs: a unit is "active" while
# $FIX/active/<unit> exists, systemd-run marks its unit active and logs its arguments to $FIX/runs,
# and df reports $FIX/free-kb KiB free. Starts no unit.
#
# Usage: ./fastlane.test          (exits 0 if all pass)

set -uo pipefail
HERE=$(cd "$(dirname "$0")" && pwd)
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
PASS=0; FAIL=0

mkdir -p "$WORK/bin"
cat > "$WORK/bin/systemctl" <<'STUB'
#!/usr/bin/env bash
# systemctl --user is-active --quiet UNIT
[ "$1 $2 $3" = "--user is-active --quiet" ] || { echo "unexpected systemctl call: $*" >&2; exit 9; }
case $4 in *-grok-probe)
  if [ -f "$FIX/probe-answer" ]; then
    touch "$FIX/probe-query-failed"
    exit 1
  fi ;;
esac
[ -e "$FIX/active/$4" ]
STUB
cat > "$WORK/bin/systemd-run" <<'STUB'
#!/usr/bin/env bash
echo "$*" >> "$FIX/runs"
unit= out=
for a in "$@"; do
  case $a in
    --unit=*) unit=${a#--unit=}; touch "$FIX/active/$unit" ;;
    StandardOutput=file:*) out=${a#StandardOutput=file:} ;;
  esac
done
case $unit in *-grok-probe)
  d=$(dirname "$out")
  case $(cat "$FIX/probe-mode") in
    good) echo GROK_OK > "$out"; echo 'success exited 0' > "$d/exit" ;;
    empty) : > "$out"; echo 'success exited 0' > "$d/exit" ;;
    failed) echo GROK_OK > "$out"; echo 'exit-code exited 1' > "$d/exit" ;;
    post-submit-error) printf '%s\n' "$out" "$unit" > "$FIX/probe-answer"; exit 0 ;;
  esac
  rm "$FIX/active/$unit"
  ;;
esac
STUB
FASTLANE_TEST_SLEEP=$(command -v sleep)
export FASTLANE_TEST_SLEEP
cat > "$WORK/bin/sleep" <<'STUB'
#!/bin/sh
# Let the probe finish after the waiter's first polling tick, independently of status queries.
if [ "$1" = 15 ] && [ -f "$FIX/probe-answer" ]; then
  { IFS= read -r out; IFS= read -r unit; } < "$FIX/probe-answer"
  echo GROK_OK > "$out"
  echo 'success exited 0' > "$(dirname "$out")/exit"
  rm "$FIX/active/$unit" "$FIX/probe-answer"
  exit 0
fi
exec "$FASTLANE_TEST_SLEEP" "$@"
STUB
cat > "$WORK/bin/df" <<'STUB'
#!/usr/bin/env bash
printf 'Filesystem 1024-blocks Used Available Capacity Mounted on\nfake 999999999 1 %s 1%% /\n' "$(cat "$FIX/free-kb")"
STUB
for tool in codex claude grok; do
  printf '#!/bin/sh\nexit 99\n' > "$WORK/bin/$tool"
  chmod +x "$WORK/bin/$tool"
done
chmod +x "$WORK/bin/systemctl" "$WORK/bin/systemd-run" "$WORK/bin/sleep" "$WORK/bin/df"
PATH="$WORK/bin:$PATH"
LU=$HERE/launch-unit.sh WS=$HERE/wait.sh

new_fix() { # a fresh lane folder with an empty record, 100 GiB free, nothing active
  FIX="$WORK/fix"; rm -rf "$FIX"; mkdir -p "$FIX/active" "$FIX/lane/i1"
  : > "$FIX/lane/waits"; echo $((100 * 1048576)) > "$FIX/free-kb"; : > "$FIX/runs"
  export FIX
}
ok() { PASS=$((PASS+1)); printf '  ok   %s\n' "$1"; }
bad() { FAIL=$((FAIL+1)); printf '  FAIL %s\n' "$1"; [ -n "${2:-}" ] && printf '       %s\n' "$2"; }
check() { if eval "$2"; then ok "$1"; else bad "$1" "$3"; fi; }
launch() { (cd "$FIX/lane" && env FASTLANE_CWD="$FIX/lane" "$LU" "$@") > "$FIX/launch.out" 2>&1; echo $?; }
ISO='[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}Z'

out=$("$WS" 2>&1); rc=$?
check "wait usage gives the deadline unit and a 55-minute example" \
  '[ "$rc" = 2 ] && [[ "$out" == *"seconds, e.g. 3300 for 55 minutes"* ]]' "rc $rc: $out"

# --- the wait record ---------------------------------------------------------------------------
new_fix
rc=$(launch --manager devices --kind other fl-i1-impl i1/impl -- /bin/true)
line=$(cat "$FIX/lane/waits")
check "launch in a lane exits 0" '[ "$rc" = 0 ]' "rc $rc: $(cat "$FIX/launch.out")"
check "launch appends one record line: manager | unit | exit path | ISO deadline" \
  '[ "$(wc -l < "$FIX/lane/waits")" = 1 ] && [[ "$line" =~ ^devices\ \|\ fl-i1-impl\ \|\ $FIX/lane/i1/impl/exit\ \|\ $ISO$ ]]' "line: $line"
check "launch writes unit, kind, manager and the record path into DIR" \
  '[ "$(cat "$FIX/lane/i1/impl/unit")" = fl-i1-impl ] && [ "$(cat "$FIX/lane/i1/impl/kind")" = other ] &&
   [ "$(cat "$FIX/lane/i1/impl/manager")" = devices ] && [ "$(cat "$FIX/lane/i1/impl/record")" = "$FIX/lane/waits" ]'

echo "lead | - | /abs/peer-handoff/exit | 2026-11-19T18:30Z" >> "$FIX/lane/waits"
rm "$FIX/active/fl-i1-impl"; echo "success exited 0" > "$FIX/lane/i1/impl/exit"
"$WS" 60 "$FIX/lane/i1/impl" > "$FIX/wait.out" 2>&1; rc=$?
check "wait.sh exits 0 on a finished unit" '[ "$rc" = 0 ]' "rc $rc: $(cat "$FIX/wait.out")"
check "wait.sh removes its line when the job has finished" '! grep -q "fl-i1-impl" "$FIX/lane/waits"' "$(cat "$FIX/lane/waits")"
check "wait.sh leaves a hand-written line (unit -) alone" \
  'grep -qx "lead | - | /abs/peer-handoff/exit | 2026-11-19T18:30Z" "$FIX/lane/waits"' "$(cat "$FIX/lane/waits")"

new_fix
launch --manager tests fl-i2-live i1/live -- /bin/true > /dev/null
launch --manager devices fl-i2-impl i1/impl -- /bin/true > /dev/null
"$WS" 0 "$FIX/lane/i1/live" > "$FIX/wait.out" 2>&1; rc=$?
check "wait.sh returns 124 at its own deadline" '[ "$rc" = 124 ]' "rc $rc: $(cat "$FIX/wait.out")"
check "wait.sh removes its line at its own deadline too" '! grep -q "fl-i2-live" "$FIX/lane/waits"' "$(cat "$FIX/lane/waits")"
check "wait.sh leaves another unit's line alone" 'grep -q "^devices | fl-i2-impl |" "$FIX/lane/waits"' "$(cat "$FIX/lane/waits")"

new_fix
launch --manager product --kind deploy fl-i5-deploy i1/deploy -- /bin/true > /dev/null
env FASTLANE_MANAGER=tests "$WS" 0 "$FIX/lane/i1/deploy" > "$FIX/wait.out" 2>&1
check "a manager waiting on a peer's unit leaves the peer's line alone" \
  'grep -q "^product | fl-i5-deploy |" "$FIX/lane/waits" && ! grep -q "^tests |" "$FIX/lane/waits"' "$(cat "$FIX/lane/waits")"

new_fix
launch --manager devices fl-i6-impl i1/impl -- /bin/true > /dev/null
echo "lead | - | /abs/peer-handoff/exit | 2026-11-19T18:30Z" >> "$FIX/lane/waits"
before=$(cat "$FIX/lane/waits")
mkdir -p "$WORK/failbin"; printf '#!/bin/sh\nexit 1\n' > "$WORK/failbin/awk"; chmod +x "$WORK/failbin/awk"
env PATH="$WORK/failbin:$PATH" "$WS" 0 "$FIX/lane/i1/impl" > "$FIX/wait.out" 2>&1
check "a record rewrite that fails (a full disk) leaves the record as it was" \
  '[ "$(cat "$FIX/lane/waits")" = "$before" ] && ! ls "$FIX/lane"/waits.tmp.* > /dev/null 2>&1' "$(cat "$FIX/lane/waits")"

new_fix
launch --manager tests fl-i3-live i1/live -- /bin/true > /dev/null
"$WS" 3300 "$FIX/lane/i1/live" > "$FIX/wait.out" 2>&1 & wpid=$!
for _ in $(seq 50); do grep -q "fl-i3-live" "$FIX/lane/waits" && [ -e "$FIX/lane/waits.lock" ] && break; sleep 0.1; done
sleep 0.5
during=$(cat "$FIX/lane/waits")
kill -TERM "$wpid"; wait "$wpid" 2>/dev/null
check "a running wait.sh keeps the unit's line, with its own deadline" \
  '[ "$(grep -c "fl-i3-live" <<<"$during")" = 1 ] && [[ "$during" =~ ^tests\ \|\ fl-i3-live\ \|\ .*/i1/live/exit\ \|\ $ISO$ ]]' "during: $during"
check "a wait.sh stopped by a signal removes its line" '! grep -q "fl-i3-live" "$FIX/lane/waits"' "$(cat "$FIX/lane/waits")"

new_fix
(cd "$FIX" && mkdir -p elsewhere && env FASTLANE_CWD="$FIX" "$LU" fl-x "$FIX/elsewhere/x" -- /bin/true) > "$FIX/launch.out" 2>&1; rc=$?
check "outside a lane folder a launch still starts, and writes no record" \
  '[ "$rc" = 0 ] && [ ! -e "$FIX/elsewhere/x/record" ] && [ ! -s "$FIX/lane/waits" ]' "rc $rc: $(cat "$FIX/launch.out")"

# --- the busy check ----------------------------------------------------------------------------
new_fix
launch --kind live fl-live i1/live -- /bin/true > /dev/null
runs_before=$(wc -l < "$FIX/runs")
rc=$(launch --kind deploy fl-deploy i1/deploy -- /bin/true)
check "a deploy refuses (exit 3) while a recorded live unit is active" '[ "$rc" = 3 ]' "rc $rc: $(cat "$FIX/launch.out")"
check "the refusal names the holder and starts nothing" \
  'grep -q "live unit fl-live is active" "$FIX/launch.out" && [ "$(wc -l < "$FIX/runs")" = "$runs_before" ] && ! grep -q fl-deploy "$FIX/lane/waits"' \
  "$(cat "$FIX/launch.out")"
"$WS" 0 "$FIX/lane/i1/live" > /dev/null 2>&1
rc=$(launch --kind deploy fl-deploy i1/deploy -- /bin/true)
check "the live unit still blocks a deploy after its wait returned and dropped its record line" \
  '[ "$rc" = 3 ] && ! grep -q "fl-live " "$FIX/lane/waits"' "rc $rc: $(cat "$FIX/launch.out"); $(cat "$FIX/lane/waits")"
rc=$(launch --kind other fl-impl i1/impl -- /bin/true)
check "an 'other' launch is not blocked by a live unit" '[ "$rc" = 0 ]' "rc $rc: $(cat "$FIX/launch.out")"
rc=$(launch --kind live fl-live2 i1/live2 -- /bin/true)
check "a second live run is not blocked by a live unit" '[ "$rc" = 0 ]' "rc $rc: $(cat "$FIX/launch.out")"
out=$("$LU" --check deploy "$FIX/lane" 2>&1); rc=$?
check "--check deploy exits 1 and prints the holders" '[ "$rc" = 1 ] && grep -q "fl-live" <<<"$out"' "rc $rc: $out"
out=$(cd "$FIX/lane/i1/impl" && "$LU" --check deploy 2>&1); rc=$?
check "--check deploy run from inside a unit's directory still finds the lane and its live unit" \
  '[ "$rc" = 1 ] && grep -q "fl-live" <<<"$out"' "rc $rc: $out"
out=$(cd "$FIX/lane/i1" && "$LU" --check other 2>&1); rc=$?
check "--check other exits 0, finding the lane folder above the current directory" '[ "$rc" = 0 ] && [ -z "$out" ]' "rc $rc: $out"
rm "$FIX/active/fl-live" "$FIX/active/fl-live2"
out=$("$LU" --check deploy "$FIX/lane" 2>&1); rc=$?
check "a finished live unit no longer blocks a deploy" '[ "$rc" = 0 ]' "rc $rc: $out"
rc=$(launch --kind deploy fl-deploy i1/deploy -- /bin/true)
check "with the live run over, the deploy starts" '[ "$rc" = 0 ]' "rc $rc: $(cat "$FIX/launch.out")"
rc=$(launch --kind live fl-live3 i1/live3 -- /bin/true)
check "a live run refuses (exit 3) while a recorded deploy is active" '[ "$rc" = 3 ] && grep -q "deploy unit fl-deploy" "$FIX/launch.out"' "rc $rc: $(cat "$FIX/launch.out")"
new_fix
mkdir -p "$FIX/lane/i9/stale"; echo live > "$FIX/lane/i9/stale/kind"; echo fl-gone > "$FIX/lane/i9/stale/unit"
out=$("$LU" --check deploy "$FIX/lane" 2>&1); rc=$?
check "a live dir whose unit is gone with no exit file (a reboot) doesn't block --check deploy" '[ "$rc" = 0 ] && [ -z "$out" ]' "rc $rc: $out"
rc=$(launch --kind deploy fl-after-reboot i1/deploy -- /bin/true)
check "nor a deploy launch" '[ "$rc" = 0 ]' "rc $rc: $(cat "$FIX/launch.out")"
out=$("$LU" --check build "$FIX/lane" 2>&1); rc=$?
check "an unknown kind is a usage error (exit 2)" '[ "$rc" = 2 ]' "rc $rc: $out"

# --- the disk floor ----------------------------------------------------------------------------
new_fix
echo $((40 * 1048576)) > "$FIX/free-kb"
rc=$(launch fl-low i1/low -- /bin/true)
check "below the 45 GiB default floor a launch refuses (exit 3) and starts nothing" \
  '[ "$rc" = 3 ] && grep -q "disk floor" "$FIX/launch.out" && [ ! -s "$FIX/runs" ] && [ ! -s "$FIX/lane/waits" ]' "rc $rc: $(cat "$FIX/launch.out")"
out=$( (cd "$FIX/lane" && env FASTLANE_CWD="$FIX/lane" FASTLANE_MIN_FREE_GB=30 "$LU" fl-low i1/low3 -- /bin/true) 2>&1); rc=$?
check "a lane's lower floor (FASTLANE_MIN_FREE_GB=30) lets the same launch start" '[ "$rc" = 0 ]' "rc $rc: $out"

# --- panel seats and grok availability ---------------------------------------------------------
new_fix
echo good > "$FIX/probe-mode"; echo brief > "$FIX/lane/brief.md"
"$HERE/review.sh" "$FIX/lane" "$FIX/lane/brief.md" "$FIX/lane/review" panel > "$FIX/review.out" 2>&1; rc=$?
check "default panel launches opus, astra, sol, and available grok" \
  '[ "$rc" = 0 ] && [ "$(wc -l < "$FIX/runs")" = 5 ] && [ -f "$FIX/lane/review/opus/unit" ] && [ -f "$FIX/lane/review/astra/unit" ] && [ -f "$FIX/lane/review/sol/unit" ] && [ -f "$FIX/lane/review/grok/unit" ] && [ ! -d "$FIX/lane/review/fable" ]' "rc $rc: $(cat "$FIX/review.out")"
check "grok probe and reviewer use 8G, no swap, null stdin and the standing command" \
  '[ "$(grep -c -- "MemoryMax=8G.*MemorySwapMax=0.*StandardInput=null.*--no-auto-update -p .*--model grok-4.7 --effort high --output-format plain --always-approve --sandbox off --no-subagents --no-memory --disable-web-search --disallowed-tools search_replace,write" "$FIX/runs")" = 2 ]' "$(cat "$FIX/runs")"
check "both grok calls allow only read-only repository tools" \
  '[ "$(grep -c -- "--tools read_file,grep,list_dir" "$FIX/runs")" = 2 ]' "$(cat "$FIX/runs")"
check "both grok calls remove MCP discovery and invocation tools" \
  '[ "$(grep -c -- "--disallowed-tools search_replace,write,search_tool,use_tool" "$FIX/runs")" = 2 ]' "$(cat "$FIX/runs")"
check "probe wait removes only its line; required reviewers stay recorded" \
  '! grep -q "grok-probe" "$FIX/lane/waits" && [ "$(wc -l < "$FIX/lane/waits")" = 4 ]' "$(cat "$FIX/lane/waits")"
check "reader prompt names grok config in the no-read list" \
  'grep -q "~/.grok" "$FIX/runs"' "$(cat "$FIX/runs")"
for mode in failed empty; do
  new_fix
  echo "$mode" > "$FIX/probe-mode"; echo brief > "$FIX/lane/brief.md"
  "$HERE/review.sh" "$FIX/lane" "$FIX/lane/brief.md" "$FIX/lane/review" panel > "$FIX/review.out" 2>&1; rc=$?
  check "$mode grok probe is reported missing and leaves no reader to wait on" \
    '[ "$rc" = 0 ] && [ -s "$FIX/lane/review/grok-missing" ] && [ ! -d "$FIX/lane/review/grok" ] && [ "$(wc -l < "$FIX/lane/waits")" = 3 ]' "rc $rc: $(cat "$FIX/review.out")"
done

# --- decision-panel integration with the shared seats and waits --------------------------------
new_fix
echo post-submit-error > "$FIX/probe-mode"
mkdir "$FIX/question"
printf 'Which should we ship? A (today) or B (tomorrow)?\n' > "$FIX/question/question.md"
printf 'A\nB\n' > "$FIX/question/options"
echo 'Consider the cost to operations.' > "$FIX/question/opus.lens.md"
OUT="$FIX/lane/decision"
env FASTLANE_OPUS_MODEL=claude-fable-5-2 FASTLANE_FABLE_MODEL=claude-opus-5-5 \
  FASTLANE_ASTRA_MODEL=override-astra FASTLANE_SOL_MODEL=override-sol \
  "$HERE/decision-panel.py" launch "$FIX/lane" "$FIX/question" "$OUT" decide --fable > "$FIX/decision.out" 2>&1; rc=$?
check "decision panel launches the shared seats including optional fable" \
  '[ "$rc" = 0 ] && [ "$(wc -l < "$FIX/runs")" = 6 ] && [ -f "$OUT/fable/unit" ] && [ -f "$OUT/launch-complete" ]' "rc $rc: $(cat "$FIX/decision.out")"
check "Grok seats after a probe answers even while unit status is unavailable" \
  '[ -f "$FIX/probe-query-failed" ] && [ -f "$OUT/grok/unit" ] && [ ! -f "$OUT/grok-missing" ] &&
   grep -qx -- GROK_OK "$OUT/grok-probe/answer.md"' "$(cat "$FIX/decision.out")"
check "only opus gets its lens and every reader gets the decision brief" \
  '[ "$(grep -c -- "decision brief $OUT/brief.md" "$FIX/runs")" = 5 ] && [ "$(grep -c -- "opus.lens.md" "$FIX/runs")" = 1 ] &&
   grep -q -- "fastlane-decide-opus.*opus.lens.md" "$FIX/runs" && cmp -s "$FIX/question/opus.lens.md" "$OUT/opus.lens.md"' "$(cat "$FIX/runs")"
check "decision readers can use read-only commands to read their brief and lens" \
  '[ "$(grep -c -- "Use commands only to read files" "$FIX/runs")" = 5 ]' "$(cat "$FIX/runs")"
check "shared launcher uses the worktree, null stdin and 5400 second seat timeout" \
  '[ "$(grep -c -- "--working-directory=$FIX/lane.*OOMPolicy=continue.*StandardInput=null.*5400" "$FIX/runs")" = 5 ]' "$(cat "$FIX/runs")"
check "Claude seats use the short cache, no auto-compaction override and high effort" \
  '[ "$(grep -c -- "-u CLAUDE_CODE_AUTO_COMPACT_WINDOW CLAUDE_CODE_PROMPT_CACHE_TTL=5m.*--effort high" "$FIX/runs")" = 2 ] &&
   ! grep -q -- "--no-session-persistence" "$FIX/runs"' "$(cat "$FIX/runs")"
check "decision votes keep their prescribed Claude seat models despite lane overrides" \
  'grep -q -- "fastlane-decide-opus.*--model claude-opus-5-5" "$FIX/runs" &&
   grep -q -- "fastlane-decide-fable.*--model claude-fable-5-2" "$FIX/runs"' "$(cat "$FIX/runs")"
check "both Codex seats use the prescribed models and effort in read-only mode" \
  '[ "$(grep -Ec -- "--sandbox read-only -m gpt-6.2-(astra|sol) -c model_reasoning_effort=high" "$FIX/runs")" = 2 ]' "$(cat "$FIX/runs")"
"$HERE/decision-panel.py" collect 0 "$OUT" > "$FIX/collect.out" 2>&1; rc=$?
check "collect returns 124 while a required reader is active and writes no synthesis" \
  '[ "$rc" = 124 ] && [ ! -e "$OUT/synthesis.md" ]' "rc $rc: $(cat "$FIX/collect.out")"
for seat in opus astra sol grok; do
  printf 'PICK: A\nRANKING: A B\nCAN LIVE WITH: A\nARGUMENT: A is ready.\n' > "$OUT/$seat/answer.md"
  echo 'success exited 0' > "$OUT/$seat/exit"
done
"$HERE/decision-panel.py" collect 0 "$OUT" > "$FIX/collect.out" 2>&1; rc=$?
check "collect succeeds without waiting on active fable" \
  '[ "$rc" = 0 ] && [ -f "$FIX/active/fastlane-decide-fable" ] && grep -qx "Counts (4 answering): A=4 B=0" "$FIX/collect.out"' \
  "rc $rc: $(cat "$FIX/collect.out")"

# --- combined packet integration with the real shared launcher and wait ------------------------
new_fix
mkdir -p "$FIX/packet" "$FIX/wt"
: > "$FIX/packet/waits"; echo task > "$FIX/packet/task.md"
git -C "$FIX/wt" init -q
git -C "$FIX/wt" -c user.name=t -c user.email=t@t commit -q --allow-empty -m base
printf '{"name":"packet","worktree":"%s"}\n' "$FIX/wt" > "$FIX/packet/config.json"
env FASTLANE_MANAGER=coordinator "$HERE/../../cfastlane/scripts/session.sh" "$FIX/packet" > "$FIX/session.out" 2>&1; rc=$?
check "a combined session finds its packet wait record and is kind other" \
  '[ "$rc" = 0 ] && grep -q "^coordinator | cfl-packet-s1 | $FIX/packet/turns/1/session/exit |" "$FIX/packet/waits" && [ "$(cat "$FIX/packet/turns/1/session/kind")" = other ]' "rc $rc: $(cat "$FIX/session.out")"
echo 'success exited 0' > "$FIX/packet/turns/1/session/exit"
"$WS" 0 "$FIX/packet/turns/1/session" > "$FIX/wait.out" 2>&1; rc=$?
check "wait.sh consumes a combined session exit and clears its packet record" \
  '[ "$rc" = 0 ] && [ ! -s "$FIX/packet/waits" ]' "rc $rc: $(cat "$FIX/wait.out")"
"$LU" --kind live packet-live "$FIX/packet/live" -- /bin/true > "$FIX/launch.out" 2>&1
"$LU" --kind deploy packet-deploy "$FIX/packet/deploy" -- /bin/true > "$FIX/launch.out" 2>&1; rc=$?
check "packet-root live unit blocks deployment through the same busy check" \
  '[ "$rc" = 3 ] && grep -q "live unit packet-live is active" "$FIX/launch.out"' "rc $rc: $(cat "$FIX/launch.out")"

# --- the implementer prompt ---------------------------------------------------------------------
new_fix
echo task > "$FIX/lane/i1/task.md"
(cd "$FIX/lane" && "$HERE/implement.sh" "$FIX/lane" i1/task.md i1/impl fl-i1-impl) > "$FIX/launch.out" 2>&1; rc=$?
check "the implementer leaves work undone only for a named obstacle, never for remaining work" \
  '[ "$rc" = 0 ] && grep -q "Leave something undone only for a named obstacle.*Work that merely remains is not an obstacle.*if anything is undone, it names the obstacle" "$FIX/runs"' "rc $rc: $(cat "$FIX/launch.out")"
check "the implementer runs named checks in full while other tests are suspended" \
  'grep -q "Run every check the task names as required, in full, including its tests. That is never a reason to stop. Other tests are suspended" "$FIX/runs" &&
   grep -q "For standalone builds, compile only what the task says gets deployed" "$FIX/runs"' "rc $rc: $(cat "$FIX/launch.out")"
CODEX_RUN=$(sed -n 1p "$FIX/runs")
check "by default the implementer is codex sol at effort high" \
  '[[ "$CODEX_RUN" == *"codex exec --dangerously-bypass-approvals-and-sandbox -m gpt-6.2-sol -c model_reasoning_effort=high"* && "$CODEX_RUN" != *"claude -p"* ]]' "$CODEX_RUN"
for engine in claude-opus CLAUDE codex2; do
  runs_before=$(wc -l < "$FIX/runs")
  (cd "$FIX/lane" && env FASTLANE_IMPL_ENGINE=$engine "$HERE/implement.sh" "$FIX/lane" i1/task.md "i1/impl-$engine" "fl-i1-$engine") > "$FIX/launch.out" 2>&1; rc=$?
  check "an unknown implementer engine ($engine) is refused and starts nothing" \
    '[ "$rc" = 2 ] && grep -q "FASTLANE_IMPL_ENGINE must be codex or claude" "$FIX/launch.out" && [ "$(wc -l < "$FIX/runs")" = "$runs_before" ] && [ ! -e "$FIX/lane/i1/impl-$engine" ]' "rc $rc: $(cat "$FIX/launch.out")"
done
(cd "$FIX/lane" && env FASTLANE_IMPL_ENGINE=claude FASTLANE_TESTS=on "$HERE/implement.sh" "$FIX/lane" i1/task.md i1/impl-claude fl-i1-claude 900) > "$FIX/launch.out" 2>&1; rc=$?
CLAUDE_RUN=$(tail -n 1 "$FIX/runs")
check "FASTLANE_IMPL_ENGINE=claude runs Opus at effort high in the same capped unit" \
  '[ "$rc" = 0 ] && [[ "$CLAUDE_RUN" == *"--unit=fl-i1-claude "*"--working-directory=$FIX/lane "*"MemoryMax=16G -p MemorySwapMax=0 -p OOMPolicy=continue -p StandardInput=null -p StandardOutput=file:$FIX/lane/i1/impl-claude/answer.md -p StandardError=file:$FIX/lane/i1/impl-claude/err"* ]] &&
   [[ "$CLAUDE_RUN" == *" -u CLAUDE_CODE_AUTO_COMPACT_WINDOW BASH_MAX_TIMEOUT_MS=3600000 "*"timeout 900 "*"claude -p Read the task file $FIX/lane/i1/task.md"*" --model claude-opus-5-5 --effort high --dangerously-skip-permissions --strict-mcp-config --mcp-config"* ]]' "rc $rc: $CLAUDE_RUN"
check "the Claude implementer keeps its transcript and the long-session cache" \
  '[[ "$CLAUDE_RUN" != *"--no-session-persistence"* && "$CLAUDE_RUN" != *"CLAUDE_CODE_PROMPT_CACHE_TTL"* && "$CLAUDE_RUN" != *"codex"* ]]' "$CLAUDE_RUN"
check "the Claude implementer gets the same prompt, tests-back line included" \
  '[[ "$CLAUDE_RUN" == *"Tests are back: run, fix, edit or add tests only as the task file says."*"Leave something undone only for a named obstacle"* ]]' "$CLAUDE_RUN"
check "the Claude implementer is told to follow the project's AGENTS.md, which codex reads itself" \
  '[[ "$CLAUDE_RUN" == *"Read and follow every AGENTS.md from the repository root down to $FIX/lane."* && "$CODEX_RUN" != *"AGENTS.md"* ]]' "$CLAUDE_RUN"
check "the manager brief uses the lane caps and the Opus fallback uses its wait procedure" \
  'grep -Fq "For fastlane and cfastlane, use" "$HERE/../../delegate-to-manager/references/manager-brief-template.md" &&
   grep -Fq "section 7 for Sol resumes and section 2 for Opus relays" "$HERE/../SKILL.md" &&
   grep -Fq "#4-watching-long-jobs" "$HERE/../SKILL.md"' ""
check "the manager brief and relay preserve fastlane batching" \
  'grep -Fq "In fastlane, batch the calls" "$HERE/../../delegate-to-manager/references/manager-brief-template.md" &&
   grep -Fq "In fastlane, relay the manager" "$HERE/../../delegate-to-manager/SKILL.md"' ""

echo "passed $PASS, failed $FAIL"
[[ "$FAIL" == 0 ]]

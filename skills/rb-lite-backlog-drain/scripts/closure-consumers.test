 {"id":"g1","status":"open","priority":1,"issue_type":"task","labels":["team-a"]},
 {"id":"g2","status":"in_progress","priority":0,"issue_type":"bug","labels":[]},
 {"id":"g3","status":"open","priority":2,"issue_type":"task","labels":["team-a"]},

if [[ -n "$row_mutants" ]]; then fail "$t" "$row_mutants"; else pass "$t"; fi

# --- drive-status delegation --------------------------------------------------------------------
run_drive_status() {  # $1 base, rest: argv
  local base=$1 path=${DS_PATH:-$SYSTEM_PATH}; shift
  ( cd "$base/clone" && HOME="$base/home" PATH="$path" \
      "$base/home/.claude/skills/drive/scripts/drive-status" "$@" ) \
    >"$base/ds.out" 2>"$base/ds.err"
}

b=$(new_fixture)
O=$(oid_of "$b" "$b/tool/br")
run_drive_status "$b" --select-bead-lanes-json --scope-label drive-open-issues \
  --br-path "$b/tool/br" --br-oid "$O"; rc=$?
expected=${EXPECTED_SCOPED/@OID@/$(oid_of "$b" "$b/clone/.beads/issues.jsonl")}
t='drive-status delegates its lane mode to the shared owner byte for byte'
exact_result "$t" "$rc" "$b/ds.out" "$b/ds.err" "$expected"

t='a relative invocation resolves the companion beside the script, not beside the repo'
# `cd "$ROOT"` happens before the companion lookup, so a relative `BASH_SOURCE[0]` used
# afterwards is measured from the DRIVEN REPOSITORY. That resolves one directory further
# up than the install actually launched, lands outside the worktree, and therefore sails
# through the containment check — while running whatever is planted there.
b=$(new_fixture)
inst="$b/relinst/skills"
mkdir -p "$inst/drive/scripts" "$inst/rb-lite-backlog-drain/scripts" "$b/clone/sub"
cp "$SKILLS/drive/scripts/drive-status" "$inst/drive/scripts/drive-status"
cp "$SELECTOR" "$inst/rb-lite-backlog-drain/scripts/select-bead-lanes"
chmod +x "$inst/drive/scripts/drive-status" "$inst/rb-lite-backlog-drain/scripts/select-bead-lanes"
decoy="$WORK/relinst/skills/rb-lite-backlog-drain/scripts"
# `cd -P` walks every component, so the decoy tree mirrors the install's shape.
mkdir -p "$decoy" "$WORK/relinst/skills/drive/scripts"
printf '#!/bin/sh\n: >"%s/decoy-ran"\nprintf %%s "DECOY\\n"\n' "$b" >"$decoy/select-bead-lanes"
chmod +x "$decoy/select-bead-lanes"
O=$(oid_of "$b" "$b/tool/br")
( cd "$b/clone/sub" && HOME="$b/home" PATH="$SYSTEM_PATH" \
    ../../relinst/skills/drive/scripts/drive-status --select-bead-lanes-json \
    --scope-label drive-open-issues --br-path "$b/tool/br" --br-oid "$O" ) \
  >"$b/ds.out" 2>"$b/ds.err"
rc=$?
if [[ -e "$b/decoy-ran" ]]; then
  fail "$t" 'a selector from outside the install tree was executed'
else
  exact_result "$t" "$rc" "$b/ds.out" "$b/ds.err" \
    "${EXPECTED_SCOPED/@OID@/$(oid_of "$b" "$b/clone/.beads/issues.jsonl")}"
fi
rm -rf "$WORK/relinst"

t='an inherited git function cannot move lane mode to another repository'
# Bash imports exported functions, so `command -p -v git` returns the bare name and the
# caller's code answers "which worktree is this" — the question the DRIVE.md scope check
# and the companion containment check are both measured against.
b=$(new_fixture)
git init -q "$b/decoyrepo"
printf '# DRIVE\n\n**Scope-Label:** `drive-open-issues`\n' >"$b/decoyrepo/DRIVE.md"
O=$(oid_of "$b" "$b/tool/br")
hostile="git() { : >'$b/hijack-ran'; printf '%s\\n' '$b/decoyrepo'; }; export -f git"
( cd "$b/clone" && HOME="$b/home" PATH="$SYSTEM_PATH" bash -c "$hostile"'
exec "$1" --select-bead-lanes-json --scope-label drive-open-issues \
  --br-path "$2" --br-oid "$3"' _ \
    "$b/home/.claude/skills/drive/scripts/drive-status" "$b/tool/br" "$O" ) \
  >"$b/ds.out" 2>"$b/ds.err"
rc=$?
if [[ -e "$b/hijack-ran" ]]; then
  fail "$t" 'the inherited git function answered for the worktree'
else
  exact_result "$t" "$rc" "$b/ds.out" "$b/ds.err" \
    "${EXPECTED_SCOPED/@OID@/$(oid_of "$b" "$b/clone/.beads/issues.jsonl")}"
fi

t='drive-status clears inherited Git location overrides before choosing its worktree'
b=$(new_fixture)
git init -q "$b/other"
git -C "$b/other" config user.name 'Consumer Test'
git -C "$b/other" config user.email consumer@example.invalid
printf '# DRIVE\n\n**Scope-Label:** `drive-open-issues`\n' >"$b/other/DRIVE.md"
git -C "$b/other" add -A && git -C "$b/other" commit -qm seed
O=$(oid_of "$b" "$b/tool/br")
if ! ( cd "$b/clone" && HOME="$b/home" PATH="$SYSTEM_PATH" \
    GIT_DIR="$b/other/.git" GIT_WORK_TREE="$b/other" \
    "$b/home/.claude/skills/drive/scripts/drive-status" \
    --select-bead-lanes-json --scope-label drive-open-issues \
    --br-path "$b/tool/br" --br-oid "$O" ) >"$b/ds.out" 2>"$b/ds.err"; then
  fail "$t" "location overrides redirected lane mode: $(<"$b/ds.err")"
elif [[ "$(<"$b/ds.out")" != "${EXPECTED_SCOPED/@OID@/$(oid_of "$b" "$b/clone/.beads/issues.jsonl")}" ]]; then
  fail "$t" 'location overrides selected a different repository'
elif [[ -s "$b/ds.err" ]]; then
  fail "$t" "valid selection wrote stderr: $(<"$b/ds.err")"
else
  pass "$t"
fi

scope_failures=""
while IFS='|' read -r label record request diagnostic; do
  b=$(new_fixture)
  if [[ "$record" == "ABSENT" ]]; then
    rm -f "$b/clone/DRIVE.md"
  else
    # %b, not %s: the duplicate row carries a `\n` that has to become a second line, and
    # %s would leave it as a literal backslash-n that the count check never sees.
    printf '# DRIVE\n\n%b\n**Phase:** BUILD\n' "$record" >"$b/clone/DRIVE.md"
  fi
  git -C "$b/clone" add -A >/dev/null 2>&1
  git -C "$b/clone" commit -qam scope >/dev/null 2>&1
  O=$(oid_of "$b" "$b/tool/br")
  out="$b/ds.out"; err="$b/ds.err"
  if [[ "$label" == 'a missing DRIVE.md' ]]; then
    out="$b/out"; err="$b/err"
    run_selector "$b" && accepted=true || accepted=false
  else
    if [[ "$label" == 'a malformed Scope-Label' ]]; then
      mkdir -p "$b/hostile"
      printf '#!/bin/sh\ncase "$*" in *-cE*) printf "1\\n";; *) printf "**Scope-Label:** `drive-open-issues`\\n";; esac\n' >"$b/hostile/grep"
      printf '#!/bin/sh\nprintf "drive-open-issues\\n"\n' >"$b/hostile/sed"
      chmod +x "$b/hostile/grep" "$b/hostile/sed"
      DS_PATH="$b/hostile:$SYSTEM_PATH"
    else
      DS_PATH=$SYSTEM_PATH
    fi
    DS_PATH="$DS_PATH" run_drive_status "$b" --select-bead-lanes-json \
      --scope-label "$request" --br-path "$b/tool/br" --br-oid "$O" \
      && accepted=true || accepted=false
  fi
  if $accepted; then
    scope_failures+="$label was accepted; "
  elif [[ -s "$out" ]]; then
    scope_failures+="$label printed a selection while refusing; "
  elif ! grep -Fxq -- "$diagnostic" "$err"; then
    scope_failures+="$label produced the wrong diagnostic: $(<"$err"); "
  elif [[ $(sel_calls "$b" | wc -l) -ne 0 ]]; then
    scope_failures+="$label still executed the pinned binary; "
  fi
done <<'SCOPES'
a missing DRIVE.md|ABSENT|drive-open-issues|DRIVE.md is absent, so no Scope-Label is declared — scoped selection refused
a DRIVE.md with no Scope-Label|**Scope:** everything|drive-open-issues|DRIVE.md must declare exactly one **Scope-Label:** line
a duplicated Scope-Label|**Scope-Label:** `drive-open-issues`\n**Scope-Label:** `drive-open-issues`|drive-open-issues|DRIVE.md must declare exactly one **Scope-Label:** line
a malformed Scope-Label|**Scope-Label:** drive-open-issues|drive-open-issues|the DRIVE.md **Scope-Label:** line is malformed
a Scope-Label with no value|**Scope-Label:**|drive-open-issues|the DRIVE.md **Scope-Label:** line is malformed
a requested label the record does not declare|**Scope-Label:** `other-scope`|drive-open-issues|the requested scope label is not the one DRIVE.md declares
SCOPES
t='direct and delegated scope labels refuse absent, duplicate, malformed, forged, or disagreeing records'
if [[ -n "$scope_failures" ]]; then fail "$t" "$scope_failures"; else pass "$t"; fi

t='the scope label is never inferred from the rows it selects'
b=$(new_fixture)
printf '# DRIVE\n\n**Scope:** everything\n**Phase:** BUILD\n' >"$b/clone/DRIVE.md"
git -C "$b/clone" commit -qam no-label >/dev/null 2>&1
O=$(oid_of "$b" "$b/tool/br")
if run_drive_status "$b" --select-bead-lanes-json --scope-label drive-open-issues \
    --br-path "$b/tool/br" --br-oid "$O"; then
  fail "$t" 'rows carrying drive-open-issues were enough to enable scoped routing'
elif [[ -s "$b/ds.out" ]]; then
  fail "$t" 'a refused selection still printed'
else
  pass "$t"
fi

argv_failures=""
b=$(new_fixture)
O=$(oid_of "$b" "$b/tool/br")
while IFS= read -r argv; do
  # shellcheck disable=SC2086
  if run_drive_status "$b" $argv; then
    argv_failures+="[$argv] was accepted; "
  elif [[ -s "$b/ds.out" ]]; then
    argv_failures+="[$argv] printed a selection; "
  elif ! grep -Fq 'usage: drive-status --select-bead-lanes-json' "$b/ds.err"; then
    argv_failures+="[$argv] did not print the delegating usage text; "
  fi
done <<ARGV
--select-bead-lanes-json
--select-bead-lanes-json --scope-label drive-open-issues --br-path $b/tool/br
--select-bead-lanes-json --br-path $b/tool/br --scope-label drive-open-issues --br-oid $O
--select-bead-lanes-json --scope-label drive-open-issues --br-path $b/tool/br --br-oid $O --br-oid $O
--select-bead-lanes-json --scope-label drive-open-issues --br-path $b/tool/br --oid $O
--select-bead-lanez-json --scope-label drive-open-issues --br-path $b/tool/br --br-oid $O
ARGV
t='the delegating drive-status grammar is exact'
if [[ -n "$argv_failures" ]]; then fail "$t" "$argv_failures"; else pass "$t"; fi

t='lane mode fails closed when the helper is not installed outside the worktree'
b=$(new_fixture)
rm -rf "$b/home/.claude/skills/rb-lite-backlog-drain"
mkdir -p "$b/clone/skills/rb-lite-backlog-drain/scripts"
cp "$SELECTOR" "$b/clone/skills/rb-lite-backlog-drain/scripts/select-bead-lanes"
chmod +x "$b/clone/skills/rb-lite-backlog-drain/scripts/select-bead-lanes"
O=$(oid_of "$b" "$b/tool/br")
if run_drive_status "$b" --select-bead-lanes-json --scope-label drive-open-issues \
    --br-path "$b/tool/br" --br-oid "$O"; then
  fail "$t" 'a repository-relative helper was executed'
elif [[ -s "$b/ds.out" ]]; then
  fail "$t" 'a refused selection still printed'
elif ! grep -Fq 'select-bead-lanes companion unavailable' "$b/ds.err"; then
  fail "$t" "unexpected diagnostic: $(<"$b/ds.err")"
else
  pass "$t"
fi

t='drive-status refuses hard links and uses the selector beside the active Drive copy'
admission_failures=""
b=$(new_fixture)
mkdir -p "$b/clone/attacker"
ln "$b/home/.claude/skills/rb-lite-backlog-drain/scripts/select-bead-lanes" \
  "$b/clone/attacker/select-bead-lanes"
O=$(oid_of "$b" "$b/tool/br")
if run_drive_status "$b" --select-bead-lanes-json --scope-label drive-open-issues \
    --br-path "$b/tool/br" --br-oid "$O"; then
  admission_failures+="a hard-linked helper was accepted; "
elif [[ -s "$b/ds.out" || $(sel_calls "$b" | wc -l) -ne 0 ]]; then
  admission_failures+="a hard-linked helper executed or printed a selection; "
fi
b=$(new_fixture)
mkdir -p "$b/home/.codex/skills/rb-lite-backlog-drain/scripts"
printf '#!/bin/sh\n: >%s/stale-ran\nexit 1\n' "$b" \
  >"$b/home/.codex/skills/rb-lite-backlog-drain/scripts/select-bead-lanes"
chmod +x "$b/home/.codex/skills/rb-lite-backlog-drain/scripts/select-bead-lanes"
O=$(oid_of "$b" "$b/tool/br")
if ! run_drive_status "$b" --select-bead-lanes-json --scope-label drive-open-issues \
    --br-path "$b/tool/br" --br-oid "$O"; then
  admission_failures+="the active Drive copy did not use its adjacent selector; "
elif [[ -e "$b/stale-ran" ]]; then
  admission_failures+="a selector from another installation shadowed the active copy; "
fi
if [[ -n "$admission_failures" ]]; then fail "$t" "$admission_failures"; else pass "$t"; fi

printf '\n%d passed, %d failed\n' "$PASS" "$FAIL"
[[ $FAIL -eq 0 ]]

done <<'GENERIC'
an open row carrying the scope label|[r.update(labels=["drive-open-issues"]) for r in g if r["id"]=="g1"]
an open row carrying the skills lane|[r.update(labels=["executor-skills"]) for r in g if r["id"]=="g1"]
an open row carrying the rb-lite lane|[r.update(labels=["executor-rb-lite"]) for r in g if r["id"]=="g3"]
an in-progress row carrying the authority lane|[r.update(labels=["authority-human"]) for r in g if r["id"]=="g2"]
GENERIC
t='any recognized Drive label in unresolved generic work refuses with the fixed diagnostic'
if [[ -n "$row_mutants" ]]; then fail "$t" "$row_mutants"; else pass "$t"; fi

row_mutants=""

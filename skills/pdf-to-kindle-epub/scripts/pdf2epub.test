#!/usr/bin/env python3
"""pdf2epub.test — fixture tests for the layout decisions.

Every case here is a defect that shipped to a reader during development, where
the failure is silent: the EPUB builds, opens, and looks plausible, and the
damage only shows up while actually reading. Nothing else in the pipeline
objects, so these assertions are the objection.

The fixture is a synthetic `pdftohtml -xml` document, so the suite needs no
poppler, no calibre and no PDF — it tests the decisions, which is where the
bugs were. The extraction and the calibre call around them are thin.

Usage: ./pdf2epub.test        (exits 0 if all pass)
"""
import contextlib
import html
import io
import os
import re
import sys
import tempfile

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
sys.dont_write_bytecode = True
import pdf2epub as P  # noqa: E402

PASS = FAIL = 0


def check(name, cond, detail=''):
    global PASS, FAIL
    if cond:
        PASS += 1
        print(f'  ok   {name}')
    else:
        FAIL += 1
        print(f'  FAIL {name}' + (f'\n       {detail}' if detail else ''))


def text(el):
    """Tag-stripped text. Note: strips with '' so a broken join stays visible."""
    return re.sub(r'<[^>]+>', '', el)


# --------------------------------------------------------------------- fixture
# left=50 width=500 puts the right margin at 550; a line ending short of that
# closes a paragraph, which is how justified text signals one.
FIXTURE = '''<?xml version="1.0" encoding="UTF-8"?>
<pdf2xml producer="poppler" version="test">
<page number="1" position="absolute" top="0" left="0" height="1000" width="600">
<fontspec id="0" size="15" family="ABCDEF+Serif" color="#000000"/>
<fontspec id="1" size="13" family="ABCDEF+Serif" color="#000000"/>
<text top="100" left="50" width="500" height="17" font="0">The quick brown fox jumps over the lazy</text>
<text top="122" left="50" width="500" height="17" font="0">dog and keeps run­</text>
<text top="144" left="50" width="500" height="17" font="0">ning onward to show that a soft hyphen joins</text>
<text top="166" left="50" width="200" height="17" font="0">correctly here.</text>
<text top="188" left="70" width="480" height="17" font="0">An indented line starts a paragraph, and produc­</text>
<text top="210" left="50" width="500" height="17" font="0">tive work differs from self-</text>
<text top="232" left="50" width="300" height="17" font="0">interest, which keeps its hyphen.</text>
<text top="254" left="50" width="300" height="17" font="0">Evidence of self-interest appears here.</text>
</page>
<page number="2" position="absolute" top="0" left="0" height="1000" width="600">
<fontspec id="2" size="138" family="ABCDEF+Display" color="#000000"/>
<fontspec id="3" size="24" family="ABCDEF+Display" color="#000000"/>
<fontspec id="4" size="40" family="ABCDEF+Serif" color="#000000"/>
<text top="60" left="140" width="60" height="100" font="2">II</text>
<text top="100" left="50" width="80" height="17" font="0">CAPÍTULO</text>
<text top="200" left="50" width="400" height="28" font="3">THE SECOND CHAPTER</text>
<text top="300" left="50" width="30" height="44" font="4">T</text>
<text top="320" left="82" width="460" height="17" font="0">his line opens with a drop cap and then continues as ordinary prose for a good while</text>
<text top="342" left="50" width="240" height="17" font="0">until it ends.</text>
</page>
<page number="3" position="absolute" top="0" left="0" height="1000" width="600">
<text top="100" left="50" width="500" height="17" font="0">A paragraph whose sentence carries on across</text>
<text top="180" left="50" width="400" height="15" font="1">12. A footnote starts at the body margin.</text>
<text top="220" left="50" width="300" height="17" font="0">the footnote that interrupts it.</text>
</page>
<page number="4" position="absolute" top="0" left="0" height="1000" width="600">
<text top="100" left="50" width="300" height="17" font="0">He put it this way:</text>
<text top="140" left="100" width="400" height="15" font="1">An inset quotation sits well in from the body margin.</text>
<text top="200" left="50" width="300" height="17" font="0">That was his claim.</text>
</page>
<page number="5" position="absolute" top="0" left="0" height="1000" width="600">
<text top="100" left="50" width="300" height="17" font="0">The study found two things:</text>
<text top="122" left="80" width="10" height="17" font="0">• </text>
<text top="122" left="100" width="450" height="17" font="0">genes explain only a small share of the</text>
<text top="144" left="98" width="452" height="17" font="0">cases, while life events explain most;</text>
<text top="166" left="98" width="200" height="17" font="0">so says the data;</text>
<text top="188" left="80" width="10" height="17" font="0">• </text>
<text top="188" left="100" width="450" height="17" font="0">pills are the usual treatment, though talk</text>
<text top="210" left="98" width="200" height="17" font="0">therapy works as well.</text>
<text top="232" left="50" width="480" height="17" font="0">Then <i>it took a long time to de­</i></text>
<text top="254" left="50" width="200" height="17" font="0"><i>cay</i> and that was all.</text>
</page>
<page number="6" position="absolute" top="0" left="0" height="1000" width="600">
<text top="100" left="50" width="500" height="17" font="0">Ana: You never do anything for yourself between the</text>
<text top="122" left="100" width="200" height="17" font="0">sessions at all.</text>
<text top="144" left="70" width="480" height="17" font="0">A one-line paragraph that runs to the margin.</text>
<text top="166" left="70" width="300" height="17" font="0">The next one is indented too.</text>
<text top="188" left="50" width="200" height="17" font="0">a. first item</text>
<text top="210" left="50" width="200" height="17" font="0">b. second item</text>
</page>
</pdf2xml>
'''

# Line starts that wander a few px off the margin, as some PDFs set them.
JITTER = '''<?xml version="1.0" encoding="UTF-8"?>
<pdf2xml producer="poppler" version="test">
<page number="1" position="absolute" top="0" left="0" height="1000" width="600">
<fontspec id="0" size="15" family="ABCDEF+Serif" color="#000000"/>
<text top="100" left="50" width="500" height="17" font="0">Lines in some PDFs start a few pixels off the</text>
<text top="122" left="61" width="489" height="17" font="0">margin, and that jitter is not an indent, so it</text>
<text top="144" left="52" width="498" height="17" font="0">all stays one paragraph until the line that</text>
<text top="166" left="63" width="487" height="17" font="0">really ends it.</text>
<text top="188" left="75" width="475" height="17" font="0">A real indent still opens the next one.</text>
</page>
</pdf2xml>
'''


class Opt:
    head_delta = 2
    quote_indent = 40
    table_gap = 40
    table_sizes = None
    code = True
    indent = 6
    short = 18


def build(fixture=FIXTURE, opt=Opt()):
    with tempfile.TemporaryDirectory() as d:
        path = os.path.join(d, 'book.xml')
        with open(path, 'w', encoding='utf8') as fh:
            fh.write(fixture)
        pages, body = P.parse(path)
    P.strip_furniture(pages, body)
    P.classify(pages, body, opt)
    for p in pages:
        p['tables'] = []
    # pdftotext's vocabulary is deliberately misleading for compounds;
    # the XML fixture now supplies independent mid-line evidence instead.
    vocab = frozenset(['productive', 'work', 'self-interest', 'selfinterest', 'interest'])
    # as a real book maps them: parts to h1 (none here), chapters to h2
    doc, counts, blocks = P.build_html(pages, body, opt, set(), {138}, vocab)
    return pages, body, doc, counts, blocks


pages, body, doc, counts, blocks = build()
plain = text(doc)

print('body text and hyphenation')
check('body font size detected as 15', body == 15, f'got {body}')
check('soft hyphen joins across the line break',
      'running onward' in plain, 'expected "running onward"')
check('no space left where the soft hyphen was',
      'run ning' not in plain and 'run­' not in plain)
check('real hyphen dropped when the joined word is known',
      'productive work' in plain, 'expected "productive work"')
check('real hyphen kept for a genuine compound',
      'productive work differs from self-interest, which keeps its hyphen.' in plain,
      'expected the wrapped "self-interest" to survive')
check('lines of one paragraph join into a single <p>',
      '<p>The quick brown fox jumps over the lazy dog and keeps running onward'
      ' to show that a soft hyphen joins correctly here.</p>' in doc,
      'paragraph did not reassemble; got:\n       '
      + (re.findall(r'<p>[^<]*</p>', doc) or ['none'])[0][:140])
check('an indented line opens a new paragraph',
      doc.count('<p>') >= 2 and 'An indented line starts a paragraph' in doc)

print('\nheadings')
heads = re.findall(r'<h[123]>(.*?)</h[123]>', doc)
check('numeral sharing a line with its label is split at the run',
      any(h.startswith('CAPÍTULO II') for h in heads),
      f'got {heads}')
check('heading group absorbs the title line',
      any('CAPÍTULO II — THE SECOND CHAPTER' == h for h in heads), f'got {heads}')
check('opener becomes h2 because 138 was mapped there',
      '<h2>CAPÍTULO II — THE SECOND CHAPTER</h2>' in doc)
check('a drop cap does not turn a paragraph into a heading',
      not any('drop cap' in h for h in heads), f'got {heads}')
check('drop-cap line still reads as one paragraph',
      'This line opens with a drop cap' in plain
      or 'T his line opens with a drop cap' in plain,
      'drop cap line lost or split')

print('\nquotes, footnotes and ordering')
check('inset small type becomes a block quote at full size',
      '<blockquote>An inset quotation sits well in from the body margin.</blockquote>' in doc,
      'quote was not recognised; small type at the margin is a footnote, inset is a quote')
check('small type at the body margin stays a footnote',
      '<p class="fn">12. A footnote starts at the body margin.</p>' in doc)
check('a footnote does not split the sentence it interrupts',
      'carries on across the footnote that interrupts it.' in plain,
      'the interrupted paragraph did not rejoin')
check('the footnote is emitted after that paragraph, not inside it',
      plain.find('the footnote that interrupts it.')
      < plain.find('12. A footnote starts at the body margin.'),
      'footnote landed before the paragraph closed')

print('\nline clustering')
p2 = pages[1]
first = p2['lines'][0]
check('runs at different sizes cluster into one visual line',
      'CAPÍTULO' in P.txt_of(first['html']) and 'II' in P.txt_of(first['html']),
      f"got {P.txt_of(first['html'])!r} — clustering by top alone splits these")
check('that line is classified as a heading despite its modal size being body',
      first['kind'] == 'head',
      f"kind={first['kind']}, size={first['size']}, max={first['max']}")

print('\ntable detection')
check('wide column gaps are not claimed in ordinary prose',
      all(l['kind'] != 'table' for p in pages for l in p['lines']),
      'a prose line was mistaken for a table')

print('\nlists, italics and jitter')
check('a bulleted item wrapping at a hanging indent stays one paragraph',
      '<p>• genes explain only a small share of the cases, while life events'
      ' explain most; so says the data;</p>' in doc,
      'every wrapped line of the item became its own paragraph')
check('each bullet opens its own paragraph',
      '<p>• pills are the usual treatment, though talk therapy works as well.</p>' in doc)
check('a soft hyphen inside italics joins the word',
      'to decay</i> and that was all.' in doc and 'de cay' not in plain,
      'the hyphen sat before </i> and was missed: "de cay"')
check('a short line ending in a soft hyphen does not end the paragraph',
      '<p>Then <i>it took a long time to decay</i> and that was all.</p>' in doc)
check('a speaker line wrapping at a hanging indent stays one paragraph',
      '<p>Ana: You never do anything for yourself between the sessions at all.</p>' in doc,
      'geometry alone reads the hanging indent as a new paragraph')
check('a full one-line paragraph is not merged into the indented next one',
      '<p>A one-line paragraph that runs to the margin.</p>' in doc
      and '<p>The next one is indented too.</p>' in doc)
check('lettered list items are not merged by the lower-case rule',
      '<p>a. first item</p>' in doc and '<p>b. second item</p>' in doc)
check('no paragraph in the fixture is cut mid-sentence',
      P.midsentence_breaks(blocks) == [], f'got {P.midsentence_breaks(blocks)}')


class JitterOpt(Opt):
    indent = 18


_, _, jdoc, _, jblocks = build(JITTER, JitterOpt())
check('line starts that jitter under --indent stay in one paragraph',
      '<p>Lines in some PDFs start a few pixels off the margin, and that jitter is'
      ' not an indent, so it all stays one paragraph until the line that really'
      ' ends it.</p>' in jdoc, f'got {re.findall(r"<p>.*?</p>", jdoc)}')
check('a real indent past --indent still opens a paragraph',
      '<p>A real indent still opens the next one.</p>' in jdoc)
TABLE = '''<?xml version="1.0" encoding="UTF-8"?>
<pdf2xml producer="poppler" version="test">
<page number="1" position="absolute" top="0" left="0" height="1000" width="600">
<fontspec id="0" size="15" family="ABCDEF+Serif" color="#000000"/>
<fontspec id="1" size="13" family="ABCDEF+Serif" color="#000000"/>
<text top="60" left="50" width="500" height="17" font="0">Some prose comes before the table and runs right across the</text>
<text top="82" left="50" width="200" height="17" font="0">page to its end.</text>
<text top="120" left="50" width="100" height="15" font="1">lithium</text>
<text top="120" left="300" width="100" height="15" font="1">tremor</text>
<text top="140" left="50" width="100" height="15" font="1">(Depakene)</text>
<text top="160" left="50" width="100" height="15" font="1">caffeine</text>
<text top="160" left="300" width="100" height="15" font="1">lower level</text>
<text top="220" left="50" width="300" height="17" font="0">After the table, prose resumes.</text>
</page>
</pdf2xml>
'''
with tempfile.TemporaryDirectory() as w:
    path = os.path.join(w, 'book.xml')
    with open(path, 'w', encoding='utf8') as fh:
        fh.write(TABLE)
    tpages, tbody = P.parse(path)
    P.strip_furniture(tpages, tbody)
    P.classify(tpages, tbody, Opt())
    def render_crop(cmd, cwd):
        open(os.path.join(cwd, cmd[-1] + '-1.png'), 'wb').close()
    old_run = P.run
    try:
        P.run = render_crop
        P.crop_tables(tpages, w, 150)
    finally:
        P.run = old_run
    tdoc, _, _ = P.build_html(tpages, tbody, Opt(), set(), set(), frozenset())
check('a single-cell row inside a table goes into the picture, not the text',
      '(Depakene)' not in tdoc and tdoc.count('<img') == 1, tdoc)
check('prose around the table survives',
      'runs right across the page to its end.' in tdoc and 'After the table, prose resumes.' in tdoc)
# A paragraph turning onto a page whose most common line start is an inset
# block (so that page's margin is misjudged), then verse in body type.
TURN = '''<?xml version="1.0" encoding="UTF-8"?>
<pdf2xml producer="poppler" version="test">
<page number="1" position="absolute" top="0" left="0" height="1000" width="600">
<fontspec id="0" size="15" family="ABCDEF+Serif" color="#000000"/>
<text top="100" left="50" width="500" height="17" font="0">Prose that runs all the way down to the foot of the</text>
<text top="122" left="50" width="500" height="17" font="0">page, where it tells of a trip across the United</text>
</page>
<page number="2" position="absolute" top="0" left="0" height="1000" width="600">
<text top="100" left="50" width="300" height="17" font="0">States and Canada together.</text>
<text top="140" left="110" width="380" height="17" font="0">An inset block in body type sits well</text>
<text top="162" left="110" width="380" height="17" font="0">in from the margin and is set apart</text>
<text top="184" left="110" width="380" height="17" font="0">from the prose around it on all</text>
<text top="206" left="110" width="200" height="17" font="0">four sides.</text>
</page>
<page number="3" position="absolute" top="0" left="0" height="1000" width="600">
<text top="100" left="90" width="200" height="17" font="0">so much depends</text>
<text top="122" left="90" width="60" height="17" font="0">upon</text>
<text top="144" left="90" width="140" height="17" font="0">a red wheel</text>
<text top="166" left="90" width="90" height="17" font="0">barrow</text>
<text top="200" left="50" width="500" height="17" font="0">Prose after the poem runs the full width of the page and</text>
<text top="222" left="50" width="200" height="17" font="0">then ends.</text>
</page>
<page number="4" position="absolute" top="0" left="0" height="1000" width="600">
<text top="100" left="50" width="500" height="17" font="0">A full line of prose sets the right margin of this page, and</text>
<text top="122" left="50" width="200" height="17" font="0">then it ends.</text>
<text top="200" left="90" width="380" height="17" font="0">you do not have to walk on your knees</text>
<text top="222" left="90" width="390" height="17" font="0">for a hundred miles through the desert</text>
<text top="244" left="90" width="300" height="17" font="0">repenting, nothing more.</text>
</page>
</pdf2xml>
'''

# Ten-word lines broken before a capital: a cut runs_on cannot repair.
CUT = '''<?xml version="1.0" encoding="UTF-8"?>
<pdf2xml producer="poppler" version="test">
<page number="1" position="absolute" top="0" left="0" height="1000" width="600">
<fontspec id="0" size="15" family="ABCDEF+Serif" color="#000000"/>
<text top="100" left="50" width="500" height="17" font="0">In the spring of that year the whole family travelled to New</text>
<text top="122" left="50" width="500" height="17" font="0">York and then on to Boston, where they stayed with the cousins for</text>
<text top="144" left="50" width="200" height="17" font="0">a month.</text>
</page>
</pdf2xml>
'''
_, _, tdoc2, _, _ = build(TURN, Opt())
check('a paragraph turning onto a page with a misjudged margin stays whole',
      'across the United States and Canada together.</p>' in tdoc2,
      f'got {re.findall(r"<p>.*?</p>", tdoc2)[:3]}')
check('verse lines stay line by line despite lower-case starts',
      all(f'<p>{v}</p>' in tdoc2 for v in ('so much depends', 'upon', 'a red wheel', 'barrow')),
      f'got {re.findall(r"<p>.*?</p>", tdoc2)}')


check('long verse lines short of the body measure stay line by line',
      '<p>you do not have to walk on your knees</p>' in tdoc2
      and '<p>for a hundred miles through the desert</p>' in tdoc2,
      f'got {re.findall(r"<p>.*?</p>", tdoc2)[-3:]}')


class Ragged(Opt):
    ragged_prose = True


_, _, rdoc, _, _ = build(TURN, Ragged())
check('--ragged-prose rejoins long lines far from the margin',
      '<p>you do not have to walk on your knees for a hundred miles through the desert'
      ' repenting, nothing more.</p>' in rdoc, f'got {re.findall(r"<p>.*?</p>", rdoc)[-2:]}')
check('--ragged-prose still leaves short lines alone',
      all(f'<p>{v}</p>' in rdoc for v in ('so much depends', 'upon', 'a red wheel', 'barrow')))


class NoShort(Opt):
    short = 0


_, _, _, _, cblocks = build(CUT, Opt())
_, _, _, _, nblocks = build(CUT, NoShort())
check('the mid-sentence check is quiet on a correct paragraph',
      P.midsentence_breaks(cblocks) == [], f'got {P.midsentence_breaks(cblocks)}')
check('the mid-sentence check fires when --short 0 cuts every line',
      len(P.midsentence_breaks(nblocks)) >= 1,
      'the check could not see a break that runs_on does not repair')
_cut = 'a line of prose long enough to be a paragraph that was cut'
check('midsentence_breaks flags a paragraph cut in two',
      P.midsentence_breaks([('p', _cut), ('p', 'Right here.')]) == [(_cut, 'Right here.')])
check('midsentence_breaks ignores short captions and list items',
      P.midsentence_breaks([('p', 'QUADRO 5'), ('p', 'Registro diário'),
                            ('p', _cut), ('p', 'b. second item')]) == [])

print('\nP1 regressions')


def line(t, top=100, left=50, width=500, font=0, height=17):
    return (f'<text top="{top}" left="{left}" width="{width}" height="{height}" '
            f'font="{font}">{t}</text>')


FONTS = ('<fontspec id="0" size="15" family="Serif"/>'
         '<fontspec id="1" size="13" family="Serif"/>'
         '<fontspec id="2" size="39" family="Display"/>'
         '<fontspec id="3" size="24" family="Display"/>'
         '<fontspec id="4" size="14" family="Serif"/>')


def page(n, content):
    return (f'<page number="{n}" width="622" height="1000">'
            + FONTS + content + '</page>')


def fixture(*pgs):
    return '<pdf2xml>' + ''.join(pgs) + '</pdf2xml>'


BODY = line('Ordinary body text sets the size and margin for this book. ' * 4,
            top=400)


def headings(content):
    _, _, hdoc, _, _ = build(fixture(page(1, content + BODY)))
    return hdoc, re.findall(r'<h[123]>(.*?)</h[123]>', hdoc)


print('\noversized drop caps (PR #119 first-round P1)')
DROP_FONTS = ('<fontspec id="5" size="40" family="Serif"/>'
              '<fontspec id="6" size="12" family="Serif"/>'
              '<fontspec id="7" size="9" family="Serif"/>')
for covered in (2, 3):
    for variant in ('plain', 'small caps', 'small start', 'superscript 0', 'superscript 6'):
        first = 'hen the ship came in, the passengers knew what to expect and'
        second = 'the harbour master was still on duty beside the waiting vessel and'
        second_xml = line(second, top=322, left=89, width=461)
        if variant == 'small caps':
            second = 'the harbour master was still on DUTY beside the waiting vessel and'
            second_xml = (line('the harbour master was still on ', top=322, left=89, width=230)
                          + line('DUTY', top=323, left=319, width=40, font=6, height=14)
                          + line(' beside the waiting vessel and', top=322, left=359, width=191))
        elif variant == 'small start':
            second_xml = (line('the ', top=323, left=89, width=22, font=6, height=14)
                          + line(second[4:], top=322, left=111, width=439))
        elif variant.startswith('superscript'):
            raised = int(variant.split()[-1])
            second_xml = (line(second, top=322, left=89, width=445)
                          + line('12', top=322 - raised, left=534, width=16,
                                 font=7, height=14))
            second += '12'
        expected = ['W' + first, second]
        rest = line(first, top=300, left=89, width=461) + second_xml
        if covered == 3:
            third = 'the sailors watched the tide before the harbour gates opened and'
            rest += line(third, top=344, left=89, width=461)
            expected.append(third)
        last = 'everyone aboard could finally begin the journey home.'
        rest += line(last, top=300 + 22 * covered, width=500)
        expected.append(last)
        cap = line('W', top=298, width=40, font=5, height=44 if covered == 2 else 68)
        cp, _, cd, _, _ = build(fixture(page(1, DROP_FONTS + cap + rest)))
        without, _, _, _, _ = build(fixture(page(1, DROP_FONTS + rest)))
        label = f'P1 drop cap {covered}-line {variant}'
        got = [text(l['html']) for l in cp[0]['lines']]
        check(label + ' visual lines stay separate and ordered', got == expected, repr(got))
        check(label + ' remaining runs cluster as without the initial',
              cp[0]['lines'][1:] == without[0]['lines'][1:]
              and all(cp[0]['lines'][0][k] == without[0]['lines'][0][k]
                      for k in ('c', 'h', 'size', 'max', 'gap')),
              repr([(l['html'], l['c'], l['h']) for l in cp[0]['lines']]))
        check(label + ' opens an ordinary paragraph', '<p>When the ship' in cd, cd)
        check(label + ' output reads in order with spaces between lines',
              re.findall(r'<p>(.*?)</p>', cd) == [' '.join(expected)], cd)
        check(label + ' has no split word or glued lines',
              'W hen' not in text(cd) and 'andthe' not in text(cd), text(cd))

whole = (DROP_FONTS
         + line(' <b>A</b> ', top=298, width=40, font=5, height=44)
         + line('<i> man walked down to the harbour to see the ship come in and</i>',
                top=300, left=89, width=461)
         + line('the harbour master greeted him beside the waiting vessel.',
                top=322, left=89, width=461)
         + line('They walked home.', top=344, width=200))
wp, _, wd, _, _ = build(fixture(page(1, whole)))
check('P1 whole-word drop cap preserves the leading space through markup',
      [text(l['html']) for l in wp[0]['lines']] == [
          'A man walked down to the harbour to see the ship come in and',
          'the harbour master greeted him beside the waiting vessel.', 'They walked home.'],
      repr([l['html'] for l in wp[0]['lines']]))
check('P1 whole-word drop cap stays in paragraph order without Aman',
      '<p>A man walked down to the harbour to see the ship come in and '
      'the harbour master greeted him beside the waiting vessel. They walked home.</p>' in
      re.sub(r'</?[bi]>', '', wd) and 'Aman' not in text(wd), wd)

check('P1 existing T initial joins its lowercase continuation without a space',
      '<p>This line opens with a drop cap and then continues as ordinary prose for a good while '
      'until it ends.</p>' in doc, doc)


print('\ndrop-cap paragraph and chain regressions (PR #119 round 2)')


class Indent18(Opt):
    indent = 18


for covered in (2, 3):
    for ending, second in (
        ('and everyone was ready.', 'The harbour master stood beside the waiting vessel.'),
        ('and knew what to expect from', 'Captain Smith, who stood beside the waiting vessel.'),
        ('and everyone was ready;', 'the harbour master stood beside the waiting vessel.'),
    ):
        expected = ['When the ship came in, the passengers waited ' + ending, second]
        rest = (line(expected[0][1:], top=300, left=89, width=461)
                + line(second, top=322, left=89, width=461))
        if covered == 3:
            third = 'London Bridge was visible beyond the harbour gates.'
            rest += line(third, top=344, left=89, width=461)
            expected.append(third)
        covered_rest = rest
        last = 'Everyone aboard could finally begin the journey home.'
        rest += line(last, top=300 + 22 * covered, width=500)
        expected.append(last)
        cap = line('W', top=298, width=40, font=5, height=44 if covered == 2 else 68)
        for opt in (Opt(), Indent18()):
            _, _, cd, _, _ = build(fixture(page(1, DROP_FONTS + cap + rest)), opt)
            label = f'P1-A {covered}-line cap ending {ending!r} indent={opt.indent}'
            check(label + ' stays one paragraph through the first uncovered line',
                  re.findall(r'<p>.*?</p>', cd) == ['<p>' + ' '.join(expected) + '</p>'],
                  repr(re.findall(r'<p>.*?</p>', cd)))

            next_p = 'Another paragraph begins after the drop-cap paragraph.'
            _, _, direct, _, _ = build(fixture(page(1, DROP_FONTS + cap + covered_rest
                + line(next_p, top=300 + 22 * covered, left=70, width=480))), opt)
            direct_label = label + (' GUARD' if covered == 2 else '')
            check(direct_label + ' an indent immediately after the covered lines opens a paragraph',
                  f'<p>{next_p}</p>' in direct,
                  repr(re.findall(r'<p>.*?</p>', direct)))

            for boundary in ('indent', 'short'):
                # Guards: after the covered lines, ordinary paragraph geometry
                # still applies. Capitals/punctuation keep runs_on out of it.
                guard_rest = rest
                if boundary == 'short':
                    guard_rest = guard_rest.replace(
                        line(last, top=300 + 22 * covered, width=500),
                        line(last, top=300 + 22 * covered, width=200))
                next_p = 'Another paragraph begins after the drop-cap paragraph.'
                guard_rest += line(next_p, top=322 + 22 * covered,
                                   left=70 if boundary == 'indent' else 50,
                                   width=480 if boundary == 'indent' else 500)
                _, _, gd, _, _ = build(fixture(page(1, DROP_FONTS + cap + guard_rest)), opt)
                check(label + f' GUARD {boundary} opens a new paragraph',
                      f'<p>{next_p}</p>' in gd,
                      repr(re.findall(r'<p>.*?</p>', gd)))

# Catch errors inside each regression so the old script reports each failure
# rather than aborting the suite at its first KeyError.
for letters, tail, expected in (
    ('Wh', 'en the ship came into the harbour.', 'When the ship came into the harbour.'),
    ('Arte', '', 'Arte'),
):
    chain = ''.join(line(letter, top=298, left=50 + 40 * i, width=40,
                         font=5, height=44) for i, letter in enumerate(letters))
    if tail:
        chain += line(tail, top=300, left=50 + 40 * len(letters),
                      width=500 - 40 * len(letters))
    following = ['The harbour master greeted the passengers.',
                 'Everyone could finally begin the journey home.']
    chain += ''.join(line(t, top=344 + 22 * i) for i, t in enumerate(following))
    try:
        cp, _, _, _, _ = build(fixture(page(1, DROP_FONTS + chain + BODY)))
        got = [text(l['html']) for l in cp[0]['lines']]
        check(f'P1-B {letters} chain joins in order without raising',
              got == [expected] + following + [text(BODY)], repr(got))
    except Exception as e:
        check(f'P1-B {letters} chain joins in order without raising', False,
              f'{type(e).__name__}: {e}')

try:
    # Same-left zero-width letters each select the other as their next run.
    cyclic_runs = [(298, 44, 50, 0, 40, 'Serif', letter) for letter in 'wh']
    cyclic_runs.append((400, 17, 50, 500, 15, 'Serif', 'Ordinary body text.'))
    cyclic = P.lines_of(cyclic_runs)
    check('P1-B cyclic zero-width letters survive normal clustering without raising',
          [l['html'] for l in cyclic] == ['hw', 'Ordinary body text.']
          and cyclic[0]['max'] == 40, repr(cyclic))
except Exception as e:
    check('P1-B cyclic zero-width letters survive normal clustering without raising',
          False, f'{type(e).__name__}: {e}')

print('\ndrop-cap continuity and reading order (PR #119 round 3)')
for opt in (Opt(), Indent18()):
    for layout, left, width, inset in (
        ('margin', 50, 40, 89),
        ('indented', 70, 40, 109),
        ('hanging 10', 10, 38, 50),
        ('hanging 30', 30, 18, 50),
    ):
        for covered in (2, 3):
            expected = ['When the ship came in, everyone was ready.',
                        'The harbour master stood beside the waiting vessel.']
            if covered == 3:
                expected.append('London Bridge was visible beyond the harbour gates.')
            cap = line('W', top=298, left=left, width=width, font=5,
                       height=44 if covered == 2 else 68)
            rest = ''.join(line(t[1:] if i == 0 else t, top=300 + 22 * i,
                                left=inset, width=550 - inset)
                           for i, t in enumerate(expected))
            first_uncovered = 'Everyone aboard could finally begin the journey home.'
            final = 'The voyage ended.'
            tail = (line(first_uncovered, top=300 + 22 * covered)
                    + line(final, top=322 + 22 * covered, width=200))
            # Two ordinary lines establish margin 50 independently of the cap.
            anchor = (line('Ordinary prose establishes the body margin.', top=100)
                      + line('This paragraph ends here.', top=122, width=200))
            content = DROP_FONTS + anchor + cap + rest
            _, _, cd, _, _ = build(fixture(page(1, content + tail)), opt)
            label = f'{covered}-line {layout} initial indent={opt.indent}'
            prefix = 'GUARD' if layout == 'margin' else 'P1-C'
            got = re.findall(r'<p>(.*?)</p>', cd)
            check(prefix + ' ' + label + ' continues through the first uncovered line',
                  got[1:] == [' '.join(expected + [first_uncovered, final])], repr(got))

            # The only ordinary margin line may be the first uncovered one.
            _, _, cd, _, _ = build(fixture(page(1, DROP_FONTS + cap + rest
                + line(first_uncovered, top=300 + 22 * covered))), opt)
            got = re.findall(r'<p>(.*?)</p>', cd)
            sparse_prefix = 'P1-C' if layout.startswith('hanging') else 'GUARD'
            check(sparse_prefix + ' ' + label + ' needs no extra margin lines',
                  got == [' '.join(expected + [first_uncovered])], repr(got))

            next_p = 'Another paragraph begins after the covered lines.'
            _, _, gd, _, _ = build(fixture(page(1, content
                + line(next_p, top=300 + 22 * covered, left=75, width=475))), opt)
            check('GUARD P1-C ' + label + ' immediate indent opens a paragraph',
                  f'<p>{next_p}</p>' in gd, repr(re.findall(r'<p>.*?</p>', gd)))
            for short_line in (0, covered - 1):
                short_rest = ''.join(line(t[1:] if i == 0 else t, top=300 + 22 * i,
                                         left=inset,
                                         width=200 if i == short_line else 550 - inset)
                                     for i, t in enumerate(expected))
                _, _, gd, _, _ = build(fixture(page(1,
                    DROP_FONTS + anchor + cap + short_rest + tail)), opt)
                following = expected[short_line + 1] if short_line == 0 else first_uncovered
                check('GUARD P1-C ' + label + f' short line {short_line + 1} ends a paragraph',
                      f'<p>{following}' in gd, repr(re.findall(r'<p>.*?</p>', gd)))

print('\ndrop-cap overhang and paragraph context (PR #119 round 4)')


def cap_paragraphs(left, width, inset, covered, height, anchor_width):
    anchor = (line('Ordinary prose establishes the body margin.', top=200)
              + line('The preceding paragraph ends here.', top=222, width=anchor_width))
    words = ['When the ship came in, everyone was ready for news.',
             'The harbour master stood beside the long vessel there.',
             'Everyone aboard watched the harbour gates.'][:covered]
    cap = line('W', top=298, left=left, width=width, font=5, height=height)
    rest = ''.join(line(t[1:] if i == 0 else t, top=300 + 22 * i,
                        left=inset, width=550 - inset) for i, t in enumerate(words))
    tail = (line('Another paragraph begins after the covered lines.',
                 top=300 + 22 * covered, left=75, width=475)
            + line('It ends here.', top=322 + 22 * covered, width=200))
    _, _, cd, _, _ = build(fixture(page(1, DROP_FONTS + anchor + cap + rest + tail)),
                          Indent18())
    return re.findall(r'<p>(.*?)</p>', cd)


for covered, height in ((2, 47), (3, 74)):
    for layout, left, width, inset in (
        ('margin', 50, 40, 89),
        ('indented', 70, 40, 109),
        ('hanging', 10, 38, 50),
    ):
        got = cap_paragraphs(left, width, inset, covered, height, 300)
        prefix = 'P1-E' if layout == 'hanging' else 'GUARD P1-E'
        check(f'{prefix} {covered}-line {layout} overhang preserves the next indent',
              got[-1] == 'Another paragraph begins after the covered lines. It ends here.'
              and len(got) == 3, repr(got))

for covered in (2, 3):
    for overhang, height in (('before', 44 if covered == 2 else 66),
                            ('overhang', 47 if covered == 2 else 74)):
        for ending, anchor_width in (('short', 300), ('flush right', 500)):
            margin = cap_paragraphs(50, 40, 89, covered, height, anchor_width)
            anchor = ('Ordinary prose establishes the body margin. '
                      'The preceding paragraph ends here.')
            cap_text = 'When the ship came in, everyone was ready for news. '
            cap_text += 'The harbour master stood beside the long vessel there.'
            if covered == 3:
                cap_text += ' Everyone aboard watched the harbour gates.'
            expected = ([anchor, cap_text] if ending == 'short'
                        else [anchor + ' ' + cap_text])
            expected.append('Another paragraph begins after the covered lines. It ends here.')
            context = f'{covered}-line box={overhang} preceding={ending}'
            check('GUARD P1-F margin ' + context + ' retains its paragraph structure',
                  margin == expected, repr(margin))
            for layout, left, width, inset in (
                ('hanging 10', 10, 38, 50),
                ('hanging 30', 30, 18, 50),
                ('indented', 70, 40, 109),
            ):
                got = cap_paragraphs(left, width, inset, covered, height, anchor_width)
                # With a short preceding paragraph, only a hanging cap with
                # an overhanging box fails on 26df189; the others are guards.
                guard = ending == 'short' and (overhang == 'before' or layout == 'indented')
                prefix = 'GUARD P1-F' if guard else 'P1-F'
                if layout == 'indented' and ending == 'flush right':
                    # An indented initial marks a paragraph even when the
                    # preceding line reaches the right margin.
                    separate = [anchor, cap_text, expected[-1]]
                    check(f'P1-H indented {context} opens its own paragraph',
                          got == separate, f'got={got!r}; expected={separate!r}')
                else:
                    check(f'{prefix} {layout} {context} matches margin paragraphs',
                          got == margin, f'got={got!r}; margin={margin!r}')

print('\nreal drop-cap boxes and indented initials (PR #119 round 5)')
for opt in (Opt(), Indent18()):
    for body_height, cap_height in ((15, 69), (14, 71)):
        # Times 11pt/13.2pt leading as reported by pdftohtml: the 3-line
        # letter ends at 266, 8px into the next 15px line. Also exercise a
        # 10px overhang into a 14px line, beyond the old centre threshold.
        fonts = ('<fontspec id="0" size="17" family="Times"/>'
                 '<fontspec id="1" size="76" family="Times"/>')
        anchor = (line('Ordinary prose establishes the body margin.', top=139,
                       height=body_height)
                  + line('The preceding paragraph reaches the right margin.', top=159,
                         height=body_height)
                  + line('It ends short.', top=178, width=91, height=body_height))
        words = ['When the ship came in, everyone was ready.',
                 'The harbour master stood beside the waiting vessel.',
                 'London Bridge was visible beyond the harbour gates.']
        next_p = 'Another paragraph begins after the covered lines.'
        after = (line('It ends here.', top=277, width=96, height=body_height)
                 + ''.join(line('Ordinary prose continues across the rest of the page.',
                                top=top, height=body_height)
                           for top in (297, 317, 337, 357, 376, 396))
                 + line('The page ends.', top=416, width=96, height=body_height))
        for layout, left, inset in (('hanging', -23, 50), ('margin', 50, 123),
                                    ('indented', 70, 143)):
            cap = line('W', top=197, left=left, width=72, height=cap_height, font=1)
            rest = ''.join(line(t[1:] if i == 0 else t, top=198 + 20 * i,
                                left=inset, width=550 - inset, height=body_height)
                           for i, t in enumerate(words))
            content = fonts + anchor + cap + rest
            label = (f'P1-G {layout} body-height={body_height} '
                     f'overhang={197 + cap_height - 258} indent={opt.indent}')
            _, _, cd, _, _ = build(fixture(page(1, content
                + line(next_p, top=258, left=75, width=475, height=body_height)
                + after)), opt)
            got = re.findall(r'<p>(.*?)</p>', cd)
            # Only hanging text lets the overhang swallow the next indent;
            # the inset layouts protect it horizontally on the old version.
            prefix = '' if layout == 'hanging' else 'GUARD '
            check(prefix + label + ' next indent opens a paragraph',
                  got[1:3] == [' '.join(words), next_p + ' It ends here.'], repr(got))
            check('GUARD ' + label + ' covered capitals and punctuation stay together',
                  any(p.startswith(' '.join(words)) for p in got), repr(got))

            # At the body margin the first uncovered line continues, then
            # its short ending lets the next margin line open a paragraph.
            _, _, cd, _, _ = build(fixture(page(1, content
                + line('Everyone aboard could begin the journey home.', top=258,
                       height=body_height) + after)), opt)
            got = re.findall(r'<p>(.*?)</p>', cd)
            check('GUARD ' + label + ' uncovered margin and short ending retain geometry',
                  got[1] == ' '.join(words) +
                  ' Everyone aboard could begin the journey home. It ends here.'
                  and len(got) == 3 and got[2].endswith('The page ends.'), repr(got))

    for covered in (2, 3):
        anchor = (line('Ordinary prose establishes the body margin.', top=200)
                  + line('The preceding paragraph ends flush right.', top=222))
        words = ['When the ship came in, everyone was ready.',
                 'The harbour master stood beside the waiting vessel.']
        if covered == 3:
            words.append('London Bridge was visible beyond the harbour gates.')
        tail = (line('Everyone aboard could begin the journey home.',
                     top=300 + 22 * covered)
                + line('The voyage ended.', top=322 + 22 * covered, width=200)
                + line('Another paragraph begins at the body margin.',
                       top=344 + 22 * covered))
        cap_text = ' '.join(words) + ' Everyone aboard could begin the journey home. The voyage ended.'
        anchor_text = 'Ordinary prose establishes the body margin. The preceding paragraph ends flush right.'
        last = 'Another paragraph begins at the body margin.'
        for layout, left, width, inset in (('margin', 50, 40, 89),
                                           ('hanging', 10, 38, 50),
                                           ('indented', 70, 40, 109)):
            cap = line('W', top=298, left=left, width=width, font=5,
                       height=44 if covered == 2 else 68)
            rest = ''.join(line(t[1:] if i == 0 else t, top=300 + 22 * i,
                                left=inset, width=550 - inset)
                           for i, t in enumerate(words))
            _, _, cd, _, _ = build(fixture(page(1, DROP_FONTS + anchor + cap + rest + tail)), opt)
            got = re.findall(r'<p>(.*?)</p>', cd)
            label = f'P1-H {covered}-line {layout} flush-right predecessor indent={opt.indent}'
            if layout == 'indented':
                check(label + ' initial opens its paragraph and retains its continuations',
                      got == [anchor_text, cap_text, last], repr(got))
            else:
                check('GUARD ' + label + ' retains margin paragraphs',
                      got == [anchor_text + ' ' + cap_text, last], repr(got))

tracked = DROP_FONTS + ''.join(
    line(letter, top=100, left=left, width=width, font=5, height=44)
    for letter, left, width in (
        ('A', 50, 30), ('r', 95, 30), ('t', 140, 30), ('e', 185, 30),
        (' ', 215, 20), ('S', 240, 30), ('o', 285, 30), ('p', 330, 30), ('a', 375, 30)))
tp, _, td, _, _ = build(fixture(page(1, tracked + BODY)))
check('P1-D two chains on one visual line retain their text order',
      text(tp[0]['lines'][0]['html']) == 'Arte Sopa',
      repr(text(tp[0]['lines'][0]['html'])))
tracked_heads = re.findall(r'<h[123]>(.*?)</h[123]>', td)
check('P1-D two chains retain heading letter order',
      [re.sub(r'\s+', '', text(h)) for h in tracked_heads] == ['ArteSopa'],
      repr(tracked_heads))

# Normal capitals, including a modestly larger one, retain their actual size.
for size in (15, 17):
    normal = ('<fontspec id="5" size="' + str(size) + '" family="Serif"/>'
              + line('W', top=300, width=39, font=5)
              + line('hen the ship sailed into the harbour', top=300, left=89, width=461)
              + line('the master greeted the passengers.', top=322))
    np, _, _, _, _ = build(fixture(page(1, normal)))
    check(f'GUARD ordinary {size}pt capital is not flattened as a drop cap',
          np[0]['lines'][0]['max'] == size and np[0]['lines'][0]['html'] ==
          'When the ship sailed into the harbour', repr(np[0]['lines'][0]))

# Measured with c4e21ab's script: A is not a Roman numeral, so its legacy
# heading deliberately differs from V/I/X. These are preservation guards.
for numeral in ('V', 'I', 'X', 'A'):
    for wrapped in (False, True):
        content = ('<fontspec id="5" size="138" family="Display"/>'
                   + line(numeral, top=60, left=50, width=100, font=5, height=100)
                   + line('CAPÍTULO', top=70, left=160, width=110)
                   + line('The Second Chapter', top=112, left=160, width=350, font=3))
        if wrapped:
            content += line('Across the Harbour', top=144, left=160, width=350, font=3)
        hp, _, hd, _, _ = build(fixture(page(1, content + BODY)))
        title = 'The Second Chapter' + (' Across the Harbour' if wrapped else '')
        expected_head = (f'A CAPÍTULO {title}' if numeral == 'A'
                         else f'CAPÍTULO {numeral} — {title}')
        label = f'GUARD chapter opener {numeral} wrapped={wrapped}'
        check(label + ' keeps c4e21ab heading',
              re.findall(r'<h[123]>.*?</h[123]>', hd) == [f'<h2>{expected_head}</h2>'], hd)
        expected_lines = [numeral + 'CAPÍTULOThe Second Chapter']
        if wrapped:
            expected_lines.append('Across the Harbour')
        check(label + ' keeps c4e21ab visual lines',
              [l['html'] for l in hp[0]['lines']] == expected_lines + [text(BODY)],
              repr([l['html'] for l in hp[0]['lines']]))


print('\ndrop-cap first line and initial spacing (CodeRabbit, PR #119)')
first = 'When the ship came in, the passengers knew what to expect and'
second = 'the harbour master was still on duty beside the waiting vessel and'
third = 'the sailors watched the tide before the harbour gates opened.'
for offset in (1, 5, 13):
    content = (DROP_FONTS
               + line('W', top=298, width=40, font=5, height=68)
               + line(first[1:], top=300, left=103, width=447)
               + line(second, top=322, left=103 - offset, width=447 + offset)
               + line(third, top=344, left=103 - offset, width=447 + offset))
    jp, _, jd, _, _ = build(fixture(page(1, content)))
    got = [text(l['html']) for l in jp[0]['lines']]
    label = f'P1 first-line jitter {offset}px'
    check(label + ' initial joins the first visual line', got[0] == first, repr(got))
    check(label + ' second line retains its own text', got[1] == second, repr(got))
    check(label + ' paragraph opens with When', '<p>' + first in jd, jd)

exact_runs = [(100, 40, 100, 24, 36, 'Serif', 'W'),
              (100, 14, 130, 420, 12, 'Serif', first[1:]),
              (114, 14, 126, 424, 12, 'Serif', second),
              (140, 14, 50, 500, 12, 'Serif', third)]
exact_lines = P.lines_of(exact_runs)
got = [text(l['html']) for l in exact_lines]
check('P1 CodeRabbit exact geometry initial joins top=100',
      got[0] == first and exact_lines[0]['c'] == 107, repr(got))
check('P1 CodeRabbit exact geometry top=114 stays unchanged',
      got[1] == second and exact_lines[1]['c'] == 121, repr(got))

for cap, continuation, expected, glued in (
    ('A ', 'long time ago, the passengers waited for the ship and',
     'A long time ago, the passengers waited for the ship and', 'Along'),
    ('I ', 'was born beside the harbour where the ships came in and',
     'I was born beside the harbour where the ships came in and', 'Iwas'),
    ('O ', 'happy day when the ship came into the harbour at last and',
     'O happy day when the ship came into the harbour at last and', 'Ohappy'),
    ('A', ' man walked down to the harbour to see the ship come in and',
     'A man walked down to the harbour to see the ship come in and', 'Aman'),
):
    content = (DROP_FONTS + line(cap, top=298, width=40, font=5, height=44)
               + line(continuation, top=300, left=89, width=461)
               + line(second, top=322, left=89, width=461))
    sp, _, sd, _, _ = build(fixture(page(1, content)))
    label = f'P1 initial spacing {cap!r} + {continuation.split()[0]!r}'
    check(label + ' line keeps the word space',
          text(sp[0]['lines'][0]['html']) == expected, repr(sp[0]['lines'][0]['html']))
    check(label + ' paragraph keeps the word space',
          '<p>' + expected in sd and glued not in text(sd), sd)

for variant in ('lower first run', 'small first run', 'small caps', 'raised superscript'):
    opening = line(first[1:], top=300, left=89, width=461)
    expected = first
    if variant in ('lower first run', 'small first run'):
        opening = (line('hen ', top=301, left=89, width=30,
                        font=6 if variant == 'small first run' else 0,
                        height=14 if variant == 'small first run' else 17)
                   + line(first[5:], top=300, left=119, width=431))
    elif variant == 'small caps':
        opening = (line('hen the ', top=301, left=89, width=60, font=6, height=14)
                   + line('SHIP', top=300, left=149, width=40, font=6, height=14)
                   + line(first[13:], top=300, left=189, width=361))
        expected = first.replace('ship', 'SHIP')
    elif variant == 'raised superscript':
        opening = (line(first[1:], top=300, left=89, width=445)
                   + line('12', top=294, left=534, width=16, font=7, height=14))
        expected += '12'
    content = (DROP_FONTS + line('W', top=298, width=40, font=5, height=68)
               + opening + line(second, top=322, left=89, width=461)
               + line(third, top=344, left=89, width=461))
    gp, _, gd, _, _ = build(fixture(page(1, content)))
    got = [text(l['html']) for l in gp[0]['lines']]
    check(f'GUARD first-line grouping {variant}',
          got == [expected, second, third] and '<p>' + expected in gd,

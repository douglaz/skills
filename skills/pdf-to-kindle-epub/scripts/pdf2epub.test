def hyphen_case(stem, head, evidence, wanted):
    # Keep each evidence token away from both ends of its visual line.
    content = (line('Evidence says ' + evidence + ' elsewhere.', 100)
               + line('The long paragraph carries its word as ' + stem + '-', 122)
               + line(head + ' and the paragraph finishes.', 144, width=300))
    hp, hb, hd, _, _ = build(fixture(page(1, content)))
    # Feed the opposite pdftotext vocabulary decision, so only XML evidence
    # can satisfy the assertion (and the unfixed converter visibly fails).
    hd, _, _ = P.build_html(hp, hb, Opt(), set(), set(),
                            {stem + head} if '-' in wanted else set())
    decisions = []
    if hasattr(P, 'midline_words'):
        hd, _, _ = P.build_html(hp, hb, Opt(), set(), set(),
                                hyphen_decisions=decisions)
    return html.unescape(text(hd)), decisions


for stem, head, wanted in (
    ('1939', '1945', '1939-1945'),
    ('pages 212', '218', 'pages 212-218'),
    ('0-14', '044913-6', '0-14-044913-6'),
):
    hplain, decisions = hyphen_case(stem, head, 'unrelated tokens', wanted)
    check('R2 C keeps ' + wanted, 'word as ' + wanted + ' and' in hplain,
          f'got {hplain[-180:]}')
    check('R2 C excludes ' + wanted + ' from no-evidence decisions',
          decisions == [], f'got {decisions}')


for stem, head, evidence, wanted, label in (
    ('self', 'interest', 'Self-Interest', 'self-interest', 'hyphenated evidence'),
    ('produc', 'tive', 'Productive', 'productive', 'joined evidence'),
    ('prontos', 'socorros', 'prontos and socorros', 'prontos-socorros', 'standalone fallback'),
    ('catastro', 'fizando', 'neither fragment', 'catastrofizando', 'join fallback'),
    ('well', 'known', 'well-known wellknown wellknown', 'wellknown', 'joined majority'),
    ('well', 'known', 'well-known well-known wellknown', 'well-known', 'hyphenated majority'),
    ('well', 'known', 'well-known wellknown', 'well-known', 'tie keeps hyphen'),
    ('prontos', 'socorros', 'pronto-socorros', 'prontossocorros', 'compound is not standalone'),
):
    hplain, decisions = hyphen_case(stem, head, evidence, wanted)
    check('P1.6 ' + label, 'word as ' + wanted + ' and' in hplain, f'got {hplain[-180:]}')
    if label in ('standalone fallback', 'join fallback'):
        expected = {'page': 1, 'stem': stem, 'head': head,
                    'action': 'keep' if '-' in wanted else 'join'}
        check('P1.6 reports ' + stem + '/' + head + ' without evidence',
              expected in decisions,
              f'got {decisions}; missing midline_words/report interface on old code')

# Neither side of a break may bootstrap evidence, including soft-hyphen
# fragments or a one-word line. Their presence must still leave a fallback.
for hyphen in ('-', '\xad'):
    content = (line('Evidence excludes fragments of prontos' + hyphen, 100)
               + line('socorros', 122, width=100)
               + line('A second paragraph repeats prontos-', 160)
               + line('socorros and ends.', 182, width=200))
    hp, hb, hd, _, _ = build(fixture(page(1, content)))
    decisions = []
    if hasattr(P, 'midline_words'):
        hd, _, _ = P.build_html(hp, hb, Opt(), set(), set(), hyphen_decisions=decisions)
    check('P1.6 break fragments are not evidence ' + repr(hyphen),
          'prontossocorros and ends.' in hd and bool(decisions),
          f'got {decisions}; missing evidence/report interface on old code')

no_evidence = fixture(page(1,
    line('Elsewhere both prontos and socorros stand alone.', 100)
    + line('The next paragraph ends its first line with prontos-', 140)
    + line('socorros and then stops.', 162, width=200)
    + line('This paragraph has a different broken word catastro-', 200)
    + line('fizando and finally stops.', 222, width=200)))
hp, hb, _, _, _ = build(no_evidence)
decisions = []
if hasattr(P, 'midline_words'):
    P.build_html(hp, hb, Opt(), set(), set(), hyphen_decisions=decisions)
check('P1.6 both no-evidence decisions are recorded together',
      decisions == [{'page': 1, 'stem': 'prontos', 'head': 'socorros', 'action': 'keep'},
                    {'page': 1, 'stem': 'catastro', 'head': 'fizando', 'action': 'join'}],
      f'got {decisions}; missing evidence/report interface on old code')

with tempfile.TemporaryDirectory() as w:
    src = os.path.join(w, 'src.pdf')
    inp = os.path.join(w, 'input.pdf')
    for name, data in (('src.pdf', b'A'), ('input.pdf', b'B'), ('book.xml', b'old XML'),
                       ('plain.txt', b'old text'), ('book-1_1.png', b'old image'),
                       ('notes.txt', b'keep me')):
        with open(os.path.join(w, name), 'wb') as f:
            f.write(data)
    calls, err = [], io.StringIO()
    old_run = P.run
    try:
        P.run = lambda *a, **kw: calls.append(a)
        refused = False
        with contextlib.redirect_stderr(err):
            try:
                P.extract(inp, w)
            except SystemExit as e:
                refused = bool(e.code)
                print(e, file=sys.stderr)
        check('P1.7 different input refuses stale work with a remedy',
              refused and '--work' in err.getvalue(), f'stderr={err.getvalue()!r}, refused={refused}')
        with open(inp, 'wb') as f:
            f.write(b'A')
        calls.clear()
        result = P.extract(inp, w)
        check('GUARD P1.7 matching input reuses extraction without tools',
              result == os.path.join(w, 'book.xml') and not calls, f'calls={calls}')
    finally:
        P.run = old_run

with tempfile.TemporaryDirectory() as w:
    path = os.path.join(w, 'book.xml')
    with open(path, 'w') as f:
        f.write(TABLE)
    calls = []
    old_run = P.run
    try:
        def render_crop(cmd, cwd):
            calls.append(cmd)
            open(os.path.join(cwd, cmd[-1] + '-1.png'), 'wb').close()
        P.run = render_crop

        def crop(height=0, dpi=150):
            cp, cb = P.parse(path)
            P.classify(cp, cb, Opt())
            if height:
                # Expand the same table without changing its page/index.
                row = next(l for l in cp[0]['lines'] if 'lower level' in l['html'])
                row['h'] += height
            P.crop_tables(cp, w, dpi)
            cd, _, _ = P.build_html(cp, cb, Opt(), set(), set())
            return cp[0]['tables'][0]['src'], cd

        first, _ = crop()
        second, cdoc = crop(height=20)
        check('P1.8 changed region renders a new referenced crop',
              len(calls) == 2 and first != second and f'src="{second}"' in cdoc,
              f'{len(calls)} renders, {first}, {second}')
        before = len(calls)
        same, _ = crop(height=20)
        check('GUARD P1.8 same region and dpi reuse the crop',
              len(calls) == before and same == second, f'{len(calls)} renders')
        third, _ = crop(height=20, dpi=200)
        check('P1.8 changed dpi renders again',
              len(calls) == before + 1 and third != second, f'{len(calls)} renders, {third}')
    finally:
        P.run = old_run

print(f'\n{PASS} passed, {FAIL} failed')
sys.exit(1 if FAIL else 0)

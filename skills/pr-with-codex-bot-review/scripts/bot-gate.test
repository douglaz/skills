#!/usr/bin/env bash
# bot-gate.test — fixture tests for bot-gate, run with a stubbed `gh`.
#
# Every case here corresponds to a real defect found in review. bot-gate had four separate
# fail-open bugs and two deadlocks across its first day, each caught only by a reviewer
# reading it; these assert the behaviour instead.
#
# Usage: ./bot-gate.test          (exits 0 if all pass)

set -uo pipefail
HERE=$(cd "$(dirname "$0")" && pwd)
GATE="$HERE/bot-gate"
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
PASS=0; FAIL=0

# The stub reads $FIX (a directory of canned responses) and answers by endpoint shape.
mkdir -p "$WORK/bin"
cat > "$WORK/bin/gh" <<'STUB'
#!/usr/bin/env bash
f() { cat "$FIX/$1" 2>/dev/null || echo "$2"; }
case "$*" in
  *"repo view"*nameWithOwner*)  f repo.txt "owner/repo" ;;
  *"pr view"*number*)           f prnum.txt "16" ;;
  *"pulls/"*"/files"*)          [ -f "$FIX/prfilesfail" ] && exit 1; f prfiles.json '[[]]' ;;
  *"pr checks"*)                [ -f "$FIX/checksfail" ] && exit 1; f checks.json '[]' ;;
  *"pr view"*statusCheckRollup*) f rollup.json '{"statusCheckRollup":[]}' ;;
  *reactions*)                  [ -f "$FIX/reactionsfail" ] && exit 1; f reactions.json '[[]]' ;;
  *graphql*)                    f threads.json '{"data":{"repository":{"pullRequest":{"reviewThreads":{"pageInfo":{"hasNextPage":false,"endCursor":null},"nodes":[]}}}}}' ;;
  *"pulls/"*"/reviews"*)        f reviews.json '[[]]' ;;
  *"issues/"*"/comments"*)      f issues.json '[[]]' ;;
  *) echo "[]" ;;
esac
[ -f "$FIX/FAIL" ] && exit 1
exit 0
STUB
chmod +x "$WORK/bin/gh"
# Only `gh` is stubbed: $WORK/bin is PREPENDED to the real PATH so it shadows gh while
# bash, git, jq and coreutils resolve normally. Replacing PATH outright fails on distros
# where bash does not live in /bin (exit 127 for everything).

# Fixed literals, not `date -d`: that is GNU-only, and on BSD it would leave these empty
# and fail the CLEAR fixtures — the suite reproducing the very portability bug it exists
# to catch. Only NOW needs the clock, and `date -u +FORMAT` is portable.
OLD_UTC="2000-01-01T00:00:00Z"
FUTURE_UTC="2999-01-01T00:00:00Z"
NOW_UTC=$(date -u +%Y-%m-%dT%H:%M:%SZ)

wrapper() {  # $1 = login, $2 = submitted_at  (shape matches `gh api --paginate --slurp`)
  printf '[[{"user":{"login":"%s","type":"Bot"},"submitted_at":"%s","body":"Reviewed commit: `%s`"}]]' \
    "$1" "$2" "$TIP"
}
threads() {  # $1 = count of unresolved bot threads
  local n=$1 nodes=""
  for ((i=0;i<n;i++)); do nodes="$nodes${nodes:+,}{\"isResolved\":false,\"comments\":{\"nodes\":[{\"author\":{\"__typename\":\"Bot\",\"login\":\"chatgpt-codex-connector\"}}]}}"; done
  printf '{"data":{"repository":{"pullRequest":{"reviewThreads":{"pageInfo":{"hasNextPage":false,"endCursor":null},"nodes":[%s]}}}}}' "$nodes"
}

check() {  # $1 = name, $2 = expected exit
  local name=$1 want=$2
  PATH="$WORK/bin:$PATH" FIX="$FIX" "$GATE" 16 --settle-seconds 0 >/dev/null 2>&1
  local got=$?
  if [[ "$got" == "$want" ]]; then PASS=$((PASS+1)); printf '  ok   %-46s (exit %s)\n' "$name" "$got"
  else FAIL=$((FAIL+1)); printf '  FAIL %-46s want %s got %s\n' "$name" "$want" "$got"; fi
}

# A real repo so `git rev-parse HEAD` works.
git init -q "$WORK/repo"; cd "$WORK/repo"
git -c user.email=t@t -c user.name=t commit -q --allow-empty -m x
TIP=$(git rev-parse HEAD)

new_fix() { FIX="$WORK/fix"; rm -rf "$FIX"; mkdir -p "$FIX"; echo "owner/repo" > "$FIX/repo.txt"; echo 16 > "$FIX/prnum.txt"; }

echo "bot-gate fixtures"

new_fix; wrapper "chatgpt-codex-connector[bot]" "$OLD_UTC" > "$FIX/reviews.json"; threads 0 > "$FIX/threads.json"
check "clean: aged wrapper, 0 unresolved, no CodeRabbit" 0

new_fix; echo '[[]]' > "$FIX/reviews.json"; threads 0 > "$FIX/threads.json"
check "no wrapper for tip blocks" 1

new_fix; wrapper "chatgpt-codex-connector[bot]" "$OLD_UTC" > "$FIX/reviews.json"; threads 3 > "$FIX/threads.json"
check "unresolved bot threads block" 1

# A wrapper dated in the FUTURE is younger than any window, so the age check can be
# exercised with settle 0 — passing a large --settle-seconds would make the gate really
# sleep that long. Also covers clock skew between the runner and GitHub.
new_fix; wrapper "chatgpt-codex-connector[bot]" "$FUTURE_UTC" > "$FIX/reviews.json"; threads 0 > "$FIX/threads.json"
check "wrapper younger than settle window blocks" 1

new_fix; wrapper "chatgpt-codex-connector-attacker" "$OLD_UTC" > "$FIX/reviews.json"; threads 0 > "$FIX/threads.json"
check "spoofed login (prefix match) blocks" 1

new_fix; wrapper "chatgpt-codex-connector[bot]" "$OLD_UTC" > "$FIX/reviews.json"; threads 0 > "$FIX/threads.json"
echo '[{"name":"CodeRabbit","state":"SUCCESS"}]' > "$FIX/checks.json"
# CodeRabbit's real wording: the phrase is broken by a markdown link, so a naive
# "reviews are subject to rate limits" pattern misses it entirely (it did).
printf '[[{"user":{"login":"coderabbitai[bot]"},"created_at":"2026-01-01","body":"<!-- This is an auto-generated comment: rate limited by coderabbit.ai -->\\nYour plan includes PR reviews subject to [rate limits](https://docs.coderabbit.ai/x)."}]]' > "$FIX/issues.json"
check "CodeRabbit rate-limit notice (real wording) blocks" 1

new_fix; wrapper "chatgpt-codex-connector[bot]" "$OLD_UTC" > "$FIX/reviews.json"; threads 0 > "$FIX/threads.json"
echo '[{"name":"CodeRabbit","state":"SUCCESS"}]' > "$FIX/checks.json"
printf '[[{"user":{"login":"coderabbitai[bot]"},"created_at":"2026-01-01","body":"<!-- This is an auto-generated comment: review paused by coderabbit.ai -->"}]]' > "$FIX/issues.json"
check "CodeRabbit paused-review marker blocks" 1

new_fix; wrapper "chatgpt-codex-connector[bot]" "$OLD_UTC" > "$FIX/reviews.json"; threads 0 > "$FIX/threads.json"
echo '[{"name":"CodeRabbit","state":"SUCCESS"}]' > "$FIX/checks.json"
printf '[[{"user":{"login":"coderabbitai[bot]"},"created_at":"2026-01-01","body":"<!-- This is an auto-generated comment: summarize by coderabbit.ai -->\\nFiles skipped from review due to trivial changes: docs/x.md"}]]' > "$FIX/issues.json"
printf '[[{"filename":"src/core.py"}]]' > "$FIX/prfiles.json"
check "permitted file skips do not block" 0

# The inline form must still be PARSED — the earlier fixture asserted it "does not block"
# only because the path was unreachable, which encoded a fail-open as expected behaviour.
new_fix; wrapper "chatgpt-codex-connector[bot]" "$OLD_UTC" > "$FIX/reviews.json"; threads 0 > "$FIX/threads.json"
echo '[{"name":"CodeRabbit","state":"SUCCESS"}]' > "$FIX/checks.json"
printf '[[{"user":{"login":"coderabbitai[bot]","type":"Bot"},"created_at":"2026-01-01","body":"<!-- This is an auto-generated comment: summarize by coderabbit.ai -->\\nFiles skipped from review due to trivial changes: src/core.py"}]]' > "$FIX/issues.json"
printf '[[{"filename":"src/core.py"}]]' > "$FIX/prfiles.json"
check "inline skip naming a changed file blocks" 1

# Content AFTER the skip section must not be swallowed: a "Files selected for processing"
# list names files CodeRabbit REVIEWED, and treating them as skipped deadlocked every real
# walkthrough.
new_fix; wrapper "chatgpt-codex-connector[bot]" "$OLD_UTC" > "$FIX/reviews.json"; threads 0 > "$FIX/threads.json"
echo '[{"name":"CodeRabbit","state":"SUCCESS"}]' > "$FIX/checks.json"
printf '[[{"user":{"login":"coderabbitai[bot]","type":"Bot"},"created_at":"2026-01-01","body":"<!-- This is an auto-generated comment: summarize by coderabbit.ai -->\\nFiles skipped from review due to trivial changes:\\n- docs/unrelated.md\\n</details>\\nFiles selected for processing:\\n- src/core.py\\n"}]]' > "$FIX/issues.json"
printf '[[{"filename":"src/core.py"}]]' > "$FIX/prfiles.json"
check "reviewed-files list after the skip section clears" 0

new_fix; wrapper "chatgpt-codex-connector[bot]" "$OLD_UTC" > "$FIX/reviews.json"; threads 0 > "$FIX/threads.json"
echo '[{"name":"CodeRabbit","state":"SUCCESS"}]' > "$FIX/checks.json"
printf '[[{"user":{"login":"coderabbitai[bot]"},"created_at":"2026-01-01","body":"<!-- This is an auto-generated comment: summarize by coderabbit.ai -->\\nwalkthrough, all files reviewed"}]]' > "$FIX/issues.json"
check "CodeRabbit genuine SUCCESS clears" 0

# A walkthrough that merely DISCUSSES rate limiting must not be read as a skip — the old
# bare `rate limit` substring blocked such a PR forever.
new_fix; wrapper "chatgpt-codex-connector[bot]" "$OLD_UTC" > "$FIX/reviews.json"; threads 0 > "$FIX/threads.json"
echo '[{"name":"CodeRabbit","state":"SUCCESS"}]' > "$FIX/checks.json"
printf '[[{"user":{"login":"coderabbitai[bot]"},"body":"Adds a rate limit to the API client"}]]' > "$FIX/issues.json"
check "walkthrough mentioning rate limiting still clears" 0

# A fresh `eyes` newer than the wrapper means a round is running on the same tip.
new_fix; wrapper "chatgpt-codex-connector[bot]" "$OLD_UTC" > "$FIX/reviews.json"; threads 0 > "$FIX/threads.json"
printf '[[{"user":{"login":"chatgpt-codex-connector[bot]"},"content":"eyes","created_at":"%s"}]]' "$NOW_UTC" > "$FIX/reactions.json"
check "active round (eyes newer than wrapper) blocks" 1

# A newer REPLY must not mask an older status comment's skip notice: CodeRabbit's replies
# interleave with its status body, so "latest comment" picks a reply that says nothing.
new_fix; wrapper "chatgpt-codex-connector[bot]" "$OLD_UTC" > "$FIX/reviews.json"; threads 0 > "$FIX/threads.json"
echo '[{"name":"CodeRabbit","state":"SUCCESS"}]' > "$FIX/checks.json"
printf '[[{"user":{"login":"coderabbitai[bot]"},"created_at":"2026-01-01","body":"<!-- auto-generated comment: review paused by coderabbit.ai -->"},{"user":{"login":"coderabbitai[bot]"},"created_at":"2026-02-01","body":"<!-- This is an auto-generated reply by CodeRabbit --> thanks"}]]' > "$FIX/issues.json"
check "newer reply does not mask a skip notice" 1

# But a genuinely newer STATUS comment must clear a stale skip — the retrigger must work.
new_fix; wrapper "chatgpt-codex-connector[bot]" "$OLD_UTC" > "$FIX/reviews.json"; threads 0 > "$FIX/threads.json"
echo '[{"name":"CodeRabbit","state":"SUCCESS"}]' > "$FIX/checks.json"
printf '[[{"user":{"login":"coderabbitai[bot]"},"created_at":"2026-01-01","body":"<!-- auto-generated comment: rate limited by coderabbit.ai -->"},{"user":{"login":"coderabbitai[bot]"},"created_at":"2026-02-01","body":"<!-- auto-generated comment: summarize by coderabbit.ai --> walkthrough"}]]' > "$FIX/issues.json"
check "newer status comment clears a stale skip" 0

# A skip list covering a file the PR CHANGES must block; one covering unrelated files
# must not. Ignoring the marker entirely let central files merge unreviewed; blocking on
# it deadlocked every permitted skip.
new_fix; wrapper "chatgpt-codex-connector[bot]" "$OLD_UTC" > "$FIX/reviews.json"; threads 0 > "$FIX/threads.json"
echo '[{"name":"CodeRabbit","state":"SUCCESS"}]' > "$FIX/checks.json"
printf '[[{"user":{"login":"coderabbitai[bot]","type":"Bot"},"created_at":"2026-01-01","body":"<!-- This is an auto-generated comment: summarize by coderabbit.ai -->\\nFiles skipped from review due to trivial changes:\\n- src/core.py\\n"}]]' > "$FIX/issues.json"
printf '[[{"filename":"%s"}]]' 'src/core.py' > "$FIX/prfiles.json"
check "skip covering a CHANGED file blocks" 1

new_fix; wrapper "chatgpt-codex-connector[bot]" "$OLD_UTC" > "$FIX/reviews.json"; threads 0 > "$FIX/threads.json"
echo '[{"name":"CodeRabbit","state":"SUCCESS"}]' > "$FIX/checks.json"
printf '[[{"user":{"login":"coderabbitai[bot]","type":"Bot"},"created_at":"2026-01-01","body":"<!-- This is an auto-generated comment: summarize by coderabbit.ai -->\\nFiles skipped from review due to trivial changes:\\n- docs/other.md\\n"}]]' > "$FIX/issues.json"
printf '[[{"filename":"%s"}]]' 'src/core.py' > "$FIX/prfiles.json"
check "skip of an unrelated file still clears" 0

# A root-level extensionless file. The "must contain a slash" heuristic that replaced the
# "must have an extension" heuristic dropped this one — which is why the parser now uses
# no shape test at all and intersects against the changed files directly.
new_fix; wrapper "chatgpt-codex-connector[bot]" "$OLD_UTC" > "$FIX/reviews.json"; threads 0 > "$FIX/threads.json"
echo '[{"name":"CodeRabbit","state":"SUCCESS"}]' > "$FIX/checks.json"
printf '[[{"user":{"login":"coderabbitai[bot]","type":"Bot"},"created_at":"2026-01-01","body":"<!-- This is an auto-generated comment: summarize by coderabbit.ai -->\\nFiles skipped from review due to trivial changes:\\n- `Makefile` (1 hunks)\\n"}]]' > "$FIX/issues.json"
printf '[[{"filename":"Makefile"}]]' > "$FIX/prfiles.json"
check "root-level extensionless skipped path blocks" 1

# Markdown formats CodeRabbit really uses: backticked, **bold**, and extensionless. The
# filter used to run before the markdown strip, so anything ending in a non-alphanumeric
# was rejected — and requiring a dot-extension dropped extensionless paths, which this
# repo's own deliverables are.
new_fix; wrapper "chatgpt-codex-connector[bot]" "$OLD_UTC" > "$FIX/reviews.json"; threads 0 > "$FIX/threads.json"
echo '[{"name":"CodeRabbit","state":"SUCCESS"}]' > "$FIX/checks.json"
printf '[[{"user":{"login":"coderabbitai[bot]","type":"Bot"},"created_at":"2026-01-01","body":"<!-- This is an auto-generated comment: summarize by coderabbit.ai -->\\nFiles skipped from review due to trivial changes:\\n- `skills/x/scripts/bot-gate` (2 hunks)\\n"}]]' > "$FIX/issues.json"
printf '[[{"filename":"skills/x/scripts/bot-gate"}]]' > "$FIX/prfiles.json"
check "backticked extensionless skipped path blocks" 1

new_fix; wrapper "chatgpt-codex-connector[bot]" "$OLD_UTC" > "$FIX/reviews.json"; threads 0 > "$FIX/threads.json"
echo '[{"name":"CodeRabbit","state":"SUCCESS"}]' > "$FIX/checks.json"
printf '[[{"user":{"login":"coderabbitai[bot]","type":"Bot"},"created_at":"2026-01-01","body":"<!-- This is an auto-generated comment: summarize by coderabbit.ai -->\\nFiles skipped from review due to trivial changes:\\n* **src/bold.py** (3 hunks)\\n"}]]' > "$FIX/issues.json"
printf '[[{"filename":"src/bold.py"}]]' > "$FIX/prfiles.json"
check "bold skipped path blocks" 1

# A skipped path containing a space must still intersect: an ASCII token regex reduced
# `src/my file.py` to `file.py`, which matched nothing and cleared.
new_fix; wrapper "chatgpt-codex-connector[bot]" "$OLD_UTC" > "$FIX/reviews.json"; threads 0 > "$FIX/threads.json"
echo '[{"name":"CodeRabbit","state":"SUCCESS"}]' > "$FIX/checks.json"
printf '[[{"user":{"login":"coderabbitai[bot]","type":"Bot"},"created_at":"2026-01-01","body":"<!-- This is an auto-generated comment: summarize by coderabbit.ai -->\\nFiles skipped from review due to trivial changes:\\n- src/my file.py\\n"}]]' > "$FIX/issues.json"
printf '[[{"filename":"%s"}]]' 'src/my file.py' > "$FIX/prfiles.json"
check "skipped path with a space still blocks" 1

# CodeRabbit configured (it has commented) but no check for THIS head yet must block —
# `absent` is not the same as "not installed".
new_fix; wrapper "chatgpt-codex-connector[bot]" "$OLD_UTC" > "$FIX/reviews.json"; threads 0 > "$FIX/threads.json"
printf '[[{"user":{"login":"coderabbitai[bot]","type":"Bot"},"created_at":"2026-01-01","body":"<!-- This is an auto-generated comment: summarize by coderabbit.ai -->\\nwalkthrough"}]]' > "$FIX/issues.json"
check "configured CodeRabbit with no check for this head blocks" 1

# ...and the changed-files query must fail closed too. The suite had knobs for the
# reactions and checks endpoints but not this one, so the fail-open lived in a branch no
# fixture reached.
new_fix; wrapper "chatgpt-codex-connector[bot]" "$OLD_UTC" > "$FIX/reviews.json"; threads 0 > "$FIX/threads.json"
echo '[{"name":"CodeRabbit","state":"SUCCESS"}]' > "$FIX/checks.json"
printf '[[{"user":{"login":"coderabbitai[bot]","type":"Bot"},"created_at":"2026-01-01","body":"<!-- This is an auto-generated comment: summarize by coderabbit.ai -->\\nFiles skipped from review due to trivial changes:\\n- src/core.py\\n"}]]' > "$FIX/issues.json"
echo 'x' > "$FIX/prfilesfail"
check "changed-files query failure is exit 3" 3

# The active-round guard must fail CLOSED. Neither of these was covered by the happy-path
# case above: reverting the fail-closed logic left it green, which is how an untested
# branch hides.
new_fix; wrapper "chatgpt-codex-connector[bot]" "$OLD_UTC" > "$FIX/reviews.json"; threads 0 > "$FIX/threads.json"
printf '[[{"user":{"login":"chatgpt-codex-connector[bot]"},"content":"eyes","created_at":"not-a-date"}]]' > "$FIX/reactions.json"
check "unparseable eyes timestamp blocks" 1

new_fix; wrapper "chatgpt-codex-connector[bot]" "$OLD_UTC" > "$FIX/reviews.json"; threads 0 > "$FIX/threads.json"
echo 'x' > "$FIX/reactionsfail"
check "reactions query failure is exit 3" 3

# A PENDING CheckRun has no `.state` and a null `.conclusion`. Reading that as "absent"
# cleared past a review that was still running — the fail-open half that survived the
# name/state fix.
new_fix; wrapper "chatgpt-codex-connector[bot]" "$OLD_UTC" > "$FIX/reviews.json"; threads 0 > "$FIX/threads.json"
echo 'CHECKSFAIL' > "$FIX/checksfail"
echo '{"statusCheckRollup":[{"__typename":"CheckRun","name":"CodeRabbit","conclusion":null}]}' > "$FIX/rollup.json"
check "pending CheckRun CodeRabbit blocks" 1

new_fix; touch "$FIX/FAIL"
check "API failure is exit 3, never clearance" 3

# An unparseable wrapper timestamp must BLOCK, not clear. This is the fail-closed half of
# the macOS `date -d` problem and it is testable anywhere; the BSD fallback path itself
# cannot be exercised on Linux, since shadowing GNU `-d` leaves no working `date -j`
# either — that half is verified by inspection against the documented BSD syntax.
new_fix; wrapper "chatgpt-codex-connector[bot]" "not-a-timestamp" > "$FIX/reviews.json"
threads 0 > "$FIX/threads.json"
check "unparseable wrapper timestamp blocks" 1

echo
echo "passed $PASS, failed $FAIL"
[[ "$FAIL" -eq 0 ]]

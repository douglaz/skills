#!/usr/bin/env bash
# pr-watch.test — fixture tests for pr-watch, run against a stubbed bot-gate and `gh`.
#
# pr-watch is copied beside a stub bot-gate (it resolves its gate as a sibling). The stub
# answers its Nth `--json` call from $FIX/gate.N (first line the exit code, the rest the
# JSON), and its human-readable call with $FIX/human-rc (default 0). The `gh` stub answers
# its Nth `pr view` from $FIX/view.N and records every `pr comment` as "<target> <body>" in
# $FIX/comments, after failing the first $FIX/comment-fails of them. Both keep answering
# from the last file once a sequence runs out.
#
# Usage: ./pr-watch.test          (exits 0 if all pass)

set -uo pipefail
HERE=$(cd "$(dirname "$0")" && pwd)
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
PASS=0; FAIL=0

mkdir -p "$WORK/bin" "$WORK/scripts"
cp "$HERE/pr-watch" "$WORK/scripts/pr-watch"
cat > "$WORK/bin/seq-file" <<'STUB'
#!/usr/bin/env bash
# seq-file <prefix>: print the path of the next file in $FIX/<prefix>.N, sticking at the last.
n=$(( $(cat "$FIX/$1.calls" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$FIX/$1.calls"
while [ ! -f "$FIX/$1.$n" ] && [ "$n" -gt 1 ]; do n=$((n - 1)); done
echo "$FIX/$1.$n"
STUB
cat > "$WORK/scripts/bot-gate" <<'STUB'
#!/usr/bin/env bash
[ "${2:-}" = --json ] || { echo "human gate output"; exit "$(cat "$FIX/human-rc" 2>/dev/null || echo 0)"; }
f=$(seq-file gate); tail -n +2 "$f"; exit "$(head -1 "$f")"
STUB
cat > "$WORK/bin/gh" <<'STUB'
#!/usr/bin/env bash
case "$1 $2" in
  "pr view")    f=$(seq-file view); [ -f "$f" ] || exit 1; cat "$f" ;;
  "pr comment") n=$(cat "$FIX/comment-fails" 2>/dev/null || echo 0)
                (( n > 0 )) && { echo $((n - 1)) > "$FIX/comment-fails"; exit 1; }
                target=$3; shift 3
                while [ $# -gt 0 ]; do [ "$1" = --body ] && { printf '%s %s\n' "$target" "$2" >> "$FIX/comments"; shift; }; shift; done ;;
  *)            echo "unexpected gh call: $*" >&2; exit 1 ;;
esac
STUB
chmod +x "$WORK/scripts/pr-watch" "$WORK/scripts/bot-gate" "$WORK/bin/gh" "$WORK/bin/seq-file"

A=1111111111111111111111111111111111111111
B=3333333333333333333333333333333333333333
OTHER=2222222222222222222222222222222222222222
URL=https://github.com/o/r/pull/7
new_fix() { FIX="$WORK/fix"; rm -rf "$FIX"; mkdir -p "$FIX"; }
gate() { # gate <n> <exit> <jq object over a quiet default; $now is the epoch> [tip]
  local json
  json=$(jq -cn --arg tip "${4:-$A}" --argjson now "$(date +%s)" '{tip:$tip, wrapper_on_tip:0,
    unresolved_bot_threads:0, undispositioned_finding_comments:0, rerun_requested:false,
    retargeted_after_review:false, round_active:false, pending_review_on_tip:false,
    summary_running:null, summary_unknown_status:null, wrapper_epoch:null,
    last_request_epoch:null} + '"$3") || { echo "bad gate fixture: $3" >&2; exit 2; }
  printf '%s\n%s\n' "$2" "$json" > "$FIX/gate.$1"
}
view() { # view <n> <head> <statusCheckRollup JSON>
  jq -cn --arg u "$URL" --arg h "$2" --argjson r "$3" '{url:$u, headRefOid:$h, statusCheckRollup:$r}' > "$FIX/view.$1"
}
GREEN='[{"name":"ci","status":"COMPLETED","conclusion":"SUCCESS"}]'

check() { # check <name> <want exit> <want posts> <pr-watch args...>
  local name=$1 want=$2 wantc=$3; shift 3
  local got=0 c=0 bad=0
  PATH="$WORK/bin:$PATH" FIX="$FIX" timeout 60 "$WORK/scripts/pr-watch" 7 --interval 0 "$@" >/dev/null 2>&1 || got=$?
  if [ -f "$FIX/comments" ]; then
    c=$(grep -c '' "$FIX/comments")
    bad=$(grep -c -v -x -F "$URL @codex review" "$FIX/comments")   # only `@codex review`, only to the PR
  fi
  if [[ "$got" == "$want" && "$c" == "$wantc" && "$bad" == 0 ]]; then
    PASS=$((PASS+1)); printf '  ok   %-62s (exit %s, %s posted)\n' "$name" "$got" "$c"
  else
    FAIL=$((FAIL+1)); printf '  FAIL %-62s want exit %s/%s posted, got %s/%s (%s malformed)\n' "$name" "$want" "$wantc" "$got" "$c" "$bad"
  fi
}

echo "pr-watch fixtures"

new_fix; gate 1 0 '{wrapper_on_tip:1}'; view 1 "$A" "$GREEN"
check "admitted when the gate clears and checks are green" 0 0 --deadline 2

# A check that flips to green mid-test would prove nothing: a watcher that ignores pending
# checks admits on the first poll and exits 0 all the same. So hold it pending.
new_fix; gate 1 0 '{wrapper_on_tip:1}'; view 1 "$A" '[{"name":"ci","status":"IN_PROGRESS","conclusion":""}]'
check "a pending check holds admission" 8 0 --deadline 1

# ADR 0004: a paused CodeRabbit stays PENDING for ever, so its status must not hold the PR.
new_fix; gate 1 0 '{wrapper_on_tip:1}'
view 1 "$A" '[{"context":"CodeRabbit","state":"PENDING"},{"name":"ci","status":"COMPLETED","conclusion":"SUCCESS"}]'
check "a PENDING CodeRabbit status does not hold admission" 0 0 --deadline 2

new_fix; gate 1 0 '{wrapper_on_tip:1}'; view 1 "$A" '[]'
check "a PR with no checks is admitted" 0 0 --deadline 2
new_fix; gate 1 0 '{wrapper_on_tip:1}'; view 1 "$A" 'null'
check "a null rollup reads as no checks" 0 0 --deadline 2

new_fix; gate 1 0 '{wrapper_on_tip:1}'
check "an unreadable PR view never admits" 8 0 --deadline 1

# The printout is a second gate run; when it disagrees, exit 0 must not print BLOCKED.
new_fix; gate 1 0 '{wrapper_on_tip:1}'; view 1 "$A" "$GREEN"; echo 1 > "$FIX/human-rc"
check "no admission when the second gate run blocks" 8 0 --deadline 1

new_fix; gate 1 1 '{wrapper_on_tip:1, unresolved_bot_threads:1}'; view 1 "$A" "$GREEN"
check "an unresolved bot thread exits 1" 1 0 --deadline 2
new_fix; gate 1 1 '{wrapper_on_tip:1, undispositioned_finding_comments:1}'; view 1 "$A" "$GREEN"
check "an undispositioned finding comment exits 1" 1 0 --deadline 2

new_fix; gate 1 1 '{wrapper_on_tip:1}'; view 1 "$A" '[{"name":"ci","status":"COMPLETED","conclusion":"FAILURE"}]'
check "a failed check exits 5" 5 0 --deadline 2

# The anchor case from rloop-bash PR 9: the bot answered after the newest request, and the
# gate still needs a fresh one. Post once; the next poll waits on that post's answer.
new_fix
gate 1 1 '{wrapper_on_tip:1, rerun_requested:true, wrapper_epoch:($now-100), last_request_epoch:($now-200)}'
gate 2 1 '{wrapper_on_tip:1, rerun_requested:true, wrapper_epoch:($now-100), last_request_epoch:($now-200)}'
gate 3 0 '{wrapper_on_tip:2}'
view 1 "$A" "$GREEN"
check "an answered request the gate cannot credit gets one @codex review" 0 1 --deadline 4

# The same block, but the newest request is newer than every answer: its round has not
# reported yet, and a second request would only start a duplicate round.
new_fix; gate 1 1 '{wrapper_on_tip:1, rerun_requested:true, wrapper_epoch:($now-200), last_request_epoch:($now-100)}'
view 1 "$A" "$GREEN"
check "no request while the newest request is unanswered" 8 0 --no-round-after 3600 --deadline 1
new_fix; gate 1 1 '{wrapper_on_tip:1, rerun_requested:true, wrapper_epoch:($now-2000), last_request_epoch:($now-1000)}'
view 1 "$A" "$GREEN"
check "an unanswered request past --no-round-after exits 6" 6 0 --no-round-after 600 --deadline 2
# bot-gate counts a request in the wrapper's own second as unanswered; so must pr-watch.
new_fix; gate 1 1 '{wrapper_on_tip:1, rerun_requested:true, wrapper_epoch:($now-1000), last_request_epoch:($now-1000)}'
view 1 "$A" "$GREEN"
check "a request in the answer's own second reads unanswered" 6 0 --no-round-after 600 --deadline 2

new_fix
gate 1 1 '{wrapper_on_tip:1, retargeted_after_review:true, wrapper_epoch:($now-100)}'
gate 2 0 '{wrapper_on_tip:2}'
view 1 "$A" "$GREEN"
check "a retarget after the review gets one @codex review" 0 1 --deadline 4

new_fix
gate 1 1 '{wrapper_on_tip:1, rerun_requested:true, wrapper_epoch:($now-100), last_request_epoch:($now-200)}'
gate 2 1 '{wrapper_on_tip:2, rerun_requested:true, wrapper_epoch:($now+100), last_request_epoch:($now-200)}'
view 1 "$A" "$GREEN"
check "the bot answered this run's request and the gate still blocks: exit 9" 9 1 --deadline 4

# Right after a push no round has named the tip, and the bot often reviews a push itself.
# Requesting at once is what made every clean round need a second, anchoring request.
new_fix; gate 1 1 '{}'; view 1 "$A" "$GREEN"
check "no request before --no-round-after" 8 0 --no-round-after 3600 --deadline 1
new_fix; gate 1 1 '{}'; view 1 "$A" "$GREEN"
check "no round: one wake-up request, then exit 6 when still silent" 6 1 --no-round-after 0 --deadline 4

new_fix; gate 1 1 '{summary_running:"abc1234"}'; view 1 "$A" "$GREEN"
check "a round running past --stall-after exits 7" 7 0 --stall-after 0 --deadline 4
# Running for two 1-second polls, then not, then running again: the stall timer starts
# again, so two contiguous seconds never reach a 3-second --stall-after.
new_fix; gate 1 1 '{summary_running:"abc1234"}'; gate 2 1 '{summary_running:"abc1234"}'; gate 3 1 '{}'
gate 4 1 '{summary_running:"abc1234"}'; view 1 "$A" "$GREEN"
check "a round that stops running restarts the stall timer" 8 0 --interval 1 --stall-after 3 --no-round-after 3600 --deadline 5
new_fix; gate 1 1 '{wrapper_on_tip:1, pending_review_on_tip:true}'; view 1 "$A" "$GREEN"
check "a PENDING review counts as a running round" 7 0 --stall-after 0 --deadline 4
new_fix; gate 1 1 '{round_active:true}'; view 1 "$A" "$GREEN"
check "a running round is not woken" 8 0 --no-round-after 0 --stall-after 3600 --deadline 1
new_fix; gate 1 1 '{wrapper_on_tip:1, round_active:true, rerun_requested:true, wrapper_epoch:($now-100), last_request_epoch:($now-200)}'
view 1 "$A" "$GREEN"
check "a running round is not anchored" 8 0 --stall-after 3600 --deadline 1

# With a round also active, so that only this rule, not the catch-all below, can exit 9.
new_fix; gate 1 1 '{wrapper_on_tip:1, round_active:true, summary_unknown_status:"Queued"}'; view 1 "$A" "$GREEN"
check "a summary status the gate cannot read exits 9" 9 0 --stall-after 3600 --deadline 2
# Reviewed, nothing pending, no request wanted, nothing running, and still exit 1: an
# undated wrapper, say. Nothing pr-watch can wait out, so it must not sleep to the deadline.
new_fix; gate 1 1 '{wrapper_on_tip:1}'; view 1 "$A" "$GREEN"
check "an exit 1 nothing explains exits 9" 9 0 --deadline 2
# Reviewed and a fresh request wanted, but neither the answer nor any request is dated.
new_fix; gate 1 1 '{wrapper_on_tip:1, rerun_requested:true}'; view 1 "$A" "$GREEN"
check "a fresh request wanted with nothing dated exits 9" 9 0 --deadline 2

new_fix; gate 1 3 '{}'; view 1 "$A" "$GREEN"
check "gate exit 3 three polls running exits 3" 3 0 --deadline 2
new_fix; gate 1 3 '{}'; gate 2 0 '{wrapper_on_tip:1}'; view 1 "$A" "$GREEN"
check "one transient gate exit 3 is retried" 0 0 --deadline 2
new_fix; gate 1 4 '{}'; view 1 "$A" "$GREEN"
check "gate exit 4 passes through" 4 0 --deadline 2
new_fix; gate 1 127 '{}'; view 1 "$A" "$GREEN"
check "a gate exit outside 0-4 exits 9" 9 0 --deadline 2
new_fix; echo 1 > "$FIX/gate.1"; view 1 "$A" "$GREEN"
# --deadline 0: one poll, so the exit cannot come from the post-refusal rule instead.
check "a gate exit 1 with no JSON exits 9" 9 0 --deadline 0

# A gh default repository that resolves another repository's PR 7 (a fork): its head is not
# the gated tip, so pr-watch neither posts to it nor admits on its checks.
new_fix; gate 1 1 '{wrapper_on_tip:1, rerun_requested:true, wrapper_epoch:($now-100), last_request_epoch:($now-200)}'
view 1 "$OTHER" "$GREEN"
check "never posts to a PR whose head is not the gated tip, and says so" 9 0 --deadline 2
# One failed post is retried on the next poll; a second failure on the tip exits.
ANCHOR='{wrapper_on_tip:1, rerun_requested:true, wrapper_epoch:($now-100), last_request_epoch:($now-200)}'
new_fix; gate 1 1 "$ANCHOR"; gate 2 1 "$ANCHOR"; gate 3 0 '{wrapper_on_tip:2}'; view 1 "$A" "$GREEN"
echo 1 > "$FIX/comment-fails"
check "one failed post is retried" 0 1 --deadline 4
new_fix; gate 1 1 "$ANCHOR"; view 1 "$A" "$GREEN"; echo 99 > "$FIX/comment-fails"
check "a post that keeps failing exits 9" 9 0 --deadline 2
# ...and per tip: a failure on the old tip does not count against the new one.
new_fix; gate 1 1 "$ANCHOR" "$A"; gate 2 1 "$ANCHOR" "$B"; gate 3 1 "$ANCHOR" "$B"; gate 4 0 '{wrapper_on_tip:2}' "$B"
view 1 "$A" "$GREEN"; view 2 "$B" "$GREEN"; echo 2 > "$FIX/comment-fails"
check "the failed-post count starts again on a new tip" 0 1 --deadline 4
new_fix; gate 1 0 '{wrapper_on_tip:1}'; view 1 "$OTHER" "$GREEN"
check "never admits on the checks of a head that is not the gated tip" 8 0 --deadline 1

# A push during the run: the new tip gets its own wake-up request, not the old tip's guard.
new_fix; gate 1 1 '{}' "$A"; gate 2 1 '{}' "$B"; view 1 "$A" "$GREEN"; view 2 "$B" "$GREEN"
check "a new tip gets its own wake-up request" 6 2 --no-round-after 0 --deadline 4
# ...and its own timer: the wake-up comes --no-round-after from the push, not from the run's
# start. Tip A for five 1-second polls, then tip B, with a 3-second wait and a 6-second run.
new_fix
for n in 1 2 3 4 5; do gate "$n" 1 '{}' "$A"; view "$n" "$A" "$GREEN"; done
gate 6 1 '{}' "$B"; view 6 "$B" "$GREEN"
check "a new tip's wake-up waits from when it was first seen" 8 1 --interval 1 --no-round-after 3 --deadline 6

new_fix; view 1 "$A" "$GREEN"
for args in "" "7 --interval" "7 --deadline x"; do
  got=0; PATH="$WORK/bin:$PATH" FIX="$FIX" timeout 10 "$WORK/scripts/pr-watch" $args >/dev/null 2>&1 || got=$?
  if [[ "$got" == 2 ]]; then PASS=$((PASS+1)); printf '  ok   usage error, exit 2: pr-watch %s\n' "$args"
  else FAIL=$((FAIL+1)); printf '  FAIL usage error for "pr-watch %s": got %s\n' "$args" "$got"; fi
done

echo "passed $PASS, failed $FAIL"
[[ "$FAIL" == 0 ]]

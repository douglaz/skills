command cat >"$b/tls.key" <<'TLS_PRIVATE_KEY'
-----BEGIN PRIVATE KEY-----
MIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQCzBpYIrorf++3q

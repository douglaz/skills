#!/usr/bin/env bash
# cfastlane.test — offline checks for the packet meter, the commit and receipt scripts
# and the session launcher. Model transcripts are fixtures, `systemctl` and fastlane's launch-unit.sh
# are stubs that log their arguments, and git runs in a throwaway repository. Starts no unit and no model.
#
# Usage: ./cfastlane.test          (exits 0 if all pass)

set -uo pipefail
HERE=$(cd "$(dirname "$0")" && pwd)
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
PASS=0; FAIL=0
unset FASTLANE_SEATS  # the default seats unless a check sets the switch
ok() { PASS=$((PASS+1)); printf '  ok   %s\n' "$1"; }
bad() { FAIL=$((FAIL+1)); printf '  FAIL %s\n' "$1"; }
check() { if eval "$2"; then ok "$1"; else bad "$1"; fi; }

mkdir -p "$WORK/bin" "$WORK/fl"
cat > "$WORK/bin/systemctl" <<'STUB'
#!/usr/bin/env bash
echo "$*" >> "$FIX/systemctl"
STUB
cat > "$WORK/fl/launch-unit.sh" <<'STUB'
#!/usr/bin/env bash
echo "$*" >> "$FIX/launches"
STUB
# The review stub logs a launch like the launcher; its seat-list check is fastlane's real one.
cat > "$WORK/fl/review.sh" <<STUB
#!/usr/bin/env bash
if [ "\$1" = --seats ]; then exec "$HERE/../../fastlane/scripts/review.sh" --seats; fi
echo "\$*" >> "\$FIX/launches"
STUB
# Model CLIs found on PATH are stubs that never reach a model; tests that run a command add their own.
for tool in codex claude; do printf '#!/bin/sh\nexit 99\n' > "$WORK/bin/$tool"; chmod +x "$WORK/bin/$tool"; done
cp "$HERE/../../fastlane/scripts/wait.sh" "$WORK/fl/wait.sh"
mkdir -p "$WORK/references"
cp "$HERE/../../fastlane/references/prompts.md" "$WORK/references/prompts.md"
chmod +x "$WORK/bin/systemctl" "$WORK/fl/launch-unit.sh" "$WORK/fl/review.sh"
PATH="$WORK/bin:$PATH"
export CFASTLANE_FASTLANE_SCRIPTS=$WORK/fl
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null

codex_session() { # NAME CWD INPUT CACHED OUTPUT; NAME is also the recorded session id
  local d=$CFASTLANE_CODEX_SESSIONS/2026/01/01; mkdir -p "$d"
  { printf '{"type":"session_meta","payload":{"id":"%s","cwd":"%s"}}\n' "$1" "$2"
    printf '{"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":1,"cached_input_tokens":0,"output_tokens":1,"total_tokens":2}}}}\n'
    printf '{"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":%s,"cached_input_tokens":%s,"output_tokens":%s,"total_tokens":%s}}}}\n' "$3" "$4" "$5" "$(($3 + $5))"
  } > "$d/$1.jsonl"
}
claude_session() { # NAME CWD  (two records of one message, then another message)
  local d=$CFASTLANE_CLAUDE_PROJECTS/${2//[^A-Za-z0-9]/-}; mkdir -p "$d"
  { printf '{"type":"assistant","timestamp":"2026-01-01T00:00:01Z","message":{"id":"m1","usage":{"input_tokens":5,"cache_creation_input_tokens":5,"cache_read_input_tokens":900,"output_tokens":1}}}\n'
    printf '{"type":"assistant","timestamp":"2026-01-01T00:00:02Z","message":{"id":"m1","usage":{"input_tokens":10,"cache_creation_input_tokens":90,"cache_read_input_tokens":900,"output_tokens":50}}}\n'
    printf '{"type":"assistant","timestamp":"2026-01-01T00:00:09Z","message":{"id":"m2","usage":{"input_tokens":20,"cache_creation_input_tokens":0,"cache_read_input_tokens":0,"output_tokens":30}}}\n'
  } > "$d/$1.jsonl"
}
new_fix() { # a packet, a clean worktree with one commit, empty transcript stores
  FIX="$WORK/fix"; rm -rf "$FIX"; mkdir -p "$FIX/pkt" "$FIX/wt/src" "$FIX/elsewhere"
  export FIX CFASTLANE_CODEX_SESSIONS=$FIX/codex CFASTLANE_CLAUDE_PROJECTS=$FIX/claude
  mkdir -p "$CFASTLANE_CODEX_SESSIONS" "$CFASTLANE_CLAUDE_PROJECTS"
  : > "$FIX/systemctl"; : > "$FIX/launches"
  git -C "$FIX/wt" init -q
  echo one > "$FIX/wt/src/a.txt"
  git -C "$FIX/wt" add -A
  git -C "$FIX/wt" -c user.name=t -c user.email=t@t commit -q -m base
  cat > "$FIX/pkt/config.json" <<EOF
{"name": "p1", "worktree": "$FIX/wt", 
 "banned_text": "forbidden", "allowed_paths": ["src/"], "identity": {"name": "Tester", "email": "t@example.org"}}
EOF
  echo 0 > "$FIX/pkt/meter-start"; echo 0 > "$FIX/pkt/review-start"
  git -C "$FIX/wt" rev-parse HEAD > "$FIX/pkt/base"
}
new_tokens() { python3 -I "$HERE/meter.py" "$FIX/pkt" "$@" | python3 -I -c 'import json,sys; print(json.load(sys.stdin)["new_tokens"])'; }
review_brief() {
  sed -n '/^# Review iN:/,/^```$/ { /^```$/d; p; }' "$WORK/references/prompts.md" > "$FIX/pkt/review-brief.md"
}

echo "meter"
new_fix
mkdir -p "$FIX/pkt/turns/1/session"
echo 'session id: combined' > "$FIX/pkt/turns/1/session/err"
codex_session combined "$FIX/wt" 1000 700 50             # 350 new
codex_session in-packet "$FIX/pkt" 100 0 10              # 110 new
codex_session other-project "$FIX/elsewhere" 9000 0 9000 # not ours
check "session reading selects only the combined id, last counter only" '[ "$(new_tokens)" = 350 ]'
check "writes meter.json" '[ -s "$FIX/pkt/meter.json" ]'
date -d "+1 hour" +%s > "$FIX/pkt/meter-start"
check "ignores sessions written before the start stamp" '[ "$(new_tokens)" = 0 ]'
echo 0 > "$FIX/pkt/meter-start"
claude_session reviewer "$FIX/wt"                        # m1 final 150, m2 50 = 200 new
check "review phase adds Claude reviewers and excludes the combined session" '[ "$(new_tokens --phase review)" = 310 ]'
check "session phase excludes all reviewer transcripts" '[ "$(new_tokens)" = 350 ]'
codex_session combined "$FIX/wt" 1100 700 50             # resumed after reviewers: 450 new
check "resumed combined session never leaks into reviewer totals" '[ "$(new_tokens)" = 450 ] && [ "$(new_tokens --phase review)" = 310 ]'
T=$(python3 -I "$HERE/meter.py" --claude-transcript "$CFASTLANE_CLAUDE_PROJECTS"/*/reviewer.jsonl --since 2026-01-01T00:00:05Z)
check "a single transcript can be metered from a time on" '[[ "$T" == *"\"new\": 50"* ]]'
new_fix
mkdir -p "$FIX/pkt/turns/1/session"
CID=0b6f1c9e-0000-4000-8000-000000000001
printf 'session id: %s\n' "$CID" > "$FIX/pkt/turns/1/session/err"
claude_session "$CID" "$FIX/wt"                          # the claude-engine session: 200 new
claude_session reviewer "$FIX/wt"                        # an opus reviewer: 200 new
codex_session astra "$FIX/pkt" 100 0 10                  # a codex reviewer: 110 new
check "a claude-engine session is metered by its transcript, reviewers excluded" '[ "$(new_tokens)" = 200 ]'
check "the review phase excludes the claude-engine session" '[ "$(new_tokens --phase review)" = 310 ]'

echo "commit and receipt"
new_fix
echo "a forbidden word" > "$FIX/wt/src/b.txt"
echo "Add b" > "$FIX/pkt/commit-subject.txt"; echo "Body." > "$FIX/pkt/commit-body.txt"
python3 -I "$HERE/close.py" "$FIX/pkt" commit > "$FIX/close.out" 2> "$FIX/close.err"; RC=$?
check "blocks banned text in an added line" "[ $RC != 0 ] && grep -q 'banned text in added lines' '$FIX/close.err'"
check "a blocked commit leaves HEAD on the base" '[ "$(git -C "$FIX/wt" rev-parse HEAD)" = "$(cat "$FIX/pkt/base")" ]'
echo fine > "$FIX/wt/src/b.txt"; echo stray > "$FIX/wt/top.txt"
python3 -I "$HERE/close.py" "$FIX/pkt" check > "$FIX/close.out" 2> "$FIX/close.err"; RC=$?
check "blocks a file outside the allowed paths" "[ $RC != 0 ] && grep -q 'outside the allowed paths' '$FIX/close.err'"
rm "$FIX/wt/top.txt"
python3 -I "$HERE/close.py" "$FIX/pkt" check > "$FIX/close.out" 2> "$FIX/close.err"; RC=$?
check "check mode passes clean work and commits nothing" "[ $RC = 0 ] && [ ! -e '$FIX/pkt/candidate' ]"
python3 -I "$HERE/close.py" "$FIX/pkt" commit > "$FIX/close.out" 2> "$FIX/close.err"; RC=$?
check "commits clean work with the configured identity" "[ $RC = 0 ] && [ \"\$(git -C '$FIX/wt' log -1 --format='%an <%ae> %s')\" = 'Tester <t@example.org> Add b' ]"
check "records the candidate commit" '[ "$(cat "$FIX/pkt/candidate")" = "$(git -C "$FIX/wt" rev-parse HEAD)" ]'
echo repair > "$FIX/wt/src/c.txt"; echo "Repair c" > "$FIX/pkt/commit-subject.txt"
python3 -I "$HERE/close.py" "$FIX/pkt" commit > "$FIX/close.out" 2> "$FIX/close.err"; RC=$?
check "a repair turn's work commits on top of the last candidate" "[ $RC = 0 ] && [ \"\$(git -C '$FIX/wt' log -1 --format=%s)\" = 'Repair c' ] && [ \"\$(cat '$FIX/pkt/candidate')\" = \"\$(git -C '$FIX/wt' rev-parse HEAD)\" ]"
check "the repair commit's scans cover only the new work" "grep -q 'src/c.txt' '$FIX/close.out' && ! grep -q 'src/b.txt' '$FIX/close.out'"
echo sneaky > "$FIX/wt/src/d.txt"; git -C "$FIX/wt" add -A
git -C "$FIX/wt" -c user.name=s -c user.email=s@s commit -q -m "session commits by itself"
echo more > "$FIX/wt/src/e.txt"
python3 -I "$HERE/close.py" "$FIX/pkt" check > /dev/null 2> "$FIX/close.err"; RC=$?
check "refuses when the session committed by itself" "[ $RC != 0 ] && grep -q 'HEAD moved off the expected commit' '$FIX/close.err'"
git -C "$FIX/wt" reset -q --hard "$(cat "$FIX/pkt/candidate")"; rm "$FIX/wt/src/e.txt"
git -C "$FIX/wt" diff "$(cat "$FIX/pkt/base")" HEAD > "$FIX/pkt/diff.patch"
echo '{"exit": 0}' > "$FIX/pkt/summary.json"
python3 -I "$HERE/receipt.py" "$FIX/pkt" "$FIX/pkt/summary.json" > "$FIX/receipt.out"; RC=$?
M=$FIX/pkt/manifest.json
check "writes a manifest naming the candidate, a clean tree and the diff hash" "[ $RC = 0 ] && grep -q '\"commit_is_candidate\": true' '$M' && grep -q '\"worktree_clean\": true' '$M' && grep -q \"\$(sha256sum '$FIX/pkt/diff.patch' | cut -d' ' -f1)\" '$M'"
check "the manifest carries the evidence file's hash and content" "grep -q \"\$(sha256sum '$FIX/pkt/summary.json' | cut -d' ' -f1)\" '$M' && grep -q '\"exit\": 0' '$M'"

echo "submodule refusal"
# Origins: parent holds sub, which holds inner. Local submodules need protocol.file.allow.
SM=$WORK/sm
G() { git -c protocol.file.allow=always -c user.name=t -c user.email=t@t "$@"; }
G init -q "$SM/inner"; echo inner > "$SM/inner/i.txt"; G -C "$SM/inner" add -A; G -C "$SM/inner" commit -q -m inner
G init -q "$SM/sub"; echo sub > "$SM/sub/s.txt"; G -C "$SM/sub" submodule add -q "$SM/inner" inner 2> /dev/null
G -C "$SM/sub" add -A; G -C "$SM/sub" commit -q -m sub
G init -q "$SM/parent"; echo readme > "$SM/parent/README"; G -C "$SM/parent" submodule add -q "$SM/sub" sub 2> /dev/null
G -C "$SM/parent" commit -q -m parent
sm_case() { # [--shallow]: a fresh clone of the parent (recursive unless --shallow), its packet and a parent edit
  FIX=$WORK/smfix; rm -rf "$FIX"; mkdir -p "$FIX/pkt"
  if [ "${1:-}" = --shallow ]; then G clone -q "$SM/parent" "$FIX/wt"; else G clone -q --recursive "$SM/parent" "$FIX/wt" 2> /dev/null; fi
  printf '{"name": "p1", "worktree": "%s", "identity": {"name": "Tester", "email": "t@example.org"}}\n' "$FIX/wt" > "$FIX/pkt/config.json"
  git -C "$FIX/wt" rev-parse HEAD > "$FIX/pkt/base"
  echo "Parent edit" > "$FIX/pkt/commit-subject.txt"
  echo readme-2 > "$FIX/wt/README"
  echo new > "$FIX/wt/NEW"  # untracked, so any staging before a refusal (even `add -N`) changes the index
}
sm_close() { # MODE: run close.py, keeping the index before and after
  git -C "$FIX/wt" ls-files -s > "$FIX/index-before"
  python3 -I "$HERE/close.py" "$FIX/pkt" "$1" > "$FIX/close.out" 2> "$FIX/close.err"; RC=$?
  git -C "$FIX/wt" ls-files -s > "$FIX/index-after"
}
refused() { # PATH: exit 1 with a blocked line naming exactly PATH; HEAD, index and candidate untouched
  [ "$RC" = 1 ] && [ "$(tail -n 1 "$FIX/close.err")" = "blocked: submodules with uncommitted or untracked files: $1" ] &&
    [ "$(git -C "$FIX/wt" rev-parse HEAD)" = "$(cat "$FIX/pkt/base")" ] &&
    cmp -s "$FIX/index-before" "$FIX/index-after" && [ ! -e "$FIX/pkt/candidate" ]
}
committed() { # exit 0, a new parent commit recorded as the candidate
  [ "$RC" = 0 ] && [ "$(git -C "$FIX/wt" rev-parse HEAD)" != "$(cat "$FIX/pkt/base")" ] &&
    [ "$(cat "$FIX/pkt/candidate")" = "$(git -C "$FIX/wt" rev-parse HEAD)" ]
}
for mode in check commit; do
  sm_case; echo dirty > "$FIX/wt/sub/s.txt"
  sm_close "$mode"; check "$mode mode refuses a modified tracked file in a submodule, naming it" 'refused sub'
  sm_case; echo stray > "$FIX/wt/sub/new.txt"
  sm_close "$mode"; check "$mode mode refuses an untracked file in a submodule, naming it" 'refused sub'
done
sm_case; echo dirty > "$FIX/wt/sub/inner/i.txt"
sm_close commit; check "a dirty nested submodule is named by its path from the parent" 'refused sub/inner'
sm_case; echo stray > "$FIX/wt/sub/inner/new.txt"
sm_close check; check "an untracked file in a nested submodule is named by its nested path" 'refused sub/inner'
sm_case; git -C "$FIX/wt" config -f .gitmodules submodule.sub.ignore all; echo dirty > "$FIX/wt/sub/s.txt"
sm_close commit; check "a .gitmodules ignore = all does not hide a modified submodule file" 'refused sub'
sm_case; git -C "$FIX/wt" config submodule.sub.ignore dirty; echo stray > "$FIX/wt/sub/new.txt"
sm_close commit; check "a config ignore = dirty does not hide an untracked submodule file" 'refused sub'
sm_case
sm_close commit; check "a clean submodule still commits" 'committed'
sm_case; echo sub-2 > "$FIX/wt/sub/s.txt"; G -C "$FIX/wt/sub" commit -q -am "sub 2"
sm_close commit
check "a gitlink moved over a clean submodule commits and records the new submodule commit" \
  'committed && [ "$(git -C "$FIX/wt" ls-tree HEAD sub | cut -d" " -f3 | cut -f1)" = "$(git -C "$FIX/wt/sub" rev-parse HEAD)" ]'
sm_case --shallow
sm_close commit; check "an uninitialized submodule does not block" 'committed'

echo "session launcher"
new_fix
echo task > "$FIX/pkt/task.md"; rm "$FIX/pkt/meter-start" "$FIX/pkt/base"
echo dirty > "$FIX/wt/src/a.txt"
sh "$HERE/session.sh" "$FIX/pkt" > /dev/null 2>&1; RC=$?
check "keeps an inherited uncommitted candidate, like fastlane" '[ "$RC" = 0 ] && [ "$(cat "$FIX/wt/src/a.txt")" = dirty ]'
check "first turn stamps the meter and the base" "[ $RC = 0 ] && [ -s '$FIX/pkt/meter-start' ] && [ \"\$(cat '$FIX/pkt/base')\" = \"\$(git -C '$FIX/wt' rev-parse HEAD)\" ]"
check "starts exactly one unit, the session, in the worktree" '[ "$(wc -l < "$FIX/launches")" = 1 ] && sed -n 1p "$FIX/launches" | grep -q "^cfl-p1-s1 .* exec --color never --dangerously"'
check "the session runs sol at effort high" 'sed -n 1p "$FIX/launches" | grep -q -- "-m gpt-6.2-sol -c model_reasoning_effort=high"'
check "turn timeout permits implementation and review rounds" 'grep -q "21600 .* exec" "$FIX/launches"'
check "session owns review launch, waits, judgment and repairs" 'grep -q "review.sh $FIX/pkt .*Wait on required seats.*judge every finding, repair eligible P0/P1 and re-review" "$FIX/launches"'
check "session receives exact fixed-template source and skill rules" 'grep -q "Read .*SKILL.md for the review and wait rules, and read $WORK/fl/../references/prompts.md for the exact fixed review template" "$FIX/launches"'
check "session receives fresh retry command and waits on current output" 'grep -q -- "review.sh $FIX/pkt --out <fresh-output> --tag <fresh-tag>.*Wait on the required seat directories under the --out just launched" "$FIX/launches"'
check "session stops early only for a named obstacle, never for remaining work" 'grep -q "End the turn early only for a named obstacle.*Work that merely remains is not an obstacle" "$FIX/launches"'
check "session reviews only a complete candidate" 'grep -q "Review only a complete candidate.*Once the candidate is complete, write the review brief" "$FIX/launches"'
check "session collects its readers before ending" 'grep -q "Before ending, collect and judge every required reader you launched unless that wait would pass the turn.s limit" "$FIX/launches"'
check "without FASTLANE_SEATS the prompt keeps the default seats" 'grep -Fq "run $HERE/review.sh $FIX/pkt (it probes grok)" "$FIX/launches" && ! grep -q "review seats are" "$FIX/launches"'
echo note > "$FIX/note.md"
sh "$HERE/session.sh" "$FIX/pkt" "$FIX/note.md" > /dev/null 2>&1; check "refuses a resume while the last turn has no exit file" "[ $? = 3 ]"
mkdir -p "$FIX/pkt/turns/1/session"; echo "success exited 0" > "$FIX/pkt/turns/1/session/exit"
printf 'banner\nsession id: abc-123\n' > "$FIX/pkt/turns/1/session/err"
sh "$HERE/session.sh" "$FIX/pkt" > /dev/null 2>&1; check "a later turn needs a note file" "[ $? = 2 ]"
sh "$HERE/session.sh" "$FIX/pkt" "$FIX/note.md" > /dev/null 2>&1; RC=$?
check "a later turn resumes the same session as a new unit" "[ $RC = 0 ] && sed -n 2p '$FIX/launches' | grep -q '^cfl-p1-s2 .* exec --color never resume abc-123 '"
check "resume retains review ownership and the fixed-brief guard" 'sed -n 2p "$FIX/launches" | grep -q "write the review brief from the fixed fastlane template.*judge every finding"'
check "resume retains the early-stop and complete-candidate rules" 'sed -n 2p "$FIX/launches" | grep -q "End the turn early only for a named obstacle.*Review only a complete candidate"'

for turn in 1 2; do
  PROMPT=$(sed -n "${turn}p" "$FIX/launches")
  check "turn $turn runs whole named checks with other tests suspended" '[[ "$PROMPT" == *"Run every check the task names as required, in full, including its tests. That is never a reason to stop. Other tests are suspended"* && "$PROMPT" == *"For standalone builds, compile only what the task says gets deployed"* ]]'
  check "turn $turn counts each stage and live retry separately" '[[ "$PROMPT" == *"three for product code, two for test tooling and two for tests-back"* && "$PROMPT" == *"Count each separately committed stage from one, retaining the count across resumes in the stage. Start at one after a failed live test."* ]]'
  check "turn $turn hands off capped findings and repairs exceptions" '[[ "$PROMPT" == *"At the cap, put every open finding in $FIX/pkt/followups.md"* && "$PROMPT" == *"Keep P0/P1 at their own priorities with the review-followup label. Findings touching money, data loss, machine deletion, secrets, broken core function or a check that can pass when it should fail still get a fix and another round."* ]]'
  check "turn $turn preserves the P0/P1 owner guard" '[[ "$PROMPT" == *"Never lower a reviewer"*"P0/P1 without the owner"* ]]'
  check "turn $turn finishes independent work before relaying owner calls" '[[ "$PROMPT" == *"finish independent work, look ahead for other owner decisions and report all calls together with a recommendation and evidence for each."* ]]'
  check "turn $turn routes contradictions and runs a baseline before proposing changes" '[[ "$PROMPT" == *"Send contradictions within the packet brief, including task versus live-test instructions, to the assistant. Record preexisting gaps or defects in the handoff and continue. Before proposing a requirement change, run a baseline"* ]]'
  check "turn $turn reads the notes before each review, repair and handoff" '[[ "$PROMPT" == *"Read $FIX/pkt/notes.md if present before each review round, before each repair and before writing the handoff."* ]]'
  check "turn $turn uses the fixed follow-up entry format" '[[ "$PROMPT" == *"Write all follow-ups in the fixed entry format in $WORK/fl/../references/prompts.md."* ]]'
  check "turn $turn uses fresh output for the first review of a new stage" '[[ "$PROMPT" == *"for each new launch, including a new stage"*"first round or a seat retry. Use a fresh output directory and tag."* ]]'
  check "turn $turn records check evidence before opening each review" '[[ "$PROMPT" == *"Before each review, put the current candidate"*"required check commands and exits in $FIX/pkt/handoff.md. Refresh checks a repair can affect before re-review."* ]]'
done
check "resume rereads corrected packet files" '[[ "$PROMPT" == *"the current $FIX/pkt/task.md in full. Re-read any corrected packet files the note names"* ]]'
mkdir -p "$FIX/pkt/turns/2/session"; echo "success exited 0" > "$FIX/pkt/turns/2/session/exit"
env FASTLANE_TESTS=on sh "$HERE/session.sh" "$FIX/pkt" "$FIX/note.md" > /dev/null 2>&1; RC=$?
check "after the live pass a resume can bring tests back" '[ "$RC" = 0 ] && sed -n 3p "$FIX/launches" | grep -q "Tests are back: run, fix, edit or add tests only as the task file says"'
check "tests-back close matches the new diff and commits before filing" 'grep -Fq "match its SHA to the new reviewed diff" "$HERE/../SKILL.md" && grep -Eq "close.py PKT commit. again before filing follow-ups" "$HERE/../SKILL.md"'
PROMPT=$(sed -n 3p "$FIX/launches")
check "a complete tests-back run at the clean accepted commit skips review and close" \
  '[[ "$PROMPT" == *"If tests-back is complete, HEAD is the last accepted candidate in $FIX/pkt/candidate"*"and git status --porcelain --untracked-files=all --ignore-submodules=none succeeds with empty output, record the suite result and finish the handoff without a new review."* ]] &&
   grep -Fq "is complete, HEAD matches" "$HERE/../SKILL.md" &&
   grep -Fq -- "git status --porcelain --untracked-files=all --ignore-submodules=none" "$HERE/../SKILL.md" &&
   grep -Fq "finish the handoff without a new review or close" "$HERE/../SKILL.md"'
check "the launcher, task and resume note honor the tests-back exception" \
  '[[ "$PROMPT" == *"If completing tests-back with the no-change handoff above, skip these review steps."* ]] &&
   grep -Fq "review it unless the tests-back no-change" "$HERE/../references/prompts.md" &&
   grep -Fq "unless the tests-back no-change handoff applies" "$HERE/../references/prompts.md"'
check "tests-back keeps tests on across every resume" 'grep -Fq "on every resume within tests-back" "$HERE/../SKILL.md"'
check "every session turn uses the filter-aware wait" 'grep -Fq "Wait for each session turn with" "$HERE/../SKILL.md" && grep -Fq -- "--wait <deadline_seconds> PKT/turns/N/session" "$HERE/../SKILL.md"'

echo "session wait"
TURN="$FIX/pkt/turns/3/session"
mkdir -p "$TURN"
# Codex CLI 0.172.0, human output, observed with a local response.incomplete SSE fixture.
FILTER_ERROR='ERROR: stream disconnected before completion: Incomplete response returned, reason: content_filter'
wait_session() {
  sh "$HERE/session.sh" --wait 0 "$TURN" >"$FIX/wait.out" 2>"$FIX/wait.err"
  WAIT_RC=$?
}
printf '%s\n' "$FILTER_ERROR" "$FILTER_ERROR" "tokens used" "24" > "$TURN/err"
echo "exit-code exited 1" > "$TURN/exit"
wait_session
check "terminal provider error reports CONTENT_FILTER and exit 4" '[ "$WAIT_RC" = 4 ] && grep -Fxq "CONTENT_FILTER $TURN" "$FIX/wait.out"'
echo "ERROR: stream disconnected before completion: stream closed before response.completed" >> "$TURN/err"
wait_session
check "a later transport error remains an ordinary failure" '[ "$WAIT_RC" = 1 ] && ! grep -q "^CONTENT_FILTER " "$FIX/wait.out"'
printf 'The task mentions content_filter.\n' > "$TURN/err"
wait_session
check "a mention of the filter is insufficient" '[ "$WAIT_RC" = 1 ] && ! grep -q "^CONTENT_FILTER " "$FIX/wait.out"'
echo "$FILTER_ERROR" > "$TURN/err"
echo "success killed TERM" > "$TURN/exit"
wait_session
check "a deliberate stop remains exit 1" '[ "$WAIT_RC" = 1 ] && ! grep -q "^CONTENT_FILTER " "$FIX/wait.out"'
echo "success exited 0" > "$TURN/exit"
wait_session
check "a successful turn stays successful" '[ "$WAIT_RC" = 0 ] && ! grep -q "^CONTENT_FILTER " "$FIX/wait.out"'
rm "$TURN/exit"
wait_session
check "unknown session state stays unknown" '[ "$WAIT_RC" = 2 ] && ! grep -q "^CONTENT_FILTER " "$FIX/wait.out"'
echo "$FILTER_ERROR" > "$TURN/err"; echo "exit-code exited 1" > "$TURN/exit"; echo claude > "$TURN/engine"
wait_session
check "the content-filter exit is codex-only: a claude turn's failure stays exit 1" '[ "$WAIT_RC" = 1 ] && ! grep -q "^CONTENT_FILTER " "$FIX/wait.out"'

echo "claude engine"
new_fix
echo task > "$FIX/pkt/task.md"; rm "$FIX/pkt/meter-start" "$FIX/pkt/base"
env CFASTLANE_ENGINE=opus sh "$HERE/session.sh" "$FIX/pkt" > /dev/null 2> "$FIX/session.err"; RC=$?
check "an unknown engine is refused and starts nothing" '[ "$RC" = 2 ] && grep -q "CFASTLANE_ENGINE must be codex or claude" "$FIX/session.err" && [ ! -s "$FIX/launches" ] && [ ! -e "$FIX/pkt/turns" ]'
env CFASTLANE_ENGINE=claude sh "$HERE/session.sh" "$FIX/pkt" > /dev/null 2>&1; RC=$?
L=$(sed -n 1p "$FIX/launches")
SID=$(sed -n 's/.* --session-id \([0-9a-f-]*\) .*/\1/p' <<<"$L")
check "CFASTLANE_ENGINE=claude starts one Opus session at effort high with a fresh session id" \
  '[ "$RC" = 0 ] && [ "$(wc -l < "$FIX/launches")" = 1 ] && [[ "$SID" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$ ]] &&
   [[ "$L" == "cfl-p1-s1 $FIX/pkt/turns/1/session --stdout $FIX/pkt/turns/1/session/answer.md -- /bin/sh -c "*" $SID "*" -u CLAUDE_CODE_AUTO_COMPACT_WINDOW BASH_MAX_TIMEOUT_MS=3600000 "*"timeout 21600 "*"claude -p Read the task file $FIX/pkt/task.md"*" --session-id $SID --model claude-opus-5-5 --effort high --dangerously-skip-permissions --strict-mcp-config --mcp-config"* ]]'
check "the claude session keeps its transcript and the long-session cache" '[[ "$L" != *"--no-session-persistence"* && "$L" != *"CLAUDE_CODE_PROMPT_CACHE_TTL"* && "$L" != *" exec --color"* ]]'
check "the claude session gets the same review-owning prompt" '[[ "$L" == *"End the turn early only for a named obstacle"*"Review only a complete candidate"*"judge every finding, repair eligible P0/P1 and re-review"* ]]'
check "the claude session is told to follow the project's AGENTS.md" '[[ "$L" == *"Read and follow every AGENTS.md from the repository root down to $FIX/wt."* ]]'
check "the first turn records its engine" '[ "$(cat "$FIX/pkt/turns/1/session/engine")" = claude ]'

# Run the launched command for real, with a stub claude, to see the wrapper record the session id.
mkdir -p "$WORK/flx" "$WORK/xbin" "$WORK/home"
cat > "$WORK/flx/launch-unit.sh" <<'STUB'
#!/usr/bin/env bash
echo "$*" >> "$FIX/launches"
dir=$2; out=$2/out; shift 2
if [ "$1" = --stdout ]; then out=$2; shift 2; fi
shift
mkdir -p "$dir"
"$@" > "$out" 2> "$dir/err"; echo "exited $?" > "$dir/exit"
STUB
cat > "$WORK/xbin/claude" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$FIX/claude-args"
printf 'compact=%s max=%s\n' "${CLAUDE_CODE_AUTO_COMPACT_WINDOW-unset}" "${BASH_MAX_TIMEOUT_MS-unset}" >> "$FIX/claude-env"
echo "final message"
STUB
chmod +x "$WORK/flx/launch-unit.sh" "$WORK/xbin/claude"
cp "$WORK/fl/wait.sh" "$WORK/flx/wait.sh"
xrun() { env HOME="$WORK/home" PATH="$WORK/xbin:$PATH" CFASTLANE_FASTLANE_SCRIPTS="$WORK/flx" CLAUDE_CODE_AUTO_COMPACT_WINDOW=1 "$@"; }
new_fix
echo task > "$FIX/pkt/task.md"; rm "$FIX/pkt/meter-start" "$FIX/pkt/base"
xrun env CFASTLANE_ENGINE=claude sh "$HERE/session.sh" "$FIX/pkt" > /dev/null 2>&1; RC=$?
SID=$(sed -n 's/.*--session-id \([0-9a-f-]*\) .*/\1/p' "$FIX/claude-args")
check "the session id is recorded in err, where codex prints its own" \
  '[ "$RC" = 0 ] && [ -n "$SID" ] && [ "$(cat "$FIX/pkt/turns/1/session/err")" = "session id: $SID" ] && [ "$(cat "$FIX/pkt/turns/1/session/answer.md")" = "final message" ]'
check "claude runs without the auto-compact override and with hour-long shell calls" '[ "$(cat "$FIX/claude-env")" = "compact=unset max=3600000" ]'
echo note > "$FIX/note.md"
xrun sh "$HERE/session.sh" "$FIX/pkt" "$FIX/note.md" > /dev/null 2>&1; RC=$?
R=$(sed -n 2p "$FIX/claude-args")
check "a resume without CFASTLANE_ENGINE resumes the same claude session" \
  '[ "$RC" = 0 ] && [[ "$R" == "-p Read the note $FIX/note.md"*" --resume $SID --model claude-opus-5-5 --effort high"* && "$R" != *"--session-id"* ]] &&
   [ "$(cat "$FIX/pkt/turns/2/session/err")" = "session id: $SID" ] && [ "$(cat "$FIX/pkt/turns/2/session/engine")" = claude ]'
xrun env CFASTLANE_ENGINE=codex sh "$HERE/session.sh" "$FIX/pkt" "$FIX/note.md" > /dev/null 2> "$FIX/session.err"; RC=$?
check "a resume on the other engine is refused and starts nothing" \
  '[ "$RC" = 2 ] && grep -q "started on claude and resumes only there" "$FIX/session.err" && [ ! -e "$FIX/pkt/turns/3" ] && [ "$(wc -l < "$FIX/claude-args")" = 2 ]'
xrun env CFASTLANE_ENGINE=claude sh "$HERE/session.sh" "$FIX/pkt" "$FIX/note.md" > /dev/null 2>&1; RC=$?
check "naming the packet's own engine on a resume is accepted" '[ "$RC" = 0 ] && sed -n 3p "$FIX/claude-args" | grep -q -- "--resume $SID "'
claude_session "$SID" "$FIX/wt"
check "the meter reads the recorded claude session" '[ "$(new_tokens)" = 200 ]'
new_fix
echo task > "$FIX/pkt/task.md"
mkdir -p "$FIX/pkt/turns/1/session"; echo "success exited 0" > "$FIX/pkt/turns/1/session/exit"
echo 'session id: old-codex-thread' > "$FIX/pkt/turns/1/session/err"
echo note > "$FIX/note.md"
env CFASTLANE_ENGINE=claude sh "$HERE/session.sh" "$FIX/pkt" "$FIX/note.md" > /dev/null 2> "$FIX/session.err"; RC=$?
check "a packet started before the switch is codex and refuses a claude resume" '[ "$RC" = 2 ] && grep -q "started on codex" "$FIX/session.err" && [ ! -s "$FIX/launches" ]'
mkdir -p "$WORK/nobin"
for tool in python3 git sed head date mkdir cat dirname timeout env; do ln -sf "$(command -v "$tool")" "$WORK/nobin/$tool"; done
new_fix
echo task > "$FIX/pkt/task.md"
env HOME="$WORK/home" PATH="$WORK/nobin" CFASTLANE_ENGINE=claude /bin/sh "$HERE/session.sh" "$FIX/pkt" > /dev/null 2>&1; RC=$?
check "a missing engine CLI fails before the turn is reserved, so a retry can start" '[ "$RC" != 0 ] && [ ! -e "$FIX/pkt/turns/1" ] && [ ! -s "$FIX/launches" ]'
new_fix
echo task > "$FIX/pkt/task.md"
mkdir -p "$FIX/pkt/turns/1/session"; echo "success exited 0" > "$FIX/pkt/turns/1/session/exit"
echo 'session id: old-codex-thread' > "$FIX/pkt/turns/1/session/err"
echo note > "$FIX/note.md"
sh "$HERE/session.sh" "$FIX/pkt" "$FIX/note.md" > /dev/null 2>&1; RC=$?
check "and resumes on codex by default" '[ "$RC" = 0 ] && sed -n 1p "$FIX/launches" | grep -q "^cfl-p1-s2 .* exec --color never resume old-codex-thread "'

echo "seat switch"
new_fix
echo task > "$FIX/pkt/task.md"; rm "$FIX/pkt/meter-start" "$FIX/pkt/base"
env FASTLANE_SEATS="opus sol grok" sh "$HERE/session.sh" "$FIX/pkt" > /dev/null 2>&1; RC=$?
PROMPT=$(sed -n 1p "$FIX/launches")
check "FASTLANE_SEATS names its seats on the session's first review launch" '[ "$RC" = 0 ] && [[ "$PROMPT" == *"run $HERE/review.sh $FIX/pkt opus sol grok (it probes grok)"* ]]'
check "the session names the seats on every launch and waits only on launched seats" \
  '[[ "$PROMPT" == *"This packet'"'"'s review seats are opus sol grok. Name them on every review.sh launch, after --out and --tag, except a failed seat'"'"'s one retry, which names only that seat. Wait only on the seats a round launched: opus sol, plus grok only when that round launched it; never wait on a seat that was not launched."* ]]'
check "the failed-seat rule counts only the seated ones" '[[ "$PROMPT" == *"The failed-seat rule needs at least two of the seated ones among opus, astra and sol (opus sol) to answer."* ]]'
mkdir -p "$FIX/pkt/turns/1/session"; echo "success exited 0" > "$FIX/pkt/turns/1/session/exit"
echo 'session id: abc-123' > "$FIX/pkt/turns/1/session/err"; echo note > "$FIX/note.md"
env FASTLANE_SEATS="opus astra grok" sh "$HERE/session.sh" "$FIX/pkt" "$FIX/note.md" > /dev/null 2>&1; RC=$?
PROMPT=$(sed -n 2p "$FIX/launches")
check "a resume carries the switch's seats too" '[ "$RC" = 0 ] && [[ "$PROMPT" == *"review seats are opus astra grok."*"Wait only on the seats a round launched: opus astra,"* ]]'
check "without neon in the list the prompt never mentions it" '! grep -qi " neon" "$FIX/launches"'
new_fix
echo task > "$FIX/pkt/task.md"; rm "$FIX/pkt/meter-start" "$FIX/pkt/base"
env FASTLANE_SEATS="opus sol grok neon" sh "$HERE/session.sh" "$FIX/pkt" > /dev/null 2>&1; RC=$?
PROMPT=$(sed -n 1p "$FIX/launches")
check "a list with neon names it on launches and says it is probed" '[ "$RC" = 0 ] && [[ "$PROMPT" == *"run $HERE/review.sh $FIX/pkt opus sol grok neon (it probes grok and neon)"* ]]'
check "neon is waited on like grok, only when launched, and reported missing like grok" \
  '[[ "$PROMPT" == *"Wait only on the seats a round launched: opus sol, plus grok and neon, each only when that round launched it; never wait on a seat that was not launched. Read neon-missing from the same output as grok-missing, and name a missing neon in the report like grok."* ]]'
check "neon never counts toward the failed-seat rule" \
  '[[ "$PROMPT" == *"Neon never counts toward the failed-seat rule'"'"'s two. The failed-seat rule needs at least two of the seated ones among opus, astra and sol (opus sol) to answer."* ]]'
for seats in '' 'sol grok' 'opus grok' 'opus sol gpt'; do
  new_fix
  echo task > "$FIX/pkt/task.md"; rm "$FIX/pkt/meter-start" "$FIX/pkt/base"
  env FASTLANE_SEATS="$seats" sh "$HERE/session.sh" "$FIX/pkt" > /dev/null 2> "$FIX/session.err"; RC=$?
  check "session.sh refuses FASTLANE_SEATS='$seats' before the turn is reserved" \
    '[ "$RC" = 2 ] && grep -q FASTLANE_SEATS "$FIX/session.err" && [ ! -s "$FIX/launches" ] && [ ! -e "$FIX/pkt/turns" ] && [ ! -e "$FIX/pkt/base" ]'
done
new_fix
review_brief; rm "$FIX/pkt/review-start"
env FASTLANE_SEATS="opus sol grok" sh "$HERE/review.sh" "$FIX/pkt" > /dev/null 2>&1; RC=$?
check "cfastlane review.sh takes its default seats from FASTLANE_SEATS" "[ $RC = 0 ] && sed -n 1p '$FIX/launches' | grep -q 'review-brief.md $FIX/pkt/review p1 opus sol grok$'"
rm -r "$FIX/pkt/review" 2>/dev/null; rm -f "$FIX/pkt/review-start"
env FASTLANE_SEATS="sol grok" sh "$HERE/review.sh" "$FIX/pkt" > /dev/null 2> "$FIX/review.err"; RC=$?
check "cfastlane review.sh refuses a list without opus before stamping or launching" \
  '[ "$RC" = 2 ] && grep -q "FASTLANE_SEATS must name opus" "$FIX/review.err" && [ "$(wc -l < "$FIX/launches")" = 1 ] && [ ! -e "$FIX/pkt/review-start" ]'
env FASTLANE_SEATS="opus sol grok" sh "$HERE/review.sh" "$FIX/pkt" --out "$FIX/pkt/review-retry" --tag p1-retry astra > /dev/null 2>&1; RC=$?
check "a named seat retry keeps working under the switch" '[ "$RC" = 0 ] && sed -n 2p "$FIX/launches" | grep -q "review-retry p1-retry astra$"'

echo "review launcher"
new_fix
review_brief; rm "$FIX/pkt/review-start"
check "review source asks for required check evidence and defers only suspended tests" 'grep -Fq "commands and exits of checks the task requires" "$FIX/pkt/review-brief.md" && grep -Fq "TEST marks a finding only about suspended tests" "$FIX/pkt/review-brief.md"'
sh "$HERE/review.sh" "$FIX/pkt" > /dev/null 2>&1; RC=$?
check "stamps the review start and delegates the default fastlane panel" "[ $RC = 0 ] && [ -s '$FIX/pkt/review-start' ] && sed -n 1p '$FIX/launches' | grep -q 'review-brief.md $FIX/pkt/review p1 opus astra sol grok$'"

echo 123 > "$FIX/pkt/review-start"
sh "$HERE/review.sh" "$FIX/pkt" sol grok > /dev/null 2>&1; RC=$?
check "re-review preserves the meter start and explicit seat selection" '[ "$RC" = 0 ] && [ "$(cat "$FIX/pkt/review-start")" = 123 ] && sed -n 2p "$FIX/launches" | grep -q "review p1 sol grok$"'
mkdir -p "$FIX/pkt/review/opus"
echo active > "$FIX/pkt/review/opus/unit"
sh "$HERE/review.sh" "$FIX/pkt" --out "$FIX/pkt/review-retry" --tag p1-retry sol > /dev/null 2>&1; RC=$?
check "a failed seat retries in a fresh directory and tag without moving active peers" '[ "$RC" = 0 ] && [ "$(cat "$FIX/pkt/review/opus/unit")" = active ] && sed -n 3p "$FIX/launches" | grep -q "review-retry p1-retry sol$"'
rm -r "$FIX/pkt/review"
sed -i 's/P0: money/P0: trivial/' "$FIX/pkt/review-brief.md"
sh "$HERE/review.sh" "$FIX/pkt" > /dev/null 2> "$FIX/review.err"; RC=$?
check "a reworded severity section fails before launching any reader" '[ "$RC" != 0 ] && grep -q "review brief reworded" "$FIX/review.err" && [ "$(wc -l < "$FIX/launches")" = 3 ]'
review_brief
sed -i 's/Read-only review/Editable review/' "$FIX/pkt/review-brief.md"
sh "$HERE/review.sh" "$FIX/pkt" > /dev/null 2> "$FIX/review.err"; RC=$?
check "reworded reviewer instructions fail before launching any reader" '[ "$RC" != 0 ] && grep -q "review brief reworded" "$FIX/review.err" && [ "$(wc -l < "$FIX/launches")" = 3 ]'

echo
echo "$PASS passed, $FAIL failed"
[ "$FAIL" -eq 0 ]

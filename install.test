LINKS
if [[ -n "$link_failures" ]]; then fail "$t" "$link_failures"
else pass "$t"; fi

# Native Beads commands are exercised from the documented blocks, without real br.
b=$(mktemp -d "$WORK/native.XXXXXX")
mkdir -p "$b/repo/.beads" "$b/bin"
git init -q "$b/repo"
git -C "$b/repo" config user.name 'Native Test'
git -C "$b/repo" config user.email native@example.invalid
printf '%s\n' '{"id":"fixture","description":"keep"}' >"$b/repo/.beads/issues.jsonl"
git -C "$b/repo" add -- .beads/issues.jsonl
git -C "$b/repo" commit -qm baseline
printf '%s\n' plan >"$b/repo/PLAN.md"
companion="$HERE/skills/beads-jsonl-path/SKILL.md"
panel="$HERE/skills/second-model-bead-audit/references/reviewer-panel.md"
awk '/^```bash$/ { code=1; next } code && /^```$/ { exit } code { print }' \
  "$companion" >"$b/admission.bash"
awk '/^```bash$/ { code=1; next } code && /^```$/ { exit } code { print }' \
  "$panel" >"$b/snapshot.bash"
clean='{"schema":"br.vcs-export-status.v2","available":true,"vcs":"git","tracked":true,"path_scope":"workspace","path":".beads/issues.jsonl","head":{"object_id":"h"},"index":{"object_id":"h"},"index_clean":true,"worktree_clean":true,"worktree_raw_git_blob_hash":"h"}'
run_doc() (
  cd "$b/repo" || exit 98
  br() {
    case "$*" in
      '--no-auto-flush --no-auto-import where --json')
        jq -nc --arg path "$PWD/.beads/issues.jsonl" '{jsonl_path:$path}' ;;
      '--no-auto-flush --no-auto-import vcs-status --json')
        printf '%s\n' "$DOC_STATUS"; return "$DOC_RC" ;;
      *) echo 'unexpected br command' >&2; return 99 ;;
    esac
  }
  export -f br
  export DOC_STATUS=$2 DOC_RC=${4:-0} BEADS_REVIEWED=${3:-null}
  export TMPDIR=$b
  export PLAN_PATH="$b/repo/PLAN.md" AUDIT_SCOPE=fixture
  bash "$1"
)
native_case() {
  local name=$1 status=$2 expected=$3 previous=${4:-null} command_rc=${5:-0} rc
  run_doc "$b/admission.bash" "$status" "$previous" "$command_rc" >"$b/out" 2>"$b/err"; rc=$?
  if [[ $expected == allow && $rc -eq 0 || $expected == refuse && $rc -ne 0 ]]; then
    pass "native admission: $name"
  else
    fail "native admission: $name" "exit $rc; expected $expected: $(<"$b/err")"
  fi
}
native_case clean "$clean" allow
dirty=$(jq '.worktree_clean=false | .worktree_raw_git_blob_hash="w"' <<<"$clean")
native_case unstaged "$dirty" refuse
staged=$(jq '.index_clean=false | .index.object_id="w" | .worktree_raw_git_blob_hash="w"' <<<"$clean")
native_case staged "$staged" refuse
canceling=$(jq '.worktree_clean=false | .worktree_raw_git_blob_hash="h"' <<<"$staged")
native_case canceling "$canceling" refuse
native_case 'reviewed continuation' "$dirty" allow "$dirty"
native_case 'changed continuation bytes' "$(jq '.worktree_raw_git_blob_hash="other"' <<<"$dirty")" refuse "$dirty"
native_case 'changed continuation index' "$canceling" refuse "$(jq '.index.object_id="other"' <<<"$canceling")"
native_case 'changed continuation HEAD' "$dirty" refuse "$(jq '.head.object_id="other"' <<<"$dirty")"
native_case 'wrong export path' "$(jq '.path="other.jsonl"' <<<"$clean")" refuse
native_case 'failed command with valid stdout' "$clean" refuse null 9
native_case malformed '{' refuse
native_case unavailable "$(jq '.available=false' <<<"$clean")" refuse
native_case 'missing required field' "$(jq 'del(.worktree_raw_git_blob_hash)' <<<"$clean")" refuse

t='reviewed checkpoint transfers between separate shells'
awk '/^BEADS_REVIEWED=\$\(br / { code=1 } code && /^```$/ { exit } code { print }' \
  "$companion" >"$b/checkpoint.bash"
if checkpoint=$(run_doc "$b/checkpoint.bash" "$dirty" 2>"$b/err"); then
  printf '%s\n' "$checkpoint" >"$b/continuation.bash"
  cat "$b/admission.bash" >>"$b/continuation.bash"
  if run_doc "$b/continuation.bash" "$dirty" >"$b/out" 2>"$b/err"; then
    pass "$t"
  else
    fail "$t" "checkpoint was not reusable: $(<"$b/err")"
  fi
else
  fail "$t" "checkpoint failed: $(<"$b/err")"
fi

t='audit snapshots use the export without database queries or writes'
if run_doc "$b/snapshot.bash" "$clean" >"$b/out" 2>"$b/err"; then
  pass "$t"
else
  fail "$t" "snapshot failed: $(<"$b/err")"
fi
t='audit refuses a missing authority source'
mv "$b/repo/PLAN.md" "$b/repo/PLAN.saved"
if run_doc "$b/snapshot.bash" "$clean" >"$b/out" 2>"$b/err"; then
  fail "$t" 'missing source accepted'
else
  pass "$t"
fi
mv "$b/repo/PLAN.saved" "$b/repo/PLAN.md"

awk '/^CLAUDE_MODEL=""$/ { code=1 } code && /^```$/ { exit } code { print }' \
  "$panel" >"$b/probe.bash"
cat >"$b/bin/claude" <<'PROBE_STUB'
#!/bin/sh
printf '%s\n' "$PROBE_REPLY"
exit "$PROBE_RC"
PROBE_STUB
chmod +x "$b/bin/claude"
for probe_case in success failed error malformed; do
  reply='{"is_error":false,"result":"PANEL_OK"}'; probe_rc=0
  case $probe_case in
    failed) probe_rc=9 ;;
    error) reply='{"is_error":true,"result":"PANEL_OK"}' ;;
    malformed) reply='{' ;;
  esac
  (
    set -euo pipefail
    export PATH="$b/bin:$PATH" PROBE_REPLY="$reply" PROBE_RC="$probe_rc"
    AUDIT_DIR=$b CLAUDE_REVIEWER_MODELS=fable
    source "$b/probe.bash"
    [[ $probe_case == success && $CLAUDE_MODEL == fable || $probe_case != success && -z $CLAUDE_MODEL ]]
  ) >"$b/out" 2>"$b/err"; rc=$?
  t="reviewer probe: $probe_case"
  if [[ $rc -eq 0 ]]; then pass "$t"; else fail "$t" "exit $rc: $(<"$b/err")"; fi
done

awk '/^CLAUDE_DENIALS=$/ { code=1 } code && /^```$/ { exit } code { print }' \
  "$panel" >"$b/denials.bash"
t='reviewer denied inspection is a failed seat'
printf '%s\n' '{"permission_denials":[{"tool_name":"Read"}]}' >"$b/raw.json"
if (
  set -euo pipefail
  JQ_RC=0 CLAUDE_RAW="$b/raw.json"
  source "$b/denials.bash"
  [[ $CLAUDE_INSPECTION_BLOCKED == true ]]
) >"$b/out" 2>"$b/err"; then pass "$t"; else fail "$t" 'denied Read accepted'; fi

t='Beads write guidance names a complete valid update command'
invalid_update_guidance=$(grep -RFl --include='*.md' -- '-d/--notes' \
  "$HERE/skills/bead-polish-loop" "$HERE/skills/plan-to-beads-transfer" || true)
if [[ -n "$invalid_update_guidance" ]]; then fail "$t" "$invalid_update_guidance"; else pass "$t"; fi

printf '\npassed %d, failed %d\n' "$PASS" "$FAIL"
[[ $FAIL -eq 0 ]]

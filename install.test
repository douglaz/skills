import ast
import os
import signal
import sys
import time

source = open(sys.argv[1], encoding="utf-8").read()
tree = ast.parse(source)
selected = [
    node
    for node in tree.body
    if isinstance(node, (ast.Import, ast.ImportFrom))
    or isinstance(node, ast.FunctionDef)
    and node.name in {"enable_child_subreaper", "reap_adopted_children"}
]
namespace = {}
exec(compile(ast.Module(body=selected, type_ignores=[]), sys.argv[1], "exec"), namespace)
namespace["enable_child_subreaper"]()
if not sys.platform.startswith("linux"):
    # The production function is a portable no-op here; do not create an orphan
    # in a fixture that has no subreaper contract to test.
    sys.exit(0)
if not namespace.get("subreaper_enabled", False):
    raise RuntimeError("Linux supervisor did not enable child subreaper")

pid_read, pid_write = os.pipe()
control_read, control_write = os.pipe()
intermediate = os.fork()
if intermediate == 0:
    os.close(pid_read)
    os.close(control_write)
    os.setsid()
    orphan = os.fork()
    if orphan == 0:
        os.close(pid_write)
        os.read(control_read, 1)
        os.close(control_read)
        os._exit(0)
    os.close(control_read)
    os.write(pid_write, f"{orphan}\n".encode("ascii"))
    os.close(pid_write)
    os._exit(0)
os.close(pid_write)
os.close(control_read)
adopted = None
reaped = False
try:
    pid_bytes = b""
    while not pid_bytes.endswith(b"\n"):
        chunk = os.read(pid_read, 64)
        if not chunk:
            break
        pid_bytes += chunk
    os.close(pid_read)
    pid_read = -1
    if not pid_bytes.endswith(b"\n"):
        raise RuntimeError("intermediate did not report the orphan PID")
    adopted = int(pid_bytes)
    os.waitpid(intermediate, 0)
    intermediate = None
    os.close(control_write)
    control_write = -1
    deadline = time.monotonic() + 2.0
    zombie = None
    while time.monotonic() < deadline:
        try:
            zombie = os.waitid(
                os.P_PID,
                adopted,
                os.WEXITED | os.WNOHANG | os.WNOWAIT,
            )
        except ChildProcessError:
            zombie = None
        if zombie is not None and zombie.si_pid == adopted:
            break
        time.sleep(0.01)
    else:
        raise RuntimeError("adopted child did not become a zombie")
    namespace["reap_adopted_children"]()
    try:
        os.waitid(os.P_PID, adopted, os.WEXITED | os.WNOHANG | os.WNOWAIT)
    except ChildProcessError:
        reaped = True
        adopted = None
    if not reaped:
        raise RuntimeError("subreaper did not reap adopted zombie")
finally:
    for fd in (control_write, pid_read):
        try:
            if fd >= 0:
                os.close(fd)
        except OSError:
            pass
    if intermediate is not None:
        try:
            os.waitpid(intermediate, 0)
        except ChildProcessError:
            pass
    if adopted is not None:
        try:
            os.waitpid(adopted, 0)
        except ChildProcessError:
            pass
    namespace["reap_adopted_children"]()
PY

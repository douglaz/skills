gate_fixture_group_alive() {
  python3 - "$1" <<'PY'
import os
import sys

try:
    os.killpg(int(sys.argv[1]), 0)
except ProcessLookupError:
    sys.exit(1)
except PermissionError:
    pass
sys.exit(0)
PY
}

# A fixture timeout must stop the caller-visible supervisor and any gate process
# group it may have created concurrently. Killing only the supervisor can orphan
# the private gate under PID 1 and poison every signal fixture that follows.
# A watchdog is one Python process with no timer child to orphan. Cancellation
# is a private file, never a signal to a reusable watchdog PID. On Linux it pins
# deadline targets with pidfds before publishing readiness and anchors a process
# group through its stopped leader. If pidfds are unavailable, it publishes an
# unsupported marker before readiness so the caller can abort before sending the
# behavior signal; it never falls back to a reusable numeric PID.
gate_fixture_watchdog() {
  local marker=$1 wrapper_pid=$2 group_pid=${3:-0}
  exec python3 - "$marker" "$wrapper_pid" "$group_pid" <<'PY'
import os
import signal
import sys
import time

marker, wrapper_raw, group_raw = sys.argv[1:]
cancel = marker + ".cancel"
ready = marker + ".ready"
wrapper_pid = int(wrapper_raw)
group_pid = int(group_raw)
wrapper_fd = None
group_fd = None

supported = (
    sys.platform.startswith("linux")
    and hasattr(os, "pidfd_open")
    and hasattr(signal, "pidfd_send_signal")
)
if supported:
    try:
        wrapper_fd = os.pidfd_open(wrapper_pid)
        if group_pid > 1:
            group_fd = os.pidfd_open(group_pid)
    except (ProcessLookupError, PermissionError, OSError):
        supported = False
if not supported or wrapper_fd is None or (group_pid > 1 and group_fd is None):
    open(marker + ".unsupported", "xb").close()

open(ready, "xb").close()
if not supported or wrapper_fd is None or (group_pid > 1 and group_fd is None):
    raise SystemExit(126)
deadline = time.monotonic() + 2.0
while not os.path.exists(cancel) and time.monotonic() < deadline:
    time.sleep(0.01)
if os.path.exists(cancel):
    raise SystemExit(0)

open(marker, "xb").close()
if group_fd is not None:
    try:
        # Holding the leader's pidfd pins its numeric PID/PGID against reuse
        # while the one group-wide escalation reaches every descendant.
        os.killpg(group_pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError, OSError):
        pass
if wrapper_fd is not None:
    try:
        signal.pidfd_send_signal(wrapper_fd, signal.SIGKILL)
    except (ProcessLookupError, PermissionError, OSError):
        pass
if group_fd is not None:
    os.close(group_fd)
if wrapper_fd is not None:
    os.close(wrapper_fd)
PY
}

gate_fixture_watchdog_ready() {
  local marker=$1
  # Startup handshake, not a behavior deadline: allow the same bounded ten
  # seconds as the other setup polls so interpreter start latency cannot fail
  # a correct wrapper.
  for ((_n=1; _n<=1000; _n++)); do
    if [[ -e "$marker.ready" ]]; then
      [[ ! -e "$marker.unsupported" ]]
      return
    fi
    sleep 0.01
  done
  return 1
}

gate_fixture_pidfd_supported() {
  [[ ${FORCE_NO_PIDFD_FIXTURES:-false} != true ]] || return 1
  python3 - <<'PY'
import os
import signal
import sys

if not (
    sys.platform.startswith("linux")
    and hasattr(os, "pidfd_open")
    and hasattr(signal, "pidfd_send_signal")
):
    raise SystemExit(1)
fd = os.pidfd_open(os.getpid())
os.close(fd)
PY
}

# Wait for whichever owned child finishes first. The watchdog owns all timeout
# signals through pidfds; Bash only cancels it by file and reaps both exact jobs.
gate_fixture_wait_with_watchdog() {
  local wrapper_pid=$1 marker=$2 watchdog_pid=$3
  local winner= first_rc=0 watchdog_rc=0 wrapper_rc=0
  wait -n -p winner "$wrapper_pid" "$watchdog_pid" || first_rc=$?
  if [[ $winner == "$wrapper_pid" ]]; then
    wrapper_rc=$first_rc
    : >"$marker.cancel"
    wait "$watchdog_pid" 2>/dev/null || watchdog_rc=$?
  else
    watchdog_rc=$first_rc
    wait "$wrapper_pid" 2>/dev/null || wrapper_rc=$?
  fi
  if [[ -e "$marker" ]]; then
    gate_fixture_wait_rc=124
  elif [[ $watchdog_rc -ne 0 ]]; then
    gate_fixture_wait_rc=126
  else
    gate_fixture_wait_rc=$wrapper_rc
  fi
}

# Called only before the behavior signal, while both recorded long-running
# targets are known alive. One hard-signal operation has no later PID use.
gate_fixture_abort_before_signal() {
  local wrapper_pid=$1 group_pid=$2
  if [[ $group_pid != *[!0-9]* && $group_pid -gt 1 ]]; then
    kill -s KILL -- "-$group_pid" "$wrapper_pid" 2>/dev/null || true
  else
    kill -s KILL -- "$wrapper_pid" 2>/dev/null || true
  fi
  wait "$wrapper_pid" 2>/dev/null || true
}

gate_fixture_remove_aborted_artifacts() {
  # Only setup-failure branches call this after hard containment. Normal signal
  # fixtures still require the supervisor itself to remove every private file.
  find "$gate_tmp" -depth -mindepth 1 -delete
}

capture_gate=false
found_gate_start=false
found_gate_command=false
found_supervisor=false
possible_gate_start=false
{
  printf '%s\n' '#!/usr/bin/env bash'
  printf '%s\n' 'set -e'
  printf '%s\n' 'if [[ -n ${HOSTILE_BASH_ENV:-} ]]; then export BASH_ENV=$HOSTILE_BASH_ENV; fi'
  while IFS= read -r line; do
    if ! $capture_gate; then
      if [[ $line == 'POSIXLY_CORRECT=y' ]] ||
          [[ $line == *'--noprofile --norc -p -s'* ]] ||
          [[ $line == *'_gate_dir=$(command mktemp -d)'* ]] ||
          { $possible_gate_start && [[ $line == *'_gate_log=$(mktemp)'* ]]; }; then
        capture_gate=true
        found_gate_start=true
      else
        possible_gate_start=false
        [[ $line == '(' ]] && possible_gate_start=true
        continue
      fi
    elif [[ $line == '```' ]]; then
      break
    fi
    if $capture_gate; then
      [[ $line == *'command exec "$_gate_python" '* &&
          $line == *'"$_gate_runner"'* ]] &&
        found_supervisor=true
      if [[ ${line#"${line%%[![:space:]]*}"} == '<gate>' ]]; then
        printf '%s\n' 'gate() { printf "first\n"; false; printf "should-not-run\n"; }'
        printf '%s\n' 'if [[ ${GATE_MODE:-function} == status ]]; then exit 124'
        printf '%s\n' 'elif [[ ${GATE_MODE:-function} == success ]]; then printf "paste-success\n"'
        printf '%s\n' 'elif [[ ${GATE_MODE:-function} == pipeline ]]; then'
        printf '%s\n' '  printf "pipeline-first\n"; false | true; printf "pipeline-last\n"'
        printf '%s\n' 'elif [[ ${GATE_MODE:-function} == streams ]]; then'
        printf '%s\n' '  printf "stream-out\n"; printf "stream-error\n" >&2'
        printf '%s\n' 'elif [[ ${GATE_MODE:-function} == normal-orphan ]]; then'
        printf '%s\n' '  python3 -c '\''import os, sys, time; (sys.exit(0) if not sys.platform.startswith("linux") else None); pid = os.fork(); (os._exit(0) if pid == 0 else None); deadline = time.monotonic() + 2; info = None; exec("while time.monotonic() < deadline:\n info = os.waitid(os.P_PID, pid, os.WEXITED | os.WNOHANG | os.WNOWAIT)\n if info is not None and info.si_pid == pid: break\n time.sleep(0.005)"); (None if info is not None and info.si_pid == pid else (_ for _ in ()).throw(RuntimeError("child did not become a zombie")))'\'''
        printf '%s\n' 'elif [[ ${GATE_MODE:-function} == replay ]]; then'
        printf '%s\n' '  printf "%s %s\n" "$BASHPID" "$PPID" >"$CHILD_PID_FILE"; : >"$STARTED"'
        printf '%s\n' '  python3 -c '\''import sys; sys.stdout.write("x" * 2000000)'\''; : >"$REPLAY_DONE"'
        printf '%s\n' 'elif [[ ${GATE_MODE:-function} == cooperative ]]; then'
        printf '%s\n' '  trap '\''printf term-cleanup >"$SIGNAL_MARKER"; exit 143'\'' TERM'
        printf '%s\n' '  printf "%s %s\n" "$BASHPID" "$PPID" >"$CHILD_PID_FILE"'
        printf '%s\n' '  printf "cooperative-sensitive-output\n"; : >"$STARTED"'
        printf '%s\n' '  while :; do sleep 1; done'
        printf '%s\n' 'elif [[ ${GATE_MODE:-function} == startup-timeout ]]; then'
        printf '%s\n' '  printf "%s %s\n" "$BASHPID" "$PPID" >"$CHILD_PID_FILE"'
        printf '%s\n' '  sleep 30; : >"$STARTED"'
        printf '%s\n' 'elif [[ ${GATE_MODE:-function} == term ]]; then'
        printf '%s\n' '  trap "" HUP INT TERM'
        printf '%s\n' '  bash -c '\''trap "" HUP INT TERM; while :; do sleep 1; done'\'' & term_descendant=$!'
        printf '%s\n' '  printf "%s %s %s\n" "$BASHPID" "$PPID" "$term_descendant" >"$CHILD_PID_FILE"'
        printf '%s\n' '  printf "sensitive-output\n"; : >"$STARTED"; wait "$term_descendant"'
        printf '%s\n' 'elif [[ ${GATE_MODE:-function} == stop ]]; then'
        printf '%s\n' '  printf "%s %s\n" "$BASHPID" "$PPID" >"$CHILD_PID_FILE"'
        printf '%s\n' '  printf "stopped-sensitive-output\n"; : >"$STARTED"; kill -STOP "$BASHPID"'
        printf '%s\n' '  printf "stopped-gate-continued\n"'
        printf '%s\n' 'elif [[ ${GATE_MODE:-function} == aggregate ]]; then'
        printf '%s\n' '  printf "%s %s\n" "$BASHPID" "$PPID" >"$CHILD_PID_FILE"'
        printf '%s\n' '  printf "aggregate-first\n" && { : >"$AGG_STARTED"; while [[ ! -f "$AGG_RELEASE" ]]; do sleep 0.01; done; false; } && printf "aggregate-last\n"'
        printf '%s\n' 'elif [[ ${GATE_MODE:-function} == cleanup ]]; then'
        printf '%s\n' '  printf "cleanup-output\n"'
        printf '%s\n' 'elif [[ ${GATE_MODE:-function} == trusted-cleanup ]]; then'
        printf '%s\n' '  printf "trusted-cleanup-output\n"'
        printf '%s\n' 'else gate; fi'
        found_gate_command=true
      else
        printf '%s\n' "$line"
      fi
    fi
  done < "$discipline_block"
} > "$gate_script"
awk '
  /^import os$/ { supervisor=1 }
  /^__AGENT_SUPERVISOR__$/ { exit }
  supervisor { print }
' "$gate_script" >"$subreaper_supervisor"
awk '
  /^command exec "\$_gate_python" -I "\$_gate_runner"/ {
    sub(/^command exec "\$_gate_python"/, "command exec /definitely/missing/python3")
  }
  { print }
' "$gate_script" >"$execfail_gate_script"
awk '
  /^def remove_private_dir[(][)]:$/ {
    print
    print "    os.unlink = lambda _path: (_ for _ in ()).throw(OSError(\"fixture cleanup failure\"))"
    print "    os.rmdir = lambda _path: (_ for _ in ()).throw(OSError(\"fixture cleanup failure\"))"
    next
  }
  { print }
' "$gate_script" >"$cleanupfail_gate_script"
{
  printf '%s\n' '#!/usr/bin/env bash'
  printf '%s\n' 'set -e'
  awk '
    /Never pipe a gate through/ { section=1 }
    section && /^```bash$/ { block=1; next }
    block && /^```$/ { exit }
    block {
      trimmed=$0
      sub(/^[[:space:]]*/, "", trimmed)
      if (trimmed == "<gate>") {
        print "read -r swallowed"
        print "false"
        print "printf \"stdin-gate-continued\\n\""
      } else {
        print
      }
    }
  ' "$discipline_block"
} >"$stdin_gate_script"
awk '
  /Never pipe a gate through/ { section=1 }
  section && /^```bash$/ { block=1; next }
  block && /^```$/ { exit }
  block { print }
' "$discipline_block" >"$canonical_gate_block"
awk '
  /Never pipe a gate through/ { section=1 }
  section && /^```bash$/ { block=1; next }
  block && /^```$/ { exit }
  block { print }
' "$HERE/AGENTS.md" >"$managed_gate_block"
gate_copy_failure=
if [[ $discipline_block == "$repository_discipline_block" ]] &&
    ! cmp -s "$canonical_gate_block" "$managed_gate_block"; then
  gate_copy_failure="managed AGENTS gate wrapper diverges from its canonical owner"
elif grep -Fq -- '_gate_dir=$(mktemp -d)' "$HERE/skills/drive/SKILL.md" ||
    grep -Fq -- '_gate_dir=$(mktemp -d)' "$HERE/skills/drive/references/phases.md"; then
  gate_copy_failure="Drive duplicated the canonical AGENTS gate wrapper"
elif grep -Eq "(^|[[:space:]'])rm[[:space:]]+-" "$discipline_block"; then
  gate_copy_failure="managed cleanup is rejected by managed command execution"
fi
if [[ -n "$gate_copy_failure" ]]; then
  fail "$t" "$gate_copy_failure"
elif ! $found_gate_start || ! $found_gate_command || ! $found_supervisor; then
  fail "$t" "could not extract the canonical gate wrapper"
else
  if gate_fixture_pidfd_supported; then
    pidfd_signal_fixtures=true
  else
    pidfd_signal_fixtures=false
  fi
  deadline_group_leak=false
  deadline_watchdog_rc=0
  if $pidfd_signal_fixtures; then
    python3 - "$deadline_group_ready" "$deadline_group_pid_file" <<'PY' &
import os
import sys
import time

ready, pid_file = sys.argv[1:]
os.setsid()
descendant = os.fork()
if descendant == 0:
    time.sleep(30)
    os._exit(0)
with open(pid_file, "w", encoding="ascii") as output:
    output.write(f"{os.getpid()} {descendant}\n")
open(ready, "xb").close()
time.sleep(30)

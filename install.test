        "$cooperative_stdout" "$cooperative_stderr" \
        "$blocked_term_stdout" "$blocked_term_stderr" \
        "$term_stdout" "$term_stderr" \
        "$quit_stdout" "$quit_stderr" \
        "$stop_stdout" "$stop_stderr"; do
      : >"$_signal_output"
    done
  fi
  (
    TMPDIR="$gate_tmp" \
      GATE_MODE=aggregate AGG_STARTED="$aggregate_started" AGG_RELEASE="$aggregate_release" \
      CHILD_PID_FILE="$aggregate_child_pid_file" \
      bash "$gate_script" >"$aggregate_stdout" 2>"$aggregate_stderr" &
    aggregate_pid=$!
    for ((_n=1; _n<=500; _n++)); do
      [[ -f "$aggregate_started" ]] && break
      sleep 0.02
    done
    if [[ -f "$aggregate_started" ]]; then
      wc -c <"$aggregate_stdout" >"$aggregate_early_file"
      : >"$aggregate_release"
      wait "$aggregate_pid"
      printf '%s' "$?" >"$aggregate_rc_file"
    else
      printf '%s\n' -1 >"$aggregate_early_file"
      read -r aggregate_child_pid _ <"$aggregate_child_pid_file" ||
        aggregate_child_pid=0
      gate_fixture_abort_before_signal "$aggregate_pid" "$aggregate_child_pid"
      printf '%s' 126 >"$aggregate_rc_file"
    fi
  )
  aggregate_rc=$(< "$aggregate_rc_file")
  TMPDIR="$cleanup_tmp" GATE_MODE=cleanup \
    bash "$cleanupfail_gate_script" >"$cleanup_stdout" 2>"$cleanup_stderr"; cleanup_rc=$?
  TMPDIR="$trusted_cleanup_tmp" GATE_MODE=trusted-cleanup \
    PATH="$cleanup_bin:$PATH" \
    bash "$gate_script" >"$trusted_cleanup_stdout" 2>"$trusted_cleanup_stderr"
  trusted_cleanup_rc=$?
  gate_output=$(< "$gate_stdout")
  gate_error=$(< "$gate_stderr")
  paste_output=$(< "$paste_stdout")
  paste_error=$(< "$paste_stderr")
  execfail_output=$(< "$execfail_stdout")
  execfail_error=$(< "$execfail_stderr")
  bashenv_output=$(< "$bashenv_stdout")
  bashenv_error=$(< "$bashenv_stderr")
  delayedexec_output=$(< "$delayedexec_stdout")
  delayedexec_error=$(< "$delayedexec_stderr")
  shellfunc_output=$(< "$shellfunc_stdout")
  shellfunc_error=$(< "$shellfunc_stderr")
  localcommand_output=$(< "$localcommand_stdout")
  localcommand_error=$(< "$localcommand_stderr")
  localalias_output=$(< "$localalias_stdout")
  localalias_error=$(< "$localalias_stderr")
  commandfunc_output=$(< "$commandfunc_stdout")
  commandfunc_error=$(< "$commandfunc_stderr")
  stdin_output=$(< "$stdin_stdout")
  stdin_error=$(< "$stdin_stderr")
  status_output=$(< "$status_stdout")
  status_error=$(< "$status_stderr")
  pipeline_output=$(< "$pipeline_stdout")
  pipeline_error=$(< "$pipeline_stderr")
  streams_output=$(< "$streams_stdout")
  streams_error=$(< "$streams_stderr")
  ignored_sigchld_output=$(< "$ignored_sigchld_stdout")
  ignored_sigchld_error=$(< "$ignored_sigchld_stderr")
  normal_orphan_output=$(< "$normal_orphan_stdout")
  normal_orphan_error=$(< "$normal_orphan_stderr")
  subreaper_rc=$(< "$subreaper_rc_file")
  subreaper_error=$(< "$subreaper_stderr")
  cooperative_output=$(< "$cooperative_stdout")
  cooperative_error=$(< "$cooperative_stderr")
  blocked_term_output=$(< "$blocked_term_stdout")
  blocked_term_error=$(< "$blocked_term_stderr")
  term_output=$(< "$term_stdout")
  term_error=$(< "$term_stderr")
  quit_output=$(< "$quit_stdout")
  quit_error=$(< "$quit_stderr")
  stop_output=$(< "$stop_stdout")
  stop_error=$(< "$stop_stderr")
  aggregate_output=$(< "$aggregate_stdout")
  aggregate_error=$(< "$aggregate_stderr")
  aggregate_early=$(< "$aggregate_early_file")
  cleanup_output=$(< "$cleanup_stdout")
  cleanup_error=$(< "$cleanup_stderr")
  trusted_cleanup_output=$(< "$trusted_cleanup_stdout")
  trusted_cleanup_error=$(< "$trusted_cleanup_stderr")
  if [[ $rc -ne 1 ]]; then
    fail "$t" "failed gate wrapper exited $rc"
  elif [[ $gate_output != $'first\nEXIT=1' ]]; then
    fail "$t" "unexpected stdout: $gate_output"
  elif [[ -n "$gate_error" ]]; then
    fail "$t" "unexpected stderr: $gate_error"
  elif [[ $gate_output == *should-not-run* ]]; then
    fail "$t" "gate continued past the failed && command"
  elif [[ $paste_rc -ne 0 || $paste_output != $'paste-success\nEXIT=0' ]]; then
    fail "$t" "pasted gate wrapper became rc=$paste_rc stdout=$paste_output"
  elif [[ -n "$paste_error" ]]; then
    fail "$t" "pasted gate wrapper wrote stderr: $paste_error"
  elif [[ $execfail_rc -ne 127 || -n "$execfail_output" ]]; then
    fail "$t" "failed supervisor exec became rc=$execfail_rc stdout=$execfail_output"
  elif [[ $execfail_error != *"/definitely/missing/python3"* ]]; then
    fail "$t" "failed supervisor exec had unexpected stderr: $execfail_error"
  elif [[ -n "$execfail_leak" ]]; then
    fail "$t" "failed supervisor exec leaked $execfail_leak"
  elif [[ $bashenv_rc -ne 1 || $bashenv_output != $'first\nEXIT=1' ]]; then
    fail "$t" "hostile BASH_ENV bypassed the gate: rc=$bashenv_rc stdout=$bashenv_output"
  elif [[ -n "$bashenv_error" ]]; then
    fail "$t" "hostile-BASH_ENV run wrote stderr: $bashenv_error"
  elif [[ -e "$bashenv_marker" ]]; then
    fail "$t" "hostile BASH_ENV reached a Python-launch shim"
  elif [[ $delayedexec_rc -ne 0 ||
      $delayedexec_output != $'paste-success\nEXIT=0' ]]; then
    fail "$t" "delayed supervisor handoff became rc=$delayedexec_rc stdout=$delayedexec_output"
  elif [[ -n "$delayedexec_error" ]]; then
    fail "$t" "delayed supervisor handoff wrote stderr: $delayedexec_error"
  elif [[ $localcommand_rc -ne 1 ||
      $localcommand_output != $'first\nEXIT=1' ]]; then
    fail "$t" "local command function bypassed the gate: rc=$localcommand_rc stdout=$localcommand_output"
  elif [[ -n "$localcommand_error" ||
      $localcommand_output == *should-not-run* ]]; then
    fail "$t" "local-command run leaked or continued: stderr=$localcommand_error"
  elif [[ $localalias_rc -ne 1 ||
      $localalias_output != $'first\nEXIT=1' ]]; then
    fail "$t" "local alias or caller BASH bypassed the gate: rc=$localalias_rc stdout=$localalias_output"
  elif [[ -n "$localalias_error" ||
      $localalias_output == *should-not-run* ]]; then
    fail "$t" "local-alias run leaked or continued: stderr=$localalias_error"
  elif [[ $shellfunc_rc -eq 0 || -n "$shellfunc_output" ]]; then
    fail "$t" "exported Bash function bypassed the refusal: rc=$shellfunc_rc stdout=$shellfunc_output"
  elif [[ $shellfunc_error != *"refusing exported shell function"* ]]; then
    fail "$t" "exported-function refusal had unexpected stderr: $shellfunc_error"
  elif [[ ! -f "$shellfunc_hostile_sentinel" ||
      $(<"$shellfunc_hostile_sentinel") != preserve ]]; then
    fail "$t" "exported mktemp function selected or deleted an existing directory"
  elif [[ $commandfunc_rc -ne 1 ||
      $commandfunc_output != $'first\nEXIT=1' ]]; then
    fail "$t" "exported command function bypassed the gate: rc=$commandfunc_rc stdout=$commandfunc_output"
  elif [[ -n "$commandfunc_error" ||
      $commandfunc_output == *should-not-run* ]]; then
    fail "$t" "exported-command run leaked or continued: stderr=$commandfunc_error"
  elif [[ $stdin_rc -ne 1 || $stdin_output != 'EXIT=1' ]]; then
    fail "$t" "stdin-consuming gate became rc=$stdin_rc stdout=$stdin_output"
  elif [[ -n "$stdin_error" || $stdin_output == *stdin-gate-continued* ]]; then
    fail "$t" "stdin-consuming gate leaked or continued: stderr=$stdin_error"
  elif [[ $status_rc -ne 124 || $status_output != 'EXIT=124' ]]; then
    fail "$t" "categorized status became rc=$status_rc stdout=$status_output"
  elif [[ -n "$status_error" ]]; then
    fail "$t" "categorized status wrote stderr: $status_error"
  elif [[ $pipeline_rc -ne 1 || $pipeline_output != $'pipeline-first\nEXIT=1' ]]; then
    fail "$t" "failed pipeline became rc=$pipeline_rc stdout=$pipeline_output"
  elif [[ -n "$pipeline_error" || $pipeline_output == *pipeline-last* ]]; then
    fail "$t" "pipeline gate leaked or continued: stderr=$pipeline_error"
  elif [[ $streams_rc -ne 0 || $streams_output != $'stream-out\nEXIT=0' ||
      $streams_error != stream-error ]]; then
    fail "$t" "gate streams were not preserved: rc=$streams_rc stdout=$streams_output stderr=$streams_error"
  elif [[ $ignored_sigchld_rc -ne 124 ||
      $ignored_sigchld_output != 'EXIT=124' ]]; then
    fail "$t" "ignored parent SIGCHLD corrupted status: rc=$ignored_sigchld_rc stdout=$ignored_sigchld_output"
  elif [[ -n "$ignored_sigchld_error" ]]; then
    fail "$t" "ignored parent SIGCHLD wrote stderr: $ignored_sigchld_error"
  elif [[ $normal_orphan_rc -ne 0 ||
      $normal_orphan_output != 'EXIT=0' || -n "$normal_orphan_error" ]]; then
    fail "$t" "normal-completion orphan reap failed: rc=$normal_orphan_rc stdout=$normal_orphan_output stderr=$normal_orphan_error"
  elif [[ $subreaper_rc -ne 0 ]]; then
    fail "$t" "supervisor did not reap an adopted child: $subreaper_error"
  elif $pidfd_signal_fixtures && [[ $replay_rc -ne 143 ]]; then
    fail "$t" "blocked replay ignored TERM: rc=$replay_rc"
  elif $pidfd_signal_fixtures && [[ -n "$replay_error" ]]; then
    fail "$t" "blocked replay wrote stderr: $replay_error"
  elif $pidfd_signal_fixtures && [[ $cooperative_rc -ne 143 ]]; then
    fail "$t" "cooperative TERM gate wrapper exited $cooperative_rc"
  elif $pidfd_signal_fixtures && [[ ! -s "$cooperative_child_pid_file" ]]; then
    fail "$t" "cooperative TERM fixture did not record the gate process"
  elif $pidfd_signal_fixtures &&
      read -r cooperative_child_pid _ <"$cooperative_child_pid_file" &&
      kill -0 "$cooperative_child_pid" 2>/dev/null; then
    fail "$t" "cooperative TERM left the gate process alive"
  elif $pidfd_signal_fixtures && [[ ! -f "$cooperative_signal_marker" ||
      $(<"$cooperative_signal_marker") != term-cleanup ]]; then
    fail "$t" "cooperative TERM trap did not run"
  elif $pidfd_signal_fixtures &&
      [[ -n "$cooperative_output" || -n "$cooperative_error" ]]; then
    fail "$t" "cooperative TERM exposed output: stdout=$cooperative_output stderr=$cooperative_error"
  elif $pidfd_signal_fixtures && [[ $startup_timeout_rc -ne 125 ]]; then
    fail "$t" "startup-timeout fixture could not start the gate: rc=$startup_timeout_rc"
  elif $pidfd_signal_fixtures && [[ $startup_timeout_leaked -ne 0 ]]; then
    fail "$t" "startup timeout orphaned the gate process group"
  elif $pidfd_signal_fixtures && [[ -n "$startup_timeout_error" ]]; then
    fail "$t" "startup-timeout fixture wrote stderr: $startup_timeout_error"
  elif $pidfd_signal_fixtures && [[ $blocked_term_rc -ne 143 ]]; then
    fail "$t" "blocked parent TERM escaped cancellation: rc=$blocked_term_rc"
  elif $pidfd_signal_fixtures && [[ ! -s "$blocked_term_child_pid_file" ]]; then
    fail "$t" "blocked parent TERM fixture did not record the gate process"
  elif $pidfd_signal_fixtures &&
      read -r blocked_term_child_pid _ blocked_term_descendant_pid \
      <"$blocked_term_child_pid_file" &&
      { kill -0 "$blocked_term_child_pid" 2>/dev/null ||
        kill -0 "$blocked_term_descendant_pid" 2>/dev/null; }; then
    fail "$t" "blocked parent TERM left the gate process group alive"
  elif $pidfd_signal_fixtures &&
      [[ -n "$blocked_term_output" || -n "$blocked_term_error" ]]; then
    fail "$t" "blocked parent TERM exposed output: stdout=$blocked_term_output stderr=$blocked_term_error"
  elif $pidfd_signal_fixtures && [[ $term_rc -ne 143 ]]; then
    fail "$t" "terminated gate wrapper exited $term_rc"
  elif $pidfd_signal_fixtures && [[ ! -s "$term_child_pid_file" ]]; then
    fail "$t" "PID-only TERM fixture did not record the gate process"
  elif $pidfd_signal_fixtures &&
      read -r term_child_pid _ term_descendant_pid <"$term_child_pid_file" &&
      { kill -0 "$term_child_pid" 2>/dev/null ||
        kill -0 "$term_descendant_pid" 2>/dev/null; }; then
    fail "$t" "PID-only TERM left the gate process group alive"
  elif $pidfd_signal_fixtures && [[ -n "$term_output" || -n "$term_error" ]]; then
    fail "$t" "terminated gate exposed output: stdout=$term_output stderr=$term_error"
  elif $pidfd_signal_fixtures && [[ $quit_rc -ne 131 ]]; then
    fail "$t" "QUIT gate wrapper exited $quit_rc"
  elif $pidfd_signal_fixtures && [[ ! -s "$quit_child_pid_file" ]]; then
    fail "$t" "PID-only QUIT fixture did not record the gate process"
  elif $pidfd_signal_fixtures &&
      read -r quit_child_pid _ quit_descendant_pid <"$quit_child_pid_file" &&
      { kill -0 "$quit_child_pid" 2>/dev/null ||
        kill -0 "$quit_descendant_pid" 2>/dev/null; }; then
    fail "$t" "PID-only QUIT left the gate process group alive"
  elif $pidfd_signal_fixtures && [[ -n "$quit_output" || -n "$quit_error" ]]; then
    fail "$t" "QUIT gate exposed output: stdout=$quit_output stderr=$quit_error"
  elif $pidfd_signal_fixtures && [[ $stop_rc -ne 143 ]]; then
    fail "$t" "stopped gate escaped before termination: rc=$stop_rc"
  elif $pidfd_signal_fixtures &&
      read -r stop_child_pid _ <"$stop_child_pid_file" &&
      kill -0 "$stop_child_pid" 2>/dev/null; then
    fail "$t" "stopped gate remained alive after PID-only TERM"
  elif $pidfd_signal_fixtures && [[ -n "$stop_output" || -n "$stop_error" ]]; then
    fail "$t" "stopped gate exposed output: stdout=$stop_output stderr=$stop_error"
  elif [[ $aggregate_rc -ne 1 || $aggregate_output != $'aggregate-first\nEXIT=1' ]]; then
    fail "$t" "aggregate gate became rc=$aggregate_rc stdout=$aggregate_output"
  elif [[ -n "$aggregate_error" || $aggregate_output == *aggregate-last* ]]; then
    fail "$t" "aggregate gate leaked or continued: stderr=$aggregate_error"
  elif [[ $aggregate_early -lt 0 ]]; then
    fail "$t" "aggregate gate never reached the pre-completion checkpoint"
  elif [[ $aggregate_early -ne 0 ]]; then
    fail "$t" "aggregate output escaped before the gate completed"
  elif [[ $cleanup_rc -ne 1 || $cleanup_output != $'cleanup-output\nEXIT=1' ]]; then
    fail "$t" "cleanup failure became rc=$cleanup_rc stdout=$cleanup_output"
  elif [[ $cleanup_error != *"cannot remove gate directory"* ]]; then
    fail "$t" "cleanup failure was not reported: $cleanup_error"
  elif ! find "$cleanup_tmp" -mindepth 1 -type f -print -quit | grep -q .; then
    fail "$t" "cleanup-failure fixture left no log to substantiate the failure"
  elif [[ $trusted_cleanup_rc -ne 0 ||
      $trusted_cleanup_output != $'trusted-cleanup-output\nEXIT=0' ]]; then
    fail "$t" "trusted cleanup became rc=$trusted_cleanup_rc stdout=$trusted_cleanup_output"
  elif [[ -n "$trusted_cleanup_error" ]]; then
    fail "$t" "trusted cleanup wrote stderr: $trusted_cleanup_error"
  elif $pidfd_signal_fixtures && [[ $deadline_watchdog_rc -ne 124 ]]; then
    fail "$t" "fixture watchdog deadline became rc=$deadline_watchdog_rc"
  elif $deadline_group_leak; then
    fail "$t" "fixture watchdog deadline left its process group alive"
  elif find "$trusted_cleanup_tmp" -mindepth 1 -print -quit | grep -q .; then
    fail "$t" "PATH cleanup wrappers bypassed trusted artifact removal"
  elif find "$gate_tmp" -mindepth 1 -print -quit | grep -q .; then
    fail "$t" "gate wrapper leaked its temporary log"
  else
    pass "$t"
  fi
fi

printf '\npassed %d, failed %d\n' "$PASS" "$FAIL"
[[ $FAIL -eq 0 ]]
